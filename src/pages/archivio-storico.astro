---
/**
 * /archivio-storico — indice sobrio degli articoli storici/legacy (M2.2).
 *
 * Sorgente: gli articoli con archivio:true && !draft (importati dal vecchio
 * WordPress in M2.3). Sono leggibili come ogni altro articolo — la loro pagina
 * /articoli/{slug} esiste — ma vivono qui invece che nelle liste-pilastro di
 * produzione: una sala di lettura ordinata per anno, in sordina, senza enfasi.
 *
 * Da NON confondere con /archivio ("Archivio digitale"): quella è un'altra cosa
 * (documenti, foto, audio, pubblicazioni) e NON va toccata. Qui ci sono solo gli
 * articoli testuali archiviati.
 *
 * Rendering: ElencoArticoliPerAnno con sobrio=true (compatto, muted, niente
 * excerpt). Palette brand coerente col resto del display layer.
 *
 * SORGENTE: v_articoli_pubblici (2/8/2026). Prima leggeva i file markdown, ed
 * era rimasta l'ultima pagina a farlo: una sorgente che nessuno aggiorna piu'.
 * Il flag `archivio`, che esisteva solo nel frontmatter, e' stato portato sulla
 * tabella `articolo` e travasato (56 articoli in sala di lettura, 52 in
 * produzione: gli stessi numeri di prima, verificati).
 *
 * NB: non si e' usato wp_legacy_id come criterio, che sarebbe stato comodo.
 * Ce l'hanno 107 righe su 108: non e' sinonimo di «archiviato», e' solo la
 * traccia dell'importazione da WordPress.
 */

import { createClient } from '@supabase/supabase-js';
import Layout from '../layouts/Layout.astro';
import ElencoArticoliPerAnno from '../components/ElencoArticoliPerAnno.astro';

export const prerender = false;

// [16/9/2026, audit PERF-05] Cache di bordo, come gia' fanno la home e le
// schede del glossario. Questa pagina e' pubblica e uguale per tutti: non
// legge la sessione, non guarda i cookie, mostra solo viste pubbliche. Con
// `s-maxage` Netlify risponde dal bordo invece di risvegliare la funzione a
// ogni visita, e `stale-while-revalidate` fa servire la copia vecchia mentre
// quella nuova si prepara, cosi' nessuno aspetta il database.
// Il giorno che qui dentro comparisse qualcosa che dipende da chi guarda,
// queste righe vanno tolte PRIMA di quel giorno, non dopo.
Astro.response.headers.set('Cache-Control', 'public, max-age=300');
Astro.response.headers.set(
  'Netlify-CDN-Cache-Control',
  'public, s-maxage=300, stale-while-revalidate=86400',
);

const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL || 'https://wacknihvdjxltiqvxtqr.supabase.co';
const SUPABASE_ANON = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';

// I record si rimappano nella forma che il componente si aspetta
// (`a.id` = slug, `a.data.*` = frontmatter): ElencoArticoliPerAnno resta
// intatto e continua a servire anche PaginaPilastro.
let articoli: any[] = [];
try {
  const sb = createClient(SUPABASE_URL, SUPABASE_ANON, { auth: { persistSession: false } });
  const { data } = await sb
    .from('v_articoli_pubblici')
    .select('slug, titolo, estratto, pilastro, pubblicato_at, noindex, archivio')
    .eq('archivio', true)
    .order('pubblicato_at', { ascending: false });
  articoli = ((data as any[]) ?? [])
    .filter((a) => a.slug && a.noindex !== true)
    .map((a) => ({
      id: a.slug,
      data: {
        title: a.titolo,
        excerpt: a.estratto ?? '',
        pilastro: a.pilastro ?? '_da_assegnare',
        data_pubblicazione: a.pubblicato_at ? new Date(a.pubblicato_at) : new Date(0),
      },
    }));
} catch (e) {
  console.error('[archivio-storico] lettura fallita:', e);
}
const totale = articoli.length;
---
<Layout ogImage="/og/og-archivio-storico.jpg"
  title="Archivio storico · El Brenz"
  description="L'archivio storico degli articoli dell'Associazione El Brenz: oltre cinquant'anni di ricerche e racconti sulle Valli del Noce, ordinati per anno."
>
  <header class="bg-[#1E2E26] text-[#F5EEDD]">
    <div class="max-w-4xl mx-auto px-6 py-16 md:py-24">
      <p
        class="text-[11px] tracking-[0.22em] uppercase text-[#D9A94E] font-medium m-0 mb-5"
        style="font-family: 'Inter', sans-serif;"
      >
        Patrimonio · Archivio storico
      </p>
      <h1
        class="text-4xl md:text-6xl leading-[1.08] tracking-tight m-0 mb-6"
        style="font-family: 'Playfair Display', serif; font-weight: 500;"
      >
        Archivio storico
      </h1>
      <p
        class="text-lg md:text-xl leading-relaxed text-[#F5EEDD]/85 m-0 max-w-2xl"
        style="font-family: 'Source Serif 4', Georgia, serif;"
      >
        Gli articoli e le ricerche pubblicati negli anni dall’Associazione, raccolti
        e ordinati per anno. Una sala di lettura della nosa storia: scritti d’altri
        tempi, custoditi e di nuovo consultabili.
      </p>
    </div>
  </header>

  <section class="bg-[#FDF9F0]">
    <div class="max-w-4xl mx-auto px-6 py-16 md:py-20">
      {totale > 0 ? (
        <ElencoArticoliPerAnno articoli={articoli} sobrio={true} />
      ) : (
        <p
          class="text-[#0F0F0F]/70 leading-relaxed m-0"
          style="font-family: 'Source Serif 4', Georgia, serif;"
        >
          L’archivio storico è in fase di popolamento: torna presto.
        </p>
      )}
    </div>
  </section>
</Layout>
