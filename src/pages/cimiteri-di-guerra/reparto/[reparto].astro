---
// Cimiteri di guerra — pagina di un reparto (brief 26/8/2026, §2.2; rifatta
// dal brief "fondo 1941", 26/8/2026 §6). Prima generava dieci pagine da un
// raggruppamento delle persone per sigla, sopra soglia di tre uomini. Ora
// legge memoria_reparto/v_memoria_reparto_pubblico: 55 sigle, 55 pagine,
// nessuna soglia — perché lo scioglimento della sigla è un fatto del
// registro austro-ungarico, non una proprietà che dipende da quanti uomini
// ci sono sepolti qui.
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/cimiteri-di-guerra.css';
import BarraSezione from '../../../components/memoria/BarraSezione.astro';
import { schemaBreadcrumb } from '../../../lib/schema';
import {
  leggiReparti, leggiReparto, leggiTutte, conNome, dataLeggibile, eReggimentoTirolese,
  OG_CIMITERI_ORIZZONTALE, type Reparto,
} from '../../../lib/memoria';

export async function getStaticPaths() {
  const gruppi = await leggiReparti();
  return gruppi.map((g) => ({ params: { reparto: g.slug } }));
}

const gruppo = await leggiReparto(Astro.params.reparto as string) as Reparto | null;
if (!gruppo) return Astro.redirect('/cimiteri-di-guerra/reparto');

const daVerificare = gruppo.certezza === 'da_verificare';

const tutte = await leggiTutte();
const persone = tutte
  .filter((p) => p.reparto === gruppo.sigla && conNome(p))
  .sort((a, b) => (a.data_morte ?? '').localeCompare(b.data_morte ?? ''));
const terre = new Map<string, number>();
for (const p of persone) if (p.regione_nascita) terre.set(p.regione_nascita, (terre.get(p.regione_nascita) ?? 0) + 1);
const terreOrdinate = [...terre.entries()].sort((a, b) => b[1] - a[1]);
const dateMorte = persone.map((p) => p.data_morte).filter(Boolean) as string[];
const primaData = dateMorte.length ? dateMorte.reduce((a, b) => (a < b ? a : b)) : null;
const ultimaData = dateMorte.length ? dateMorte.reduce((a, b) => (a > b ? a : b)) : null;
const comuni = [...new Set(persone.map((p) => p.comune))];

const tirolese = eReggimentoTirolese(gruppo.sigla);

const gruppoPadre = gruppo.sigla_padre ? (await leggiReparti()).find((g) => g.sigla === gruppo.sigla_padre) ?? null : null;

const titoloPagina = daVerificare ? gruppo.sigla : (gruppo.denominazione ?? gruppo.sigla);

const briciole = [
  { nome: 'Archivio', url: '/archivio' },
  { nome: 'Cimiteri di guerra', url: '/cimiteri-di-guerra' },
  { nome: 'Reparti', url: '/cimiteri-di-guerra/reparto' },
  { nome: titoloPagina, url: `/cimiteri-di-guerra/reparto/${gruppo.slug}` },
];

export const prerender = true;
---

<Layout
  title={`${titoloPagina} · Reparti`}
  description={daVerificare
    ? `Lo scioglimento della sigla ${gruppo.sigla} è in corso di verifica con l'archivio.`
    : `${persone.length} uomini del ${titoloPagina} sepolti nei Cimiteri di guerra delle Valli del Noce.`}
  ogImage={OG_CIMITERI_ORIZZONTALE}
>
  <style>
    .intestazione-gruppo { color: var(--oro-scuro); margin: 1.1rem 0 .4rem; }
    .risultati .intestazione-gruppo:first-child { margin-top: 0; }
  </style>
  <div class="sezione-cimiteri">
  <BarraSezione />
  <header class="apertura">
    <div class="dentro">
      <nav class="briciole" aria-label="Percorso">
        <a href="/archivio">Archivio</a> › <a href="/cimiteri-di-guerra">Cimiteri di guerra</a> › <a href="/cimiteri-di-guerra/reparto">Reparti</a> › <span aria-current="page">{titoloPagina}</span>
      </nav>
      <p class="etichetta">Cimiteri di guerra · reparto{gruppo.arma ? ` · ${gruppo.arma}` : ''}</p>
      <h1>{titoloPagina}</h1>
      {!daVerificare && gruppo.scioglimento && <p class="strillo" style="font-style:italic">{gruppo.scioglimento}</p>}
      {!daVerificare && (
        <p class="strillo">
          {persone.length} uomini sepolti a {comuni.join(', ') || '—'}
          {primaData && ultimaData && primaData !== ultimaData && ` fra il ${dataLeggibile(primaData.split('-').reverse().join('.'))} e il ${dataLeggibile(ultimaData.split('-').reverse().join('.'))}`}.
        </p>
      )}
    </div>
  </header>

  {daVerificare ? (
    <section class="dentro">
      <p class="guida">Lo scioglimento di questa sigla è in corso di verifica con l'archivio.</p>
    </section>
  ) : (
    <>
      {tirolese && (
        <section class="racconto">
          <div class="dentro">
            <h4>Kaiserjäger e Kaiserschützen: i reparti dei nostri</h4>

            <p>Qui la faccenda diventa personale, e vale la pena spiegarla per bene.</p>

            <p>Un ragazzo delle Valli del Noce che veniva chiamato alle armi tirava a sorte, e i nostri
            bisnonni chiamavano quel sorteggio <i>nar en la cava</i>. Se usciva l'esercito comune finiva
            quasi sempre nei <b>Tiroler Kaiserjäger</b>, i cacciatori imperiali, quattro reggimenti con sede
            a Trento e Innsbruck, Bolzano e Bressanone, Rovereto, Bregenz e Riva del Garda. Se usciva la
            Landwehr finiva nei <b>Landesschützen</b>, i fucilieri del Paese, reclutati soltanto in Tirolo,
            di lingua tedesca e di lingua italiana. Nel gennaio del 1917 l'imperatore Carlo li nominò
            <b>Kaiserschützen</b>, a Calliano, davanti al fronte trentino, come riconoscimento per come si
            erano battuti.</p>

            <p>Nel registro di Malè ce ne sono dieci: sei Kaiserschützen e quattro Kaiserjäger.</p>

            <p>E i tre uomini del 2° reggimento Kaiserjäger sono <b>gli unici tirolesi di tutto l'elenco</b>.
            Fra loro Josef Höllbling di Nauders, il più anziano dei centoquattordici.</p>

            <p>Nell'elenco dei centodiciassette, però, non compare nessun uomo delle nostre valli. E qui
            conviene fermarsi, perché la spiegazione più semplice è anche quella che si dimentica per
            prima.</p>

            <p>Sul Tonale i solandri e i nonesi c'erano eccome. Erano negli Standschützen, i bersaglieri
            immatricolati mobilitati nel 1915, che a quel confine arrivarono per primi; erano nei
            Kaiserjäger e nei Kaiserschützen; erano nel Landsturm. Difendevano il confine di casa, a un
            giorno di cammino dal proprio paese.</p>

            <p>Ed è proprio per questo che nel cimitero militare non ci sono. Chi era di qui, quando
            moriva, tornava dai suoi: sepolto nel camposanto del paese, nella tomba di famiglia, con un
            funerale. Il cimitero militare serviva per gli altri, per quelli che una famiglia a portata
            di carro non ce l'avevano.</p>

            <p>Quelle centodiciassette righe, allora, sono l'elenco di chi era lontano. Non racconta chi
            combatteva sul Tonale: racconta chi, fra quelli che ci combattevano, non aveva nessuno a cui
            essere restituito.</p>
          </div>
        </section>
      )}

      {persone.length > 0 && (
        <section class="dentro">
          <h2>Gli uomini del reparto</h2>
          <div class="schedario">
            <div class="risultati" style="max-height:none">
              {(['militare', 'civile'] as const).map((settore) => {
                const gruppo = persone.filter((p) => p.settore === settore);
                if (gruppo.length === 0) return null;
                return (
                  <>
                    <p class="etichetta intestazione-gruppo">{settore === 'militare' ? 'Cimitero militare' : 'Cimitero civile'}</p>
                    {gruppo.map((p) => (
                      <a class="voce" style="text-decoration:none;color:inherit" href={`/cimiteri-di-guerra/${p.fondo_slug_breve}/${p.slug}`}>
                        <span class="n">{p.numero ?? ''}</span>
                        <span>
                          <span class="nome">{p.nome_completo}{p.prigioniero_guerra && <span class="marchio">prigioniero</span>}</span>
                          <span class="meta">{[p.grado, p.luogo_nascita].filter(Boolean).join(' · ')}</span>
                        </span>
                        <span class="quando">{p.data_morte_testo || ''}</span>
                      </a>
                    ))}
                  </>
                );
              })}
            </div>
          </div>
        </section>
      )}

      {terreOrdinate.length > 0 && (
        <section class="dentro">
          <h2>Da dove venivano</h2>
          <div class="provenienze">
            {terreOrdinate.map(([regione, n]) => (
              <div class="prov">
                <span class="n">{n}</span>
                <span class="dove">{regione}</span>
                <span class="barra"><i style={`width:${Math.round((n / terreOrdinate[0][1]) * 100)}%`}></i></span>
              </div>
            ))}
          </div>
        </section>
      )}
    </>
  )}

  <section class="dentro">
    <p class="segnatura">Sigla nel registro: {gruppo.sigla}</p>
    {gruppo.sigla_padre && (
      <p class="guida">
        Probabilmente la stessa unità di {gruppo.sigla_padre}, verifica in corso.
        {gruppoPadre && <> <a href={`/cimiteri-di-guerra/reparto/${gruppoPadre.slug}`}>Vai alla scheda di {gruppoPadre.sigla}</a>.</>}
      </p>
    )}
  </section>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb(briciole))} is:inline />
</Layout>
