---
// Cimiteri di guerra — scheda di una persona (brief 26/8/2026, poi
// "rifinire" 26/8/2026). Non aveva un modello: carta chiara, titolo serif,
// dati in registro con etichette in monospazio maiuscolo, filetto d'oro sui
// blocchi che contano — stesso linguaggio della sezione, stesse variabili
// di cimiteri-di-guerra.css. Una pagina per uomo: chi cerca un cognome deve
// trovare un nome nel titolo, non una tabella.
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/cimiteri-di-guerra.css';
import Condividi from '../../../components/Condividi.astro';
import RiconosciPersona from '../../../components/RiconosciPersona.astro';
import BarraSezione from '../../../components/memoria/BarraSezione.astro';
import { schemaBreadcrumb } from '../../../lib/schema';
import {
  leggiFondi, leggiPersone, leggiFondo, conNome, dataLeggibile, titoloPersona, titoloInFrase, slugifica,
  leggiRepartoPerSigla, leggiProvenienza, ogImageFondo, trovaRimando, TESTO_CERTEZZA_EVENTO, type Fondo, type Persona,
} from '../../../lib/memoria';

export async function getStaticPaths() {
  const fondi = await leggiFondi();
  const pagine = [];
  for (const fondo of fondi) {
    const persone = await leggiPersone(fondo.slug);
    for (const p of persone) {
      // Anche le tombe "ignoto" hanno una scheda propria (brief "fondo
      // 1941", 26/8/2026 §4): 133, 186 e 195 esistono nel registro con un
      // numero e nessun nome, non sono un buco della planimetria.
      if (p.slug && (conNome(p) || p.ignoto)) {
        pagine.push({ params: { fondo: fondo.slug_breve, persona: p.slug }, props: { fondo, persona: p } });
      }
    }
  }
  return pagine;
}

interface Props { fondo: Fondo; persona: Persona }
const { fondo, persona } = Astro.props as Props;

const morte = dataLeggibile(persona.data_morte_testo);
// Le tombe ignote (133, 186, 195) non hanno un nome da mettere in titolo:
// "sconosciuto" nel database non e' un nome, e' l'assenza di uno. Titolo e
// descrizione dicono la tomba, non fingono un nome che non c'e'.
const titolo = persona.ignoto ? `Tomba ${persona.numero}, nome ignoto` : titoloPersona(persona);
const nomeVisibile = persona.ignoto ? `Tomba ${persona.numero}, nome ignoto` : (persona.nome_completo ?? '');
const nascita = [persona.anno_nascita, persona.luogo_nascita].filter(Boolean).join(', ');
const descrizione = persona.ignoto
  ? `Il registro annota questa sepoltura senza il nome. Sepolta nel ${titoloInFrase(fondo)}.`
  : `${persona.nome_completo}` + (nascita ? `, nato nel ${persona.anno_nascita ?? ''}${persona.luogo_nascita ? ' a ' + persona.luogo_nascita : ''}` : '') + `. Sepolto nel ${titoloInFrase(fondo)}.`;

// Reparto e provenienza hanno una pagina propria solo sopra la soglia dei
// tre uomini: sotto, restano testo semplice invece di un collegamento rotto.
const gruppoReparto = persona.reparto ? await leggiRepartoPerSigla(persona.reparto) : null;
const gruppoProvenienza = persona.regione_nascita ? await leggiProvenienza(slugifica(persona.regione_nascita)) : null;
const ancoraTomba = persona.settore && persona.numero != null ? `#t-${persona.settore}-${persona.numero}` : '';

// Precedente/successivo dentro lo stesso settore (brief "Navigazione della
// sezione", 26/8/2026 §8): stesso ordine delle tombe, saltando i numeri
// senza scheda. Chi e' primo o ultimo vede la direzione mancante disattivata,
// non nascosta.
const tuttiPersonaggi = await leggiPersone(fondo.slug);

// Rimando fra le due sepolture dello stesso uomo (brief "chiusura completa",
// 27/8/2026 §3, verifica 7): funziona in entrambe le direzioni anche se il
// campo altra_* e' scritto oggi solo sul lato civile della coppia.
const rimando = trovaRimando(persona, tuttiPersonaggi);
function testoRimando(r: { settore: string; numero: number }): string {
  const cimitero = r.settore === 'civile' ? 'cimitero civile' : 'cimitero militare';
  const luogo = r.settore === 'civile' ? 'posizione' : 'tomba';
  return `Registrato anche nel ${cimitero}, ${luogo} ${r.numero}.`;
}

const ordinatiPerSettore = tuttiPersonaggi
  .filter((p) => p.settore === persona.settore && (conNome(p) || p.ignoto) && p.numero != null)
  .sort((a, b) => (a.numero as number) - (b.numero as number));
const indicePersona = ordinatiPerSettore.findIndex((p) => p.id === persona.id);
const precedente = indicePersona > 0 ? ordinatiPerSettore[indicePersona - 1] : null;
const successiva = indicePersona >= 0 && indicePersona < ordinatiPerSettore.length - 1 ? ordinatiPerSettore[indicePersona + 1] : null;

const riferimentoScheda = `${nomeVisibile}, ${fondo.titolo}, https://elbrenz.eu/cimiteri-di-guerra/${fondo.slug_breve}/${persona.slug}`;

const briciole = [
  { nome: 'Archivio', url: '/archivio' },
  { nome: 'Cimiteri di guerra', url: '/cimiteri-di-guerra' },
  { nome: fondo.comune, url: `/cimiteri-di-guerra/${fondo.slug_breve}` },
  { nome: nomeVisibile, url: `/cimiteri-di-guerra/${fondo.slug_breve}/${persona.slug}` },
];

// Una scheda "sconosciuto" non e' una persona identificata: niente
// JSON-LD Person con un nome che non c'e'. Solo il breadcrumb resta.
const jsonLd = persona.ignoto ? null : {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: persona.nome_completo,
  deathDate: persona.data_morte ?? undefined,
  birthYear: persona.anno_nascita ?? undefined,
  birthPlace: persona.luogo_nascita ?? undefined,
};

export const prerender = true;
---

<Layout title={titolo} description={descrizione} ogImage={ogImageFondo(fondo)} ogType="article">
  <style>
    .scheda-testata { max-width: 720px; }
    .scheda-testata .indietro {
      font-family: var(--mono); font-size: .68rem; letter-spacing: .08em; text-transform: uppercase;
      color: rgba(245,239,224,.55); text-decoration: none;
    }
    .scheda-testata .indietro:hover { color: var(--oro-chiaro); }
    .scheda-testata h1 { margin-top: 1.1rem; }
    .scheda-corpo { max-width: 640px; margin: 0 auto; padding: 3rem 1.5rem 1rem; }
    .registro-persona { border-top: 2px solid var(--verde); border-bottom: 2px solid var(--verde); margin-bottom: 2rem; }
    .campo { display: grid; grid-template-columns: 9rem 1fr; gap: 1rem; padding: .85rem 0; border-bottom: 1px solid rgba(34,48,31,.12); align-items: baseline; }
    .campo:last-child { border-bottom: 0; }
    .campo dt { font-family: var(--mono); font-size: .63rem; letter-spacing: .14em; text-transform: uppercase; color: var(--oro-scuro); margin: 0; }
    .campo dd { font-family: var(--serif); font-size: 1.08rem; margin: 0; color: var(--verde); }
    .fonte { font-family: var(--mono); font-size: .68rem; color: var(--verde-tenue); letter-spacing: .04em; max-width: 640px; margin: 0 auto 2.5rem; padding: 0 1.5rem; }
    .campo dd a { color: var(--oro-scuro); }
    .blocco-evento { border-left: 3px solid var(--oro); background: var(--crema-scura); padding: 1.1rem 1.3rem; margin: 0 0 2rem; max-width: 640px; }
    .blocco-evento .etichetta { color: var(--oro-scuro); display: block; margin-bottom: .5rem; }
    .blocco-evento h2 { font-size: 1.3rem; margin: 0 0 .4rem; }
    .blocco-evento p { margin: 0 0 .6rem; font-size: .92rem; color: var(--verde); }
    .certezza { font-family: var(--mono); font-size: .62rem; letter-spacing: .1em; text-transform: uppercase; border: 1px solid var(--oro-scuro); color: var(--oro-scuro); padding: .15rem .5rem; display: inline-block; }
    .nota-ignoto { font-family: var(--sans); font-size: .95rem; color: var(--verde); background: var(--crema-scura); border-left: 3px solid var(--oro); padding: 1.1rem 1.3rem; margin: 0 0 2rem; max-width: 640px; }
    .nota-rimando { font-family: var(--mono); font-size: .74rem; letter-spacing: .02em; color: var(--verde-tenue); margin: 0 0 2rem; max-width: 640px; }
    .scorri-settore { display: flex; justify-content: space-between; gap: 1rem; margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid rgba(34,48,31,.15); }
    .scorri-settore a, .scorri-settore span { font-family: var(--mono); font-size: .72rem; letter-spacing: .04em; text-transform: uppercase; color: var(--oro-scuro); text-decoration: none; max-width: 46%; }
    .scorri-settore a span, .scorri-settore span span { display: block; font-family: var(--serif); font-size: .95rem; text-transform: none; letter-spacing: 0; color: var(--verde); margin-top: .25rem; }
    .scorri-settore a:hover { color: var(--oro); }
    .scorri-settore .succ { text-align: right; }
    .scorri-settore .disabilitato { color: rgba(34,48,31,.35); }
    .scorri-settore .disabilitato span { color: rgba(34,48,31,.3); }
  </style>

  <div class="sezione-cimiteri">
  <BarraSezione fondo={fondo} />
  <header class="apertura">
    <div class="dentro scheda-testata">
      <nav class="briciole" aria-label="Percorso">
        <a href="/archivio">Archivio</a> › <a href="/cimiteri-di-guerra">Cimiteri di guerra</a> › <a href={`/cimiteri-di-guerra/${fondo.slug_breve}`}>{fondo.comune}</a> › <span aria-current="page">{nomeVisibile}</span>
      </nav>
      <p class="etichetta">
        {persona.settore === 'militare' ? 'Cimitero militare' : 'Cimitero civile'} &middot; tomba {persona.numero ?? 'n.d.'}
      </p>
      <h1>{persona.ignoto ? <>Tomba {persona.numero}<br /><em>nome ignoto</em></> : persona.nome_completo}</h1>
      {(persona.grado || persona.reparto) && (
        <p class="strillo" style="margin-bottom:2.5rem">{[persona.grado, persona.reparto].filter(Boolean).join(' · ')}</p>
      )}
    </div>
  </header>

  <div class="scheda-corpo">
    {persona.ignoto && (
      <p class="nota-ignoto">Il registro annota questa sepoltura senza il nome. Non fu possibile identificarlo nemmeno allora.</p>
    )}

    {persona.evento_slug && persona.evento_nome && (
      <div class="blocco-evento">
        <span class="etichetta">Legato a un evento</span>
        <h2>{persona.evento_nome}</h2>
        <p>
          {persona.evento_certezza && <span class="certezza">{persona.evento_certezza.replace('_', ' ')}</span>}
          {' '}{persona.evento_certezza && TESTO_CERTEZZA_EVENTO[persona.evento_certezza]}
        </p>
        <a class="bottone" href={`/cimiteri-di-guerra/${persona.evento_slug}`}>Leggi dell'evento</a>
      </div>
    )}

    {rimando && (
      <p class="nota-rimando">{testoRimando(rimando)}</p>
    )}

    <dl class="registro-persona">
      {morte && (
        <div class="campo">
          <dt>Morto</dt>
          <dd>il {morte}, a {fondo.comune} {persona.data_morte_testo && <span class="data-originale">({persona.data_morte_testo})</span>}</dd>
        </div>
      )}
      {nascita && (
        <div class="campo"><dt>Nato</dt><dd>{[persona.anno_nascita, persona.luogo_nascita].filter(Boolean).join(', a ')}</dd></div>
      )}
      {persona.regione_nascita && (
        <div class="campo">
          <dt>Provenienza</dt>
          <dd>{gruppoProvenienza ? <a href={`/cimiteri-di-guerra/provenienza/${gruppoProvenienza.slug}`}>{persona.regione_nascita}</a> : persona.regione_nascita}</dd>
        </div>
      )}
      {persona.reparto && (
        <div class="campo">
          <dt>Reparto</dt>
          <dd>{gruppoReparto ? <a href={`/cimiteri-di-guerra/reparto/${gruppoReparto.slug}`}>{persona.reparto}</a> : persona.reparto}</dd>
        </div>
      )}
      {persona.prigioniero_guerra && (
        <div class="campo"><dt>Condizione</dt><dd>Prigioniero di guerra</dd></div>
      )}
      <div class="campo">
        <dt>Sepoltura</dt>
        <dd>Tomba {persona.numero ?? 'n.d.'}, {persona.settore === 'militare' ? 'cimitero militare' : 'cimitero civile'}</dd>
      </div>
    </dl>

    <div class="azioni">
      <a class="bottone" href={`/cimiteri-di-guerra/${fondo.slug_breve}`}>Tutte le persone del fondo</a>
      <a class="bottone vuoto" href={`/cimiteri-di-guerra/${fondo.slug_breve}/mappa${ancoraTomba}`}>Vedi sulla planimetria</a>
      <Condividi titolo={`${nomeVisibile} · ${fondo.titolo}`} testo="Un nome restituito dall'archivio di El Brenz." />
    </div>

    <RiconosciPersona nome={nomeVisibile} scheda={riferimentoScheda} />

    <nav class="scorri-settore" aria-label={`Altre tombe del ${persona.settore === 'militare' ? 'cimitero militare' : 'cimitero civile'}`}>
      {precedente ? (
        <a class="prec" href={`/cimiteri-di-guerra/${fondo.slug_breve}/${precedente.slug}`}>← Tomba {precedente.numero}<span>{conNome(precedente) ? precedente.nome_completo : 'Nome ignoto'}</span></a>
      ) : (
        <span class="prec disabilitato" aria-disabled="true">← Nessuna tomba precedente</span>
      )}
      {successiva ? (
        <a class="succ" href={`/cimiteri-di-guerra/${fondo.slug_breve}/${successiva.slug}`}>Tomba {successiva.numero} →<span>{conNome(successiva) ? successiva.nome_completo : 'Nome ignoto'}</span></a>
      ) : (
        <span class="succ disabilitato" aria-disabled="true">Nessuna tomba successiva →</span>
      )}
    </nav>
  </div>

  <p class="fonte">
    Fonte: {fondo.archivio}{fondo.segnatura ? `, ${fondo.segnatura}` : ''}. Ricerca di {fondo.ricercatore}.
  </p>
  </div>

  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />}
  <script type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb(briciole))} is:inline />
</Layout>
