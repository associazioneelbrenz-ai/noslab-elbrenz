---
// Cimiteri di guerra — planimetria navigabile (brief "planimetria
// cliccabile", 26/8/2026). Il cimitero militare non è più una griglia CSS
// che imita la pianta: è la fotografia vera, raddrizzata in prospettiva
// (memoria_fondo.planimetria_url), con i 215 riquadri disegnati
// dall'impiegato austriaco sovrapposti in percentuale
// (memoria_fondo.planimetria_geo.riquadri) — non incollati nel file. Il
// collegamento riquadro/persona è numero di tomba + settore. Il cimitero
// civile resta la resa CSS precedente: le sue 21 tombe non sono su una
// griglia regolare e non sono ancora state mappate a mano sulla fotografia
// (flag esplicito nel resoconto, non un dimenticanza).
import Layout from '../../../layouts/Layout.astro';
import { schemaBreadcrumb } from '../../../lib/schema';
import { leggiFondo, leggiPersone, ogImageFondo, type Fondo, type Persona } from '../../../lib/memoria';

export async function getStaticPaths() {
  const { leggiFondi } = await import('../../../lib/memoria');
  const fondi = await leggiFondi();
  return fondi.map((fondo) => ({ params: { fondo: fondo.slug_breve } }));
}

const fondo = await leggiFondo(Astro.params.fondo as string);
if (!fondo) return Astro.redirect('/cimiteri-di-guerra');
const persone = await leggiPersone(fondo.slug);

type Riquadro = { x: number; y: number; w: number; h: number; etichetta: string };
const geo = (fondo.planimetria_geo ?? { righe: [], civpos: {} }) as {
  righe?: number[][]; civpos?: Record<string, [number, number]>; nota?: string; riquadri?: Record<string, Riquadro>;
};
const riquadri = geo.riquadri ?? {};

const perNumero = new Map<string, Persona>();
for (const p of persone) {
  if (p.settore && p.numero != null) perNumero.set(`${p.settore}:${p.numero}`, p);
}
function trova(settore: string, numero: number): Persona | undefined {
  return perNumero.get(`${settore}:${numero}`);
}
function haNome(p: Persona | undefined): boolean {
  return !!p?.nome_completo && p.nome_completo !== 'sconosciuto';
}

// Ogni riquadro è chiavato sul numero principale; due riquadri portano due
// numeri nella stessa cella (180-181, 182-183) — l'etichetta lo dice, la
// scheda si sceglie sul primo dei due.
type Cella = {
  chiave: string; box: Riquadro; numeri: number[];
  principale: Persona | undefined; secondaria: Persona | undefined;
};
const celleMilitari: Cella[] = Object.entries(riquadri).map(([chiave, box]) => {
  const numeri = box.etichetta.includes('-') ? box.etichetta.split('-').map(Number) : [Number(chiave)];
  return { chiave, box, numeri, principale: trova('militare', numeri[0]), secondaria: numeri[1] != null ? trova('militare', numeri[1]) : undefined };
});

function nomiCella(c: Cella): string[] {
  return [c.principale, c.secondaria].filter(haNome).map((p) => p!.nome_completo as string);
}
function hrefCella(c: Cella): string {
  const scelta = haNome(c.principale) ? c.principale : haNome(c.secondaria) ? c.secondaria : undefined;
  return scelta?.slug ? `/cimiteri-di-guerra/${fondo!.slug_breve}/${scelta.slug}` : `/cimiteri-di-guerra/${fondo!.slug_breve}/senza-nome`;
}
function cercaCella(c: Cella): string {
  return [c.principale, c.secondaria].filter(Boolean)
    .flatMap((p) => [p!.nome_completo, p!.reparto, p!.luogo_nascita, p!.regione_nascita])
    .filter(Boolean).join(' ').toLowerCase();
}

const geoCivile = { righe: geo.righe ?? [], civpos: geo.civpos ?? {} };

const rgOttobre = new RegExp(`\\.10\\.${fondo.anno_a ?? ''}$`);
const nOtt = persone.filter((p) => rgOttobre.test(p.data_morte_testo ?? '')).length;
const nPow = persone.filter((p) => p.prigioniero_guerra).length;

const provenienze = new Map<string, number>();
for (const p of persone) {
  if (p.regione_nascita) provenienze.set(p.regione_nascita, (provenienze.get(p.regione_nascita) ?? 0) + 1);
}
const provenienzeTesto = [...provenienze.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8)
  .map(([r, n]) => `${r} ${n}`).join(' · ');

const didascaliaPlanimetria = fondo.planimetria_url && riquadri && Object.keys(riquadri).length > 0
  ? `Planimetria del ${(fondo.tipo === 'cimitero_militare' ? 'cimitero militare' : fondo.titolo.toLowerCase())} di ${fondo.comune}, scala 1:100, dal registro dell'${fondo.archivio}${fondo.segnatura ? `, segnatura ${fondo.segnatura}` : ''}.${fondo.ricercatore ? ` Ritrovata e fotografata dal dott. ${fondo.ricercatore}.` : ''} L'immagine è stata corretta in prospettiva per compensare la curvatura della pagina fotografata.`
  : null;

const briciole = [
  { nome: 'Archivio', url: '/archivio' },
  { nome: 'Cimiteri di guerra', url: '/cimiteri-di-guerra' },
  { nome: fondo.comune, url: `/cimiteri-di-guerra/${fondo.slug_breve}` },
  { nome: 'Planimetria', url: `/cimiteri-di-guerra/${fondo.slug_breve}/mappa` },
];

export const prerender = true;
---

<Layout title={`Planimetria · ${fondo.titolo}`} description={`Planimetria navigabile del ${fondo.titolo.toLowerCase()}.`} ogImage={ogImageFondo(fondo)}>
  <style is:global>
    /* Estratto verbatim da i-nomi-di-male.html (brief "rimettere il
       disegno", 26/8/2026). Le variabili duplicano quelle gia' presenti in
       cimiteri-di-guerra.css con nomi diversi: lasciate cosi' com'erano nel
       foglio originale, per fedelta' al documento sorgente. Non importato
       qui: questa pagina non usa nessuna delle sue classi, solo .involucro
       (avvolto comunque in .sezione-cimiteri per coerenza con le altre). */
    :root{
      --verde:#22301F; --verde-fondo:#18220F;
      --crema:#F5EFE0; --crema-tenue:rgba(245,239,224,.62);
      --oro:#C9962F; --oro-chiaro:#E3B75C; --oro-scuro:#8F6A1C;
      --blu:#123A5E; --linea:#BFD8EC; --linea-tenue:rgba(191,216,236,.32);
      --serif:"Iowan Old Style","Palatino Linotype",Palatino,Georgia,serif;
      --sans:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
      --mono:"SF Mono",Menlo,Consolas,monospace;
    }
    .involucro{max-width:1180px;margin:0 auto;padding:2.5rem 1.25rem 5rem;overflow:hidden}

    .involucro > header{background:var(--verde-fondo);color:var(--crema);margin:-2.5rem -1.25rem 2.25rem;padding:2.5rem 1.25rem 2rem;border-bottom:5px solid var(--oro)}
    .occhiello{font-family:var(--mono);font-size:.7rem;letter-spacing:.22em;text-transform:uppercase;
               color:var(--oro);margin:0 0 .9rem}
    .involucro h1{font-family:var(--serif);font-weight:400;font-size:clamp(2.1rem,6vw,3.6rem);line-height:1.05;
       margin:0 0 .5rem;letter-spacing:-.01em}
    .sottotitolo{font-family:var(--serif);font-style:italic;font-size:clamp(1rem,2.5vw,1.25rem);
                 color:var(--crema-tenue);margin:0 0 1.5rem;max-width:46ch}
    .conteggio{display:flex;flex-wrap:wrap;gap:1.75rem;font-family:var(--mono);font-size:.78rem;
               letter-spacing:.04em;color:var(--crema-tenue)}
    .conteggio b{display:block;font-family:var(--serif);font-size:1.9rem;color:var(--crema);
                 font-weight:400;letter-spacing:0;line-height:1.1}
    .conteggio .acceso b{color:var(--oro-chiaro)}

    .cerca{margin:2.25rem 0 1rem;position:relative}
    .cerca input{width:100%;padding:.95rem 1.1rem;background:#FDFAF3;
      border:1px solid rgba(34,48,31,.25);border-radius:0;color:var(--verde);
      font-family:var(--sans);font-size:1rem}
    .cerca input::placeholder{color:rgba(34,48,31,.4);font-style:italic}
    .cerca input:focus{outline:2px solid var(--oro);outline-offset:1px;background:#fff}
    .esiti{font-family:var(--mono);font-size:.72rem;color:rgba(34,48,31,.6);margin:.6rem 0 0;min-height:1.2em}

    .foglio{background:var(--blu);border:1px solid rgba(34,48,31,.25);padding:1.75rem 1.25rem 2rem;
            margin:1.5rem 0;position:relative;overflow-x:auto}
    .foglio::before{content:"";position:absolute;inset:.5rem;border:1px solid var(--linea-tenue);
                    pointer-events:none}
    .titolo-foglio{font-family:var(--serif);font-style:italic;font-size:1.4rem;text-align:center;
                   color:var(--linea);margin:.25rem 0 1.5rem;letter-spacing:.02em}
    .scala{font-family:var(--serif);font-style:italic;text-align:center;color:var(--linea-tenue);
           font-size:.85rem;margin-top:1.25rem}

    .pianta{min-width:660px;display:flex;flex-direction:column;gap:6px;align-items:center}
    .fila{display:flex;gap:5px;align-items:center}
    .corridoio{width:26px}
    .tomba{width:22px;height:30px;border:1px solid var(--linea);background:transparent;padding:0;
      cursor:pointer;position:relative;font-family:var(--mono);font-size:.5rem;color:var(--linea-tenue);
      display:flex;align-items:center;justify-content:center;transition:transform .12s,background .12s;
      text-decoration:none}
    .tomba.nota{background:var(--oro);border-color:var(--oro-chiaro);color:#0B2138;font-weight:700}
    .tomba.pow{background:var(--oro-chiaro);border-color:#fff}
    .tomba:hover,.tomba:focus{transform:scale(1.35);z-index:5;outline:none;
      box-shadow:0 0 0 2px var(--crema)}
    .tomba.spenta{opacity:.18}

    .civile{min-width:340px;height:340px;position:relative;margin:0 auto}
    .civile .tomba{position:absolute}

    /* ---------- la carta vera (militare) ---------- */
    .foglio-vero{background:#EFE9DA;border:1px solid rgba(34,48,31,.25);padding:1.25rem 1.25rem 1.5rem;margin:1.5rem 0}
    .finestra-pianta{position:relative;overflow:hidden;touch-action:none;background:#000;border:1px solid rgba(34,48,31,.2);cursor:grab;user-select:none}
    .finestra-pianta.trascina{cursor:grabbing}
    .pianta-vera{position:relative;width:100%;transform-origin:0 0;will-change:transform}
    .pianta-immagine{display:block;width:100%;height:auto;pointer-events:none;-webkit-user-drag:none}
    .riquadro{position:absolute;margin:0;padding:0;background:transparent;border:0;cursor:pointer;-webkit-tap-highlight-color:transparent;display:block}
    /* area di tocco piu' generosa del riquadro disegnato, senza spostare il segno visivo */
    .riquadro::before{content:"";position:absolute;inset:-8px;z-index:1}
    .riquadro.con-nome::after{content:"";position:absolute;top:6%;right:6%;width:16px;height:16px;max-width:26%;max-height:26%;
      background:var(--oro);border-radius:50%;box-shadow:0 0 0 1.5px rgba(255,255,255,.75);z-index:2}
    .riquadro:hover,.riquadro:focus-visible{outline:2px solid var(--oro-chiaro);outline-offset:1px;background:rgba(201,150,47,.22);z-index:6}
    .riquadro:focus-visible{outline-style:dashed}
    .riquadro .etichetta-riquadro{position:absolute;bottom:100%;left:50%;transform:translateX(-50%);margin-bottom:5px;
      background:var(--verde-fondo);color:var(--crema);font-family:var(--mono);font-size:.65rem;letter-spacing:.02em;
      padding:.25rem .5rem;white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .12s;z-index:20;border:1px solid var(--oro)}
    .riquadro:hover .etichetta-riquadro,.riquadro:focus-visible .etichetta-riquadro{opacity:1}
    .riquadro.spenta{opacity:.12}
    .riquadro.scelta::after{box-shadow:0 0 0 2px var(--verde-fondo),0 0 0 4px var(--oro-chiaro)}
    .riquadro.scelta{outline:2px solid var(--oro-chiaro);outline-offset:1px;z-index:8}
    .avviso-zoom{font-family:var(--mono);font-size:.66rem;letter-spacing:.03em;color:rgba(34,48,31,.5);
      margin:.7rem 0 0;text-align:center}
    .didascalia-vera{font-family:var(--sans);font-size:.8rem;color:rgba(34,48,31,.65);margin:.9rem 0 0;line-height:1.55;max-width:72ch}

    .legenda{display:flex;flex-wrap:wrap;gap:1.25rem;font-family:var(--mono);font-size:.68rem;
             color:rgba(34,48,31,.62);margin-top:1.25rem;letter-spacing:.03em}
    .campione{display:inline-block;width:13px;height:17px;border:1px solid rgba(34,48,31,.45);
              vertical-align:-3px;margin-right:.45rem}
    .campione.nota{background:var(--oro);border-color:var(--oro-chiaro)}
    .campione.pow{background:var(--oro-chiaro);border-color:#fff}

    .coda{margin-top:3.5rem;border-top:2px solid var(--verde);padding-top:1.75rem;
          font-size:.88rem;color:rgba(34,48,31,.68);max-width:68ch}
    .coda h2{font-family:var(--serif);font-weight:400;font-size:1.3rem;color:var(--verde);
             margin:0 0 .75rem}
    .coda p{margin:0 0 .85rem}
    .coda strong{color:var(--verde);font-weight:600}
    .segnatura{font-family:var(--mono);font-size:.72rem;letter-spacing:.05em;color:var(--oro-scuro)}
    .avvertenza{border-left:2px solid var(--oro);padding-left:1rem;margin:1.5rem 0}
    .briciole{font-family:var(--mono);font-size:.68rem;letter-spacing:.03em;color:rgba(245,239,224,.5);margin:0 0 1.1rem}
    .briciole a{color:rgba(245,239,224,.78);text-decoration:none}
    .briciole a:hover{color:var(--oro-chiaro)}
    @media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
  </style>

  <div class="sezione-cimiteri">
  <div class="involucro">
    <header>
      <nav class="briciole" aria-label="Percorso">
        <a href="/archivio">Archivio</a> › <a href="/cimiteri-di-guerra">Cimiteri di guerra</a> › <a href={`/cimiteri-di-guerra/${fondo.slug_breve}`}>{fondo.comune}</a> › <span aria-current="page">Planimetria</span>
      </nav>
      <p class="occhiello">Associazione El Brenz · Valli del Noce</p>
      <h1>I nomi di {fondo.comune}</h1>
      <p class="sottotitolo">
        {fondo.tipo === 'cimitero_militare' ? 'Il cimitero militare austro-ungarico' : fondo.titolo}
        {fondo.anno_da && fondo.anno_a ? `, ${fondo.anno_da}–${fondo.anno_a}` : ''}.
        {fondo.posti_censiti ?? fondo.nomi_noti} tombe, di cui {fondo.nomi_noti} hanno ancora un nome.
      </p>
      <div class="conteggio">
        <div class="acceso"><b>{fondo.nomi_noti}</b>nomi restituiti</div>
        <div><b>{fondo.senza_nome}</b>tombe senza nome</div>
        <div class="acceso"><b>{nOtt}</b>morti nel solo ottobre {fondo.anno_a ?? ''}</div>
        <div><b>{nPow}</b>prigionieri di guerra</div>
      </div>
    </header>

    <div class="cerca">
      <input id="mappa-cerca" type="search" placeholder="Cerca un cognome, un reparto, un luogo di nascita" aria-label="Cerca fra i caduti" />
      <p class="esiti" id="mappa-esiti" role="status"></p>
    </div>

    {fondo.planimetria_url && celleMilitari.length > 0 ? (
      <section class="foglio-vero">
        <p class="titolo-foglio">Cimitero Militare di {fondo.comune}</p>
        <div class="finestra-pianta" id="finestra-pianta">
          <div class="pianta-vera" id="pianta-vera">
            <img class="pianta-immagine" src={fondo.planimetria_url} alt={`Planimetria raddrizzata del cimitero militare di ${fondo.comune}, con i riquadri delle tombe disegnati a mano`} draggable="false" />
            {celleMilitari.map((c) => {
              const nomi = nomiCella(c);
              const conNome = nomi.length > 0;
              const label = conNome
                ? `Tomba ${c.box.etichetta}, ${nomi.join(' e ')}`
                : `Tomba ${c.box.etichetta}, senza nome`;
              const stile = `left:${c.box.x}%;top:${c.box.y}%;width:${c.box.w}%;height:${c.box.h}%`;
              return (
                <a
                  class={`riquadro cercabile${conNome ? ' con-nome' : ''}`}
                  style={stile}
                  href={hrefCella(c)}
                  data-numeri={c.numeri.join(' ')}
                  data-cerca={cercaCella(c)}
                  aria-label={label}
                >
                  <span class="etichetta-riquadro">{conNome ? nomi.join(' · ') : `Tomba ${c.box.etichetta} · senza nome`}</span>
                </a>
              );
            })}
          </div>
        </div>
        <p class="scala">Scala 1:100</p>
        <p class="avviso-zoom">Pizzica per ingrandire, trascina per spostarti sulla pianta.</p>
        {didascaliaPlanimetria && <p class="didascalia-vera">{didascaliaPlanimetria}</p>}
      </section>
    ) : (
      <section class="foglio">
        <p class="titolo-foglio">Cimitero Militare di {fondo.comune}</p>
        <div class="pianta">
          {(geoCivile.righe ?? []).map((fila) => (
            <div class="fila">
              {fila.map((n, i) => {
                const p = trova('militare', n);
                const nome = haNome(p);
                const cerca = p ? [p.nome_completo, p.reparto, p.luogo_nascita, p.regione_nascita].filter(Boolean).join(' ').toLowerCase() : '';
                return (
                  <>
                    {i === 12 && <span class="corridoio" />}
                    {nome && p?.slug ? (
                      <a id={`t-militare-${n}`} href={`/cimiteri-di-guerra/${fondo.slug_breve}/${p.slug}`} class={`tomba cercabile nota${p.prigioniero_guerra ? ' pow' : ''}`}
                        data-cerca={cerca} title={p.nome_completo ?? ''} aria-label={`Tomba ${n}: ${p.nome_completo}`}>{n}</a>
                    ) : (
                      <span id={`t-militare-${n}`} class="tomba cercabile" aria-label={`Tomba ${n}: senza nome`}>{n}</span>
                    )}
                  </>
                );
              })}
            </div>
          ))}
        </div>
        <p class="scala">Scala 1:100</p>
      </section>
    )}

    <section class="foglio">
      <p class="titolo-foglio">Cimitero Civile di {fondo.comune} &middot; Tombe militari</p>
      <div class="civile">
        {Object.entries(geoCivile.civpos).map(([n, xy]) => {
          const p = trova('civile', Number(n));
          const nome = haNome(p);
          const cerca = p ? [p.nome_completo, p.reparto, p.luogo_nascita, p.regione_nascita].filter(Boolean).join(' ').toLowerCase() : '';
          return nome && p?.slug ? (
            <a id={`t-civile-${n}`} href={`/cimiteri-di-guerra/${fondo.slug_breve}/${p.slug}`} class={`tomba cercabile nota${p.prigioniero_guerra ? ' pow' : ''}`}
              style={`left:${xy[0]}%;top:${xy[1]}%`} data-cerca={cerca} title={p.nome_completo ?? ''} aria-label={`Tomba ${n}: ${p.nome_completo}`}>{n}</a>
          ) : (
            <span id={`t-civile-${n}`} class="tomba cercabile" style={`left:${xy[0]}%;top:${xy[1]}%`} aria-label={`Tomba ${n}: senza nome`}>{n}</span>
          );
        })}
      </div>
      <p class="didascalia-vera">
        La disposizione di queste tombe non è ancora stata ricostruita su una fotografia raddrizzata: le ventuno tombe
        del cimitero civile non seguono una griglia regolare, e la loro posizione qui resta la ricostruzione
        approssimata già pubblicata, non la pianta vera.
      </p>
    </section>

    <div class="legenda">
      <span><i class="campione nota"></i>tomba con un nome</span>
      <span><i class="campione pow"></i>prigioniero di guerra</span>
      <span><i class="campione"></i>tomba senza nome nel registro</span>
    </div>

    <div class="coda">
      <h2>Da dove viene questo elenco</h2>
      {fondo.ricercatore_note ? (
        <p>{fondo.ricercatore_note}</p>
      ) : fondo.ricercatore && (
        <p>Il registro è stato ritrovato e messo a disposizione dell'Associazione El Brenz da <strong>{fondo.ricercatore}</strong>.</p>
      )}
      {fondo.segnatura && <p class="segnatura">{fondo.segnatura}</p>}
      {geo.nota && (
        <div class="avvertenza">
          <p><strong>La disposizione delle tombe è una ricostruzione.</strong> {geo.nota}</p>
        </div>
      )}
      {provenienzeTesto && (
        <p>Le provenienze dicono il resto: {provenienzeTesto}. Sotto il campanile di {fondo.comune} non riposano trentini, ma un impero intero.</p>
      )}
    </div>
  </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb(briciole))} is:inline />

  <script is:inline>
    const input = document.getElementById('mappa-cerca');
    const esiti = document.getElementById('mappa-esiti');
    const tombe = Array.from(document.querySelectorAll('.cercabile'));
    input?.addEventListener('input', () => {
      const t = input.value.trim().toLowerCase();
      if (!t) { tombe.forEach((b) => b.classList.remove('spenta')); if (esiti) esiti.textContent = ''; return; }
      let trovati = 0;
      tombe.forEach((b) => {
        const cerca = b.getAttribute('data-cerca');
        const ok = !!cerca && cerca.includes(t);
        b.classList.toggle('spenta', !ok);
        if (ok) trovati++;
      });
      if (esiti) esiti.textContent = trovati === 0 ? 'Nessun nome corrisponde.' : trovati + (trovati === 1 ? ' tomba trovata.' : ' tombe trovate.');
    });

    // collegamento inverso dalla scheda di una persona: #t-militare-N o
    // #t-civile-N. Sulla carta vera un riquadro puo' portare due numeri
    // (data-numeri="180 181"), quindi si cerca anche li'.
    if (location.hash.startsWith('#t-')) {
      const resto = location.hash.slice(3);
      const sep = resto.indexOf('-');
      const settore = resto.slice(0, sep);
      const numero = resto.slice(sep + 1);
      let scelta = document.getElementById(location.hash.slice(1));
      if (!scelta && settore === 'militare') {
        scelta = document.querySelector(`[data-numeri~="${numero}"]`);
      }
      if (scelta) {
        scelta.classList.add('scelta');
        scelta.scrollIntoView({ block: 'center', inline: 'center', behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      }
    }

    // Pizzico per ingrandire e trascinamento, solo sulla fotografia vera.
    // Niente librerie esterne: transform sul contenitore muove insieme
    // l'immagine e i riquadri, che restano allineati a qualunque zoom.
    (function () {
      const finestra = document.getElementById('finestra-pianta');
      const pianta = document.getElementById('pianta-vera');
      if (!finestra || !pianta) return;

      let scala = 1, tx = 0, ty = 0;
      const SCALA_MIN = 1, SCALA_MAX = 4;
      const punti = new Map();
      let pinchIniziale = null;
      let mosso = false;
      let ultimoTap = 0;

      function applica() {
        pianta.style.transform = `translate(${tx}px,${ty}px) scale(${scala})`;
      }
      function limita() {
        if (scala < SCALA_MIN) scala = SCALA_MIN;
        if (scala > SCALA_MAX) scala = SCALA_MAX;
        const rect = finestra.getBoundingClientRect();
        const margineX = rect.width * (scala - 1);
        const margineY = rect.height * (scala - 1);
        tx = Math.min(0, Math.max(-margineX, tx));
        ty = Math.min(0, Math.max(-margineY, ty));
      }
      function distanza(a, b) {
        return Math.hypot(a.x - b.x, a.y - b.y);
      }
      function centro(a, b) {
        return { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 };
      }

      finestra.addEventListener('pointerdown', (e) => {
        finestra.setPointerCapture(e.pointerId);
        punti.set(e.pointerId, { x: e.clientX, y: e.clientY });
        mosso = false;
        if (punti.size === 2) {
          const [a, b] = [...punti.values()];
          pinchIniziale = { distanza: distanza(a, b), scala, centro: centro(a, b), tx, ty };
        }
        finestra.classList.add('trascina');
      });

      finestra.addEventListener('pointermove', (e) => {
        if (!punti.has(e.pointerId)) return;
        const precedente = punti.get(e.pointerId);
        const attuale = { x: e.clientX, y: e.clientY };
        punti.set(e.pointerId, attuale);

        if (punti.size === 2 && pinchIniziale) {
          const [a, b] = [...punti.values()];
          const rapporto = distanza(a, b) / (pinchIniziale.distanza || 1);
          scala = pinchIniziale.scala * rapporto;
          const c = centro(a, b);
          tx = pinchIniziale.tx + (c.x - pinchIniziale.centro.x);
          ty = pinchIniziale.ty + (c.y - pinchIniziale.centro.y);
          mosso = true;
        } else if (punti.size === 1) {
          const dx = attuale.x - precedente.x, dy = attuale.y - precedente.y;
          if (Math.abs(dx) > 3 || Math.abs(dy) > 3) mosso = true;
          if (scala > 1) { tx += dx; ty += dy; }
        }
        limita();
        applica();
      });

      function fine(e) {
        punti.delete(e.pointerId);
        if (punti.size < 2) pinchIniziale = null;
        if (punti.size === 0) finestra.classList.remove('trascina');
      }
      finestra.addEventListener('pointerup', fine);
      finestra.addEventListener('pointercancel', fine);

      // doppio tocco/clic: torna alla scala originale
      finestra.addEventListener('pointerup', (e) => {
        const ora = Date.now();
        if (ora - ultimoTap < 300 && punti.size === 0) {
          scala = 1; tx = 0; ty = 0; applica();
        }
        ultimoTap = ora;
      });

      // rotellina del mouse: zoom centrato sul cursore
      finestra.addEventListener('wheel', (e) => {
        e.preventDefault();
        const rect = finestra.getBoundingClientRect();
        const px = e.clientX - rect.left, py = e.clientY - rect.top;
        const precedente = scala;
        scala *= e.deltaY < 0 ? 1.15 : 1 / 1.15;
        if (scala < SCALA_MIN) scala = SCALA_MIN;
        if (scala > SCALA_MAX) scala = SCALA_MAX;
        const rapporto = scala / precedente;
        tx = px - (px - tx) * rapporto;
        ty = py - (py - ty) * rapporto;
        limita();
        applica();
      }, { passive: false });

      // un riquadro va aperto solo se non c'e' stato un trascinamento
      pianta.querySelectorAll('a.riquadro').forEach((a) => {
        a.addEventListener('click', (e) => { if (mosso) e.preventDefault(); });
      });
    })();
  </script>
</Layout>
