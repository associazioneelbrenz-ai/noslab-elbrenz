---
// Cimiteri di guerra — planimetria navigabile (brief "planimetria
// cliccabile", 26/8/2026; ristrutturata da "Navigazione della sezione",
// 26/8/2026 §6-8). Il blocco con la fotografia vera, i riquadri e la
// legenda a tre stati vive in components/memoria/Planimetria.astro: questa
// pagina resta la vetrina dedicata (intestazione, conteggi, congedo) e
// incornicia quel blocco, che compare identico anche sulla pagina del
// fondo, sopra il racconto.
import Layout from '../../../layouts/Layout.astro';
import BarraSezione from '../../../components/memoria/BarraSezione.astro';
import Planimetria from '../../../components/memoria/Planimetria.astro';
import { schemaBreadcrumb } from '../../../lib/schema';
import { leggiFondo, leggiPersone, ogImageFondo, titoloInFrase, type Fondo, type Persona } from '../../../lib/memoria';

export async function getStaticPaths() {
  const { leggiFondi } = await import('../../../lib/memoria');
  const fondi = await leggiFondi();
  return fondi.map((fondo) => ({ params: { fondo: fondo.slug_breve } }));
}

const fondo = await leggiFondo(Astro.params.fondo as string);
if (!fondo) return Astro.redirect('/cimiteri-di-guerra');
const persone = await leggiPersone(fondo.slug);

const rgOttobre = new RegExp(`\\.10\\.${fondo.anno_a ?? ''}$`);
const nOtt = persone.filter((p) => rgOttobre.test(p.data_morte_testo ?? '')).length;
const nPow = persone.filter((p) => p.prigioniero_guerra).length;

const provenienze = new Map<string, number>();
for (const p of persone) {
  if (p.regione_nascita) provenienze.set(p.regione_nascita, (provenienze.get(p.regione_nascita) ?? 0) + 1);
}
const provenienzeTesto = [...provenienze.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8)
  .map(([r, n]) => `${r} ${n}`).join(' · ');

const geo = fondo.planimetria_geo as { nota?: string } | null;

const briciole = [
  { nome: 'Archivio', url: '/archivio' },
  { nome: 'Cimiteri di guerra', url: '/cimiteri-di-guerra' },
  { nome: fondo.comune, url: `/cimiteri-di-guerra/${fondo.slug_breve}` },
  { nome: 'Planimetria', url: `/cimiteri-di-guerra/${fondo.slug_breve}/mappa` },
];

export const prerender = true;
---

<Layout title={`Planimetria · ${fondo.titolo}`} description={`Planimetria navigabile del ${titoloInFrase(fondo)}.`} ogImage={ogImageFondo(fondo)}>
  <style is:global>
    :root{
      --verde:#22301F; --verde-fondo:#18220F;
      --crema:#F5EFE0; --crema-tenue:rgba(245,239,224,.62);
      --oro:#C9962F; --oro-chiaro:#E3B75C; --oro-scuro:#8F6A1C;
      --blu-carta:#123A5E; --blu-linea:#BFD8EC;
      --serif:"Iowan Old Style","Palatino Linotype",Palatino,Georgia,serif;
      --sans:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
      --mono:"SF Mono",Menlo,Consolas,monospace;
    }
  </style>
  <style>
    .involucro { max-width: 1180px; margin: 0 auto; padding: 2.5rem 1.25rem 5rem; overflow: hidden; }
    .involucro > header { background: var(--verde-fondo); color: var(--crema); margin: -2.5rem -1.25rem 2.25rem; padding: 2.5rem 1.25rem 2rem; border-bottom: 5px solid var(--oro); }
    .occhiello { font-family: var(--mono); font-size: .7rem; letter-spacing: .22em; text-transform: uppercase; color: var(--oro); margin: 0 0 .9rem; }
    .involucro h1 { font-family: var(--serif); font-weight: 400; font-size: clamp(2.1rem,6vw,3.6rem); line-height: 1.05; margin: 0 0 .5rem; letter-spacing: -.01em; }
    .sottotitolo { font-family: var(--serif); font-style: italic; font-size: clamp(1rem,2.5vw,1.25rem); color: var(--crema-tenue); margin: 0 0 1.5rem; max-width: 46ch; }
    .conteggio { display: flex; flex-wrap: wrap; gap: 1.75rem; font-family: var(--mono); font-size: .78rem; letter-spacing: .04em; color: var(--crema-tenue); }
    .conteggio b { display: block; font-family: var(--serif); font-size: 1.9rem; color: var(--crema); font-weight: 400; letter-spacing: 0; line-height: 1.1; }
    .conteggio .acceso b { color: var(--oro-chiaro); }
    .coda { margin-top: 3.5rem; border-top: 2px solid var(--verde); padding-top: 1.75rem; font-size: .88rem; color: rgba(34,48,31,.68); max-width: 68ch; }
    .coda h2 { font-family: var(--serif); font-weight: 400; font-size: 1.3rem; color: var(--verde); margin: 0 0 .75rem; }
    .coda p { margin: 0 0 .85rem; }
    .coda strong { color: var(--verde); font-weight: 600; }
    .segnatura { font-family: var(--mono); font-size: .72rem; letter-spacing: .05em; color: var(--oro-scuro); }
    .avvertenza { border-left: 2px solid var(--oro); padding-left: 1rem; margin: 1.5rem 0; }
    .briciole { font-family: var(--mono); font-size: .68rem; letter-spacing: .03em; color: rgba(245,239,224,.5); margin: 0 0 1.1rem; }
    .briciole a { color: rgba(245,239,224,.78); text-decoration: none; }
    .briciole a:hover { color: var(--oro-chiaro); }
    @media (prefers-reduced-motion: reduce) { .involucro * { animation: none !important; transition: none !important; } }
  </style>

  <div class="sezione-cimiteri">
    <BarraSezione fondo={fondo} />
    <div class="involucro">
      <header>
        <nav class="briciole" aria-label="Percorso">
          <a href="/archivio">Archivio</a> › <a href="/cimiteri-di-guerra">Cimiteri di guerra</a> › <a href={`/cimiteri-di-guerra/${fondo.slug_breve}`}>{fondo.comune}</a> › <span aria-current="page">Planimetria</span>
        </nav>
        <p class="occhiello">Associazione El Brenz · Valli del Noce</p>
        <h1>I nomi di {fondo.comune}</h1>
        <p class="sottotitolo">
          {fondo.tipo === 'cimitero_militare' ? 'Il cimitero militare austro-ungarico' : fondo.titolo}
          {fondo.anno_da && fondo.anno_a ? `, ${fondo.anno_da}–${fondo.anno_a}` : ''}.
          {fondo.posti_censiti ?? fondo.nomi_noti} tombe, di cui {fondo.nomi_noti} hanno ancora un nome.
        </p>
        <div class="conteggio">
          <div class="acceso"><b>{fondo.nomi_noti}</b>nomi restituiti</div>
          <div><b>{fondo.senza_nome}</b>tombe senza nome</div>
          <div class="acceso"><b>{nOtt}</b>morti nel solo ottobre {fondo.anno_a ?? ''}</div>
          <div><b>{nPow}</b>prigionieri di guerra</div>
        </div>
      </header>

      <Planimetria fondo={fondo} persone={persone} />

      <div class="coda">
        <h2>Da dove viene questo elenco</h2>
        {fondo.ricercatore_note ? (
          <p>{fondo.ricercatore_note}</p>
        ) : fondo.ricercatore && (
          <p>Il registro è stato ritrovato e messo a disposizione dell'Associazione El Brenz da <strong>{fondo.ricercatore}</strong>.</p>
        )}
        {fondo.segnatura && <p class="segnatura">{fondo.segnatura}</p>}
        {geo?.nota && (
          <div class="avvertenza">
            <p><strong>La disposizione delle tombe è una ricostruzione.</strong> {geo.nota}</p>
          </div>
        )}
        {provenienzeTesto && (
          <p>Le provenienze dicono il resto: {provenienzeTesto}. Sotto il campanile di {fondo.comune} non riposano trentini, ma un impero intero.</p>
        )}
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb(briciole))} is:inline />
</Layout>
