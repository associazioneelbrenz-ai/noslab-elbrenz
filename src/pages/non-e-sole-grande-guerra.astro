---
/**
 * /non-e-sole-grande-guerra — Museo digitale della Grande Guerra.
 * Archivio AUTONOMO (tabella museo_gg_pezzo), staccato dai Custodi.
 * SSR: legge i pezzi con stato='pubblicato' (policy di lettura pubblica) e ne
 * rende una galleria da museo; ogni pezzo apre il suo "cartellino" (fonte,
 * elaborazione, donatore). Immagine d'apertura con didascalia/crediti d'archivio.
 * Fase B: upload/pubblicazione solo admin via /museo-gg-curatela.
 * Referente: Michele Corradini · Supervisione: Cristian Bresadola.
 */
import Layout from '../layouts/Layout.astro';
import { createClient } from '@supabase/supabase-js';
// [9/8/2026] I pezzi del museo sono fotografati dai soci e caricati interi:
// stessa storia delle copertine delle storie. Vedi lib/immagini.
import { imgRid, srcSetCard } from '../lib/immagini';

export const prerender = false;

const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL as string;
const SUPABASE_ANON = import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string;

const TITOLO = 'Non e Sole Grande Guerra - Erster Weltkrieg Rayon II - storia e cultura';
const IMG = '/img/home/grande-guerra-card.webp';
const IMG_ALT = 'Soldati in divisa austro-ungarica salutano dai vagoni di un treno affollato mentre la folla li accompagna, stazione ferroviaria, 1914.';
const DIDASCALIA = 'Partenza per il fronte della Galizia, 1914. Foto d’epoca, Tiroler Landesarchiv (Landesarchiv Innsbruck). Elaborazione digitale di Michele Corradini.';

type Pezzo = {
  id: string; slug: string | null; titolo: string; descrizione: string | null; racconto: string | null; tipo: string;
  anno: number | null; periodo: string | null; luogo: string | null; valle: string | null;
  fonte: string; elaborazione: string | null; donatore: string | null; immagini_urls: string[];
};
type Raccolta = {
  slug: string | null; titolo: string; occhiello: string | null;
  sommario: string | null; copertina_url: string | null;
};
let raccolte: Raccolta[] = [];
let pezzi: Pezzo[] = [];
try {
  const sb = createClient(SUPABASE_URL, SUPABASE_ANON, { auth: { persistSession: false } });
  // Solo colonne pubbliche del cartellino; niente caricato_da/validato_da.
  const { data } = await sb.from('museo_gg_pezzo')
    .select('id, slug, titolo, descrizione, racconto, tipo, anno, periodo, luogo, valle, fonte, elaborazione, donatore, immagini_urls')
    .eq('stato', 'pubblicato')
    .order('ordine', { ascending: true }).order('anno', { ascending: true });
  pezzi = (data as Pezzo[]) ?? [];

  // Le raccolte pubblicate: la RLS espone solo quelle. Se la lettura fallisce,
  // la fascia semplicemente non compare e il mosaico resta al suo posto.
  const { data: dRac } = await sb.from('museo_gg_raccolta')
    .select('slug, titolo, occhiello, sommario, copertina_url')
    .eq('stato', 'pubblicata')
    .order('ordine', { ascending: true }).order('created_at', { ascending: false });
  raccolte = (dRac as Raccolta[]) ?? [];
} catch (e) {
  console.error('[museo-gg] lettura pezzi fallita:', e);
}

const VALLE: Record<string, string> = {
  val_di_non: 'Val di Non', val_di_sole: 'Val di Sole', val_di_rabbi: 'Val di Rabbi',
  val_di_pejo: 'Val di Pejo', piu_valli: 'Più valli',
};
const TIPO: Record<string, string> = {
  foto: 'Fotografia', fotografia: 'Fotografia', cartolina: 'Cartolina',
  lettera: 'Lettera', documento: 'Documento', oggetto: 'Oggetto',
};
const etichettaTipo = (t: string) => TIPO[t] ?? t;
const etichettaValle = (v: string | null) => (v && VALLE[v]) ? VALLE[v] : (v ?? '');
// Opzioni filtro presenti fra i pezzi pubblicati.
const tipiPresenti = [...new Set(pezzi.map((p) => p.tipo).filter(Boolean))];
const valliPresenti = [...new Set(pezzi.map((p) => p.valle).filter((v): v is string => !!v))];
const periodiPresenti = [...new Set(pezzi.map((p) => p.periodo).filter((v): v is string => !!v))].sort();
// La scheda propria esiste solo se il pezzo ha uno slug: i pezzi nati prima
// della colonna restano apribili nel lightbox, senza link morti.
const linkPezzo = (p: Pezzo) => (p.slug ? `/non-e-sole-grande-guerra/${p.slug}` : null);
---

<Layout title={`${TITOLO} · El Brenz`} description="La Grande Guerra vissuta nelle Valli del Noce: soldati trentini nell'esercito austro-ungarico, il fronte della Galizia dal 1914, i profughi, le famiglie. Sezione a cura di Michele Corradini." ogImage="/og/og-grande-guerra.jpg">
  <main class="bg-[#F8F1E4] min-h-screen">
    <div class="max-w-3xl mx-auto px-6 py-10 md:py-14">
      <p class="text-[11px] tracking-[0.22em] uppercase text-[#8a6215] font-semibold m-0 mb-3" style="font-family: 'Inter', sans-serif;">Una sezione di El Brenz</p>
      <h1 class="text-2xl md:text-3xl leading-tight text-[#1E2E26] m-0 mb-6" style="font-family: 'Playfair Display', serif; font-weight: 500;">{TITOLO}</h1>

      <figure class="m-0 mb-8">
        <img src={IMG} alt={IMG_ALT} width="1648" height="927" class="w-full h-auto rounded-md" loading="eager" decoding="async" />
        <figcaption class="text-[12px] text-[#1E2E26]/60 mt-2 leading-relaxed" style="font-family: 'Inter', sans-serif;">{DIDASCALIA}</figcaption>
      </figure>

      <div class="prose-eb text-[#1E2E26]/85 leading-relaxed space-y-4" style="font-family: 'Source Serif 4', Georgia, serif;">
        <h2 class="text-xl md:text-2xl leading-tight text-[#1E2E26] m-0 mb-2" style="font-family: 'Playfair Display', serif; font-weight: 500;">Le nose valli nella Grande Guerra</h2>
        <p>
          Quando l'Europa precipitò nella guerra, nell'estate del 1914, le Valli del Noce erano terra
          d'Austria. Da oltre un secolo il Trentino apparteneva all'Impero asburgico, e i nostri uomini
          partirono in divisa austro-ungarica, richiamati come tanti altri sudditi dell'Imperatore. La
          prima destinazione non furono le montagne di casa, ma il fronte orientale: nel 1914 i
          reggimenti tirolesi salirono sui treni diretti in Galizia, a combattere la Russia in una guerra
          lontanissima, da cui molti non fecero ritorno. È quella partenza che racconta la fotografia qui
          sopra, la folla sulle rotaie e i soldati che salutano dai vagoni, quando ancora nessuno
          immaginava cosa li attendeva.
        </p>
        <p>
          Nel maggio del 1915 la guerra tornò a casa. L'Italia dichiarò guerra all'Austria-Ungheria e il
          fronte si aprì proprio sulle nostre montagne. Il passo del Tonale, l'Adamello, la Presanella, il
          Cevedale, l'Ortles: le cime tra Val di Sole, Val di Rabbi e Val di Pejo diventarono trincee di
          ghiaccio, teatro di quella guerra bianca combattuta a quote impossibili, tra valanghe, gelo e
          granate. A presidiare i passi furono chiamati anche gli Standschützen, la milizia territoriale
          fatta di uomini troppo giovani o troppo anziani per la leva. La linea del fuoco passava sopra i
          paesi, e i paesi si ritrovarono in prima linea senza averlo chiesto.
        </p>
        <p>
          Per la gente delle valli fu anche l'esilio. Migliaia di civili furono evacuati: alcuni verso i
          campi profughi dell'interno dell'Austria, altri verso l'Italia, famiglie divise tra i due
          fronti, a volte per anni. Chi restò conobbe la fame, i bombardamenti, le case requisite, il
          lavoro imposto. Fu una guerra vissuta due volte, al fronte dagli uomini e nelle case da donne,
          anziani e bambini.
        </p>
        <p>
          Questa sezione raccoglie e custodisce quella memoria: testimonianze, fotografie, cartoline dal
          fronte, lettere, racconti di famiglia. Ogni documento è un frammento di una storia che rischia
          di svanire, la storia delle Valli del Noce nella Grande Guerra, raccontata dal versante da cui
          raramente la si ascolta. Se conservi un ricordo, una foto, una cartolina o un racconto
          tramandato, portalo: entrerà a far parte di questo archivio condiviso.
        </p>
      </div>

      <div class="mt-8 bg-[#F5EEDD] border border-[#C8923E]/40 rounded-md p-5" style="font-family: 'Inter', sans-serif;">
        <p class="m-0 text-sm text-[#1E2E26]/80"><strong>Referente</strong>: Michele Corradini · <strong>Supervisione</strong>: Cristian Bresadola</p>
      </div>

      <section class="mt-10">
        {/* I percorsi: le raccolte tematiche. Stanno PRIMA del mosaico perche' i
            filtri servono a cercare e le raccolte a far leggere: chi arriva qui
            senza sapere cosa cerca deve trovare una porta, non una griglia.
            La fascia sparisce da sola finche' non ce n'e' nessuna pubblicata. */}
        {raccolte.length > 0 && (
          <div class="mb-12">
            <h2 class="text-[13px] tracking-[0.2em] uppercase text-[#8a6215] font-medium mb-5 pb-2 border-b border-[#C8923E]/30" style="font-family: 'Inter', sans-serif;">I percorsi</h2>
            <div class="grid sm:grid-cols-2 gap-4">
              {raccolte.map((r) => (
                <a href={r.slug ? `/non-e-sole-grande-guerra/raccolte/${r.slug}` : '#'}
                  class="block no-underline border border-[#C8923E]/25 bg-[#F5EEDD] rounded-md overflow-hidden group">
                  {r.copertina_url && (
                    <span class="block overflow-hidden bg-[#e8dcc4]">
                      <img src={imgRid(r.copertina_url, 800)} srcset={srcSetCard(r.copertina_url, 400)}
                        sizes="(min-width: 768px) 400px, 100vw"
                        alt={r.titolo} loading="lazy" decoding="async"
                        class="w-full h-auto group-hover:scale-[1.03] transition-transform duration-300" />
                    </span>
                  )}
                  <span class="block p-4">
                    {r.occhiello && (
                      <span class="block text-[10px] tracking-[0.16em] uppercase text-[#8a6215] mb-1" style="font-family: 'Inter', sans-serif;">{r.occhiello}</span>
                    )}
                    <span class="block text-lg leading-snug text-[#1E2E26]" style="font-family: 'Playfair Display', serif;">{r.titolo}</span>
                    {r.sommario && (
                      <span class="block text-sm text-[#1E2E26]/70 leading-relaxed mt-1" style="font-family: 'Inter', sans-serif;">{r.sommario}</span>
                    )}
                  </span>
                </a>
              ))}
            </div>
          </div>
        )}

        {/*
          LA FACCIA DEL MUSEO. Mancava, e con due soli pezzi era la cosa piu'
          importante: una pagina che si desse arie da museo ricco farebbe una
          figura peggiore di una che dice, senza giri, che sta nascendo. Qui si
          spiega cos'e', chi lo alimenta e come si contribuisce. E si mette in
          evidenza il primo pezzo portato da un socio, perche' e' la prova che
          la cosa funziona: non un esempio, un fatto.
        */}
        <section class="not-prose my-12 bg-[#F5EEDD] border border-[#C8923E]/35 rounded-lg p-6 md:p-8">
          <h2 class="text-xl md:text-2xl leading-tight text-[#1E2E26] m-0 mb-3"
              style="font-family: 'Playfair Display', serif; font-weight: 500;">Un museo che non ha una sede</h2>
          <p class="text-[#1E2E26]/85 leading-relaxed m-0 mb-3" style="font-family: 'Source Serif 4', Georgia, serif;">
            Gli oggetti della Grande Guerra delle nostre valli non stanno in una vetrina: stanno nei
            cassetti, nelle soffitte, dentro le scatole di latta che passano di padre in figlio. Una
            cartolina dal fronte, una gavetta, la fotografia di un uomo in divisa di cui non si sa più
            il nome. Questo archivio esiste per tenerne memoria dove sono, fotografandoli e
            raccontandoli, senza chiedere a nessuno di separarsene.
          </p>
          <p class="text-[#1E2E26]/85 leading-relaxed m-0 mb-5" style="font-family: 'Source Serif 4', Georgia, serif;">
            È appena cominciato: <strong>{pezzi.length === 1 ? 'un pezzo' : `${pezzi.length} pezzi`} in
            catalogo</strong>, ciascuno con la sua fonte dichiarata e il consenso di chi lo custodisce.
            Non è una collezione, è l'inizio di una. Cresce solo se qualcuno apre un cassetto.
          </p>

          {pezzi.find((p: any) => /standschutzen-di-cusiano/i.test(p.slug ?? '')) && (
            <a href={`/non-e-sole-grande-guerra/${pezzi.find((p: any) => /standschutzen-di-cusiano/i.test(p.slug ?? '')).slug}`}
               class="block no-underline group border-t border-[#C8923E]/30 pt-5">
              <p class="text-[11px] tracking-[0.2em] uppercase text-[#8a6215] font-semibold m-0 mb-2"
                 style="font-family: 'Inter', sans-serif;">Il primo pezzo portato da un socio</p>
              <div class="flex gap-4 items-start">
                {pezzi.find((p: any) => /standschutzen-di-cusiano/i.test(p.slug ?? '')).immagini_urls?.[0] && (
                  <img src={imgRid(pezzi.find((p: any) => /standschutzen-di-cusiano/i.test(p.slug ?? '')).immagini_urls[0], 256)}
                       srcset={srcSetCard(pezzi.find((p: any) => /standschutzen-di-cusiano/i.test(p.slug ?? '')).immagini_urls[0], 128)}
                       sizes="(min-width: 768px) 128px, 96px"
                       alt="" loading="lazy" decoding="async"
                       class="w-24 h-24 md:w-32 md:h-32 object-cover rounded border border-[#E8DFC7] flex-none" />
                )}
                <div class="min-w-0">
                  <h3 class="text-lg md:text-xl leading-snug text-[#1E2E26] m-0 mb-1 group-hover:underline decoration-1 underline-offset-4"
                      style="font-family: 'Playfair Display', serif; font-weight: 500;">
                    {pezzi.find((p: any) => /standschutzen-di-cusiano/i.test(p.slug ?? '')).titolo}
                  </h3>
                  <p class="text-[#1E2E26]/75 text-sm leading-relaxed m-0"
                     style="font-family: 'Source Serif 4', Georgia, serif;">
                    Gli Standschützen al Tonale: la milizia dei troppo giovani e dei troppo vecchi,
                    mandata a tenere i passi. Portato in archivio da un socio, con le sue fotografie.
                  </p>
                </div>
              </div>
            </a>
          )}

          <div class="border-t border-[#C8923E]/30 mt-5 pt-5">
            <p class="text-[11px] tracking-[0.2em] uppercase text-[#8a6215] font-semibold m-0 mb-2"
               style="font-family: 'Inter', sans-serif;">Come si contribuisce</p>
            <p class="text-[#1E2E26]/85 leading-relaxed m-0 mb-4" style="font-family: 'Source Serif 4', Georgia, serif;">
              Si fotografa l'oggetto, si dice da dove viene e chi lo custodisce, e si dichiara di avere
              il diritto di mostrarlo. Nient'altro. L'oggetto resta a casa tua: quello che entra in
              archivio è la sua immagine e la sua storia. Ogni scheda passa da un curatore prima di
              comparire qui, perché una fonte sbagliata resta sbagliata per sempre.
            </p>
            <a href="#dona-materiale"
               class="inline-block bg-[#C8923E] text-[#1E2E26] font-semibold px-6 py-2.5 rounded-md no-underline hover:bg-[#D9A94E] transition-colors"
               style="font-family: 'Inter', sans-serif;">Dona una fotografia o un oggetto</a>
          </div>
        </section>

        <h2 class="text-[13px] tracking-[0.2em] uppercase text-[#8a6215] font-medium mb-5 pb-2 border-b border-[#C8923E]/30" style="font-family: 'Inter', sans-serif;">La collezione</h2>

        {pezzi.length === 0 ? (
          <p class="text-[#1E2E26]/70 text-lg py-4" style="font-family: 'Source Serif 4', Georgia, serif;">
            L'archivio sta prendendo forma. I primi pezzi (fotografie, cartoline dal fronte, lettere e
            documenti) saranno presto qui, ciascuno con la sua fonte e la sua storia.
          </p>
        ) : (
          <>
            <div class="flex flex-wrap gap-2 mb-6" style="font-family: 'Inter', sans-serif;">
              {tipiPresenti.length > 1 && (
                <select id="museo-f-tipo" class="text-sm border border-[#C8923E]/40 bg-white text-[#1E2E26] px-3 py-1.5 rounded">
                  <option value="">Tutti i tipi</option>
                  {tipiPresenti.map((t) => <option value={t}>{etichettaTipo(t)}</option>)}
                </select>
              )}
              {valliPresenti.length > 1 && (
                <select id="museo-f-valle" class="text-sm border border-[#C8923E]/40 bg-white text-[#1E2E26] px-3 py-1.5 rounded">
                  <option value="">Tutte le valli</option>
                  {valliPresenti.map((v) => <option value={v}>{etichettaValle(v)}</option>)}
                </select>
              )}
              {periodiPresenti.length > 1 && (
                <select id="museo-f-periodo" class="text-sm border border-[#C8923E]/40 bg-white text-[#1E2E26] px-3 py-1.5 rounded">
                  <option value="">Tutti i periodi</option>
                  {periodiPresenti.map((v) => <option value={v}>{v}</option>)}
                </select>
              )}
            </div>

            {/* Mosaico: colonne CSS invece della griglia a riquadri uguali, cosi'
                ogni immagine tiene le sue proporzioni. Una cartolina orizzontale
                e una lettera verticale non vanno ritagliate nello stesso 4:3:
                in un museo si espone il pezzo, non la cornice. */}
            <div id="museo-griglia" class="columns-2 md:columns-3 gap-3">
              {pezzi.map((p) => (
                <a
                  href={linkPezzo(p) ?? '#'}
                  class="museo-tile group block break-inside-avoid mb-3 text-left no-underline border border-[#C8923E]/25 bg-[#F5EEDD] overflow-hidden cursor-pointer"
                  data-tipo={p.tipo}
                  data-valle={p.valle ?? ''}
                  data-periodo={p.periodo ?? ''}
                  data-pezzo={JSON.stringify(p)}
                >
                  <span class="block overflow-hidden bg-[#e8dcc4]">
                    {p.immagini_urls[0] && (
                      <img src={imgRid(p.immagini_urls[0], 600)} srcset={srcSetCard(p.immagini_urls[0], 300)}
                        sizes="(min-width: 768px) 300px, 50vw"
                        alt={p.titolo} loading="lazy" decoding="async"
                        class="w-full h-auto group-hover:scale-[1.03] transition-transform duration-300" />
                    )}
                  </span>
                  <span class="block p-2.5">
                    <span class="block text-[13px] leading-snug text-[#1E2E26]" style="font-family: 'Playfair Display', serif;">{p.titolo}</span>
                    <span class="block text-[10px] tracking-[0.12em] uppercase text-[#8a6215] mt-1" style="font-family: 'Inter', sans-serif;">
                      {etichettaTipo(p.tipo)}{p.periodo ? ` · ${p.periodo}` : (p.anno ? ` · ${p.anno}` : '')}
                    </span>
                  </span>
                </a>
              ))}
            </div>
            <p id="museo-vuoto" class="hidden text-[#1E2E26]/60 text-sm py-4" style="font-family: 'Inter', sans-serif;">Nessun pezzo per questo filtro.</p>
          </>
        )}

        {/* Proponi materiale — segnalazione pubblica (senza login), V1 senza upload */}
        <div id="proponi" class="mt-10 scroll-mt-24 bg-[#F5EEDD] border border-[#C8923E]/40 rounded-md p-5 md:p-6" style="font-family: 'Inter', sans-serif;">
          <h3 class="text-lg text-[#1E2E26] m-0 mb-2" style="font-family: 'Playfair Display', serif; font-weight: 500;">Hai materiale sulla Grande Guerra?</h3>
          <p class="text-sm text-[#1E2E26]/75 leading-relaxed m-0">
            Le foto in soffitta, le cartoline dal fronte, le lettere di famiglia, un oggetto tramandato:
            possono entrare in questo archivio. Proponili qui, vi ricontattiamo noi. Non serve caricare
            nulla adesso, basta una descrizione e un recapito.
          </p>

          <details id="mgp-details" class="mt-4">
            <summary class="inline-block bg-[#C8923E] text-[#1E2E26] px-6 py-2.5 text-sm font-medium tracking-wide uppercase rounded cursor-pointer select-none hover:bg-[#D9A94E] transition-colors list-none">Proponi materiale</summary>

            <form id="mgp-form" data-endpoint={`${SUPABASE_URL}/functions/v1/museo-gg-proposta`} class="mt-5 grid gap-4">
              <div class="grid sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm text-[#1E2E26]/75 mb-1" for="mgp-nome">Nome <span class="text-[#a33]">*</span></label>
                  <input id="mgp-nome" name="nome" type="text" maxlength="100" class="w-full border-2 border-[#E5DFCF] bg-white px-3 py-2 rounded text-[#1E2E26] focus:outline-none focus:border-[#C8923E]" />
                </div>
                <div>
                  <label class="block text-sm text-[#1E2E26]/75 mb-1" for="mgp-contatto">Come ricontattarti <span class="text-[#a33]">*</span></label>
                  <input id="mgp-contatto" name="contatto" type="text" maxlength="200" placeholder="email o telefono" class="w-full border-2 border-[#E5DFCF] bg-white px-3 py-2 rounded text-[#1E2E26] focus:outline-none focus:border-[#C8923E]" />
                </div>
              </div>
              <div>
                <label class="block text-sm text-[#1E2E26]/75 mb-1" for="mgp-tipo">Tipo di materiale</label>
                <select id="mgp-tipo" name="tipo" class="w-full border-2 border-[#E5DFCF] bg-white px-3 py-2 rounded text-[#1E2E26] focus:outline-none focus:border-[#C8923E]">
                  <option value="">— facoltativo —</option>
                  <option value="foto">Fotografia</option>
                  <option value="cartolina">Cartolina</option>
                  <option value="lettera">Lettera</option>
                  <option value="documento">Documento</option>
                  <option value="oggetto">Oggetto</option>
                  <option value="altro">Altro</option>
                </select>
              </div>
              <div>
                <label class="block text-sm text-[#1E2E26]/75 mb-1" for="mgp-descr">Descrizione <span class="text-[#a33]">*</span></label>
                <textarea id="mgp-descr" name="descrizione" rows="3" maxlength="2000" placeholder="Cosa hai e, se lo sai, da dove viene (una foto del nonno, una cartolina dal fronte…)" class="w-full border-2 border-[#E5DFCF] bg-white px-3 py-2 rounded text-[#1E2E26] focus:outline-none focus:border-[#C8923E]"></textarea>
              </div>
              <label class="flex items-start gap-2 text-sm text-[#1E2E26]/80">
                <input id="mgp-consenso" name="accettazione_privacy" type="checkbox" class="mt-1" />
                <span>Acconsento al trattamento dei miei dati (nome e recapito) per essere ricontattato in merito a questa proposta. <a href="/privacy" class="text-[#8a6215] underline">Informativa privacy</a>. <span class="text-[#a33]">*</span></span>
              </label>
              {/* honeypot anti-bot: deve restare vuoto */}
              <input type="text" name="_honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
              <div class="flex flex-wrap items-center gap-3">
                <button id="mgp-submit" type="submit" class="bg-[#1E2E26] text-[#F5EEDD] px-5 py-2.5 rounded text-sm font-medium hover:bg-[#2a3f34] transition-colors">Invia proposta</button>
                <span id="mgp-esito" class="hidden text-sm rounded px-3 py-2"></span>
              </div>
            </form>
          </details>
        </div>
      </section>

      {/* DONA MATERIALE — canale UPLOAD (carica le scansioni ora), distinto da
          "Proponi materiale" qui sopra (canale rapido "raccontaci, ti ricontattiamo").
          Form pubblico: valida server-side, carica nel bucket PRIVATO, INSERT in
          attesa, notifica al direttivo. Nulla e' pubblico finche' un curatore non
          approva e promuove. Edge: donazione-upload (verify_jwt=false). */}
      <section id="dona-materiale" class="mt-8">
        <div class="bg-[#F5EEDD] border border-[#C8923E]/40 rounded-md p-5 md:p-6" style="font-family: 'Inter', sans-serif;">
          <h3 class="text-lg text-[#1E2E26] m-0 mb-2" style="font-family: 'Playfair Display', serif; font-weight: 500;">Hai gia' le scansioni? Dona il materiale</h3>
          <p class="text-sm text-[#1E2E26]/75 leading-relaxed m-0">
            Se avete gia' digitalizzato foto, lettere, documenti o oggetti della Grande Guerra,
            caricateli direttamente qui. <strong>Il materiale resta della famiglia: El Brenz lo
            custodisce e lo racconta.</strong> Ogni donazione viene esaminata dai curatori prima
            di qualsiasi pubblicazione. Se preferite prima solo segnalarcelo, usate
            <strong>"Proponi materiale"</strong> qui sopra.
          </p>

          <details id="don-details" class="mt-4">
            <summary class="inline-block bg-[#C8923E] text-[#1E2E26] px-6 py-2.5 text-sm font-medium tracking-wide uppercase rounded cursor-pointer select-none hover:bg-[#D9A94E] transition-colors list-none">Dona materiale</summary>

            <form id="form-donazione" novalidate class="mt-5 grid gap-4">
              {/* honeypot anti-bot: deve restare vuoto */}
              <input type="text" name="_honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />

              <div>
                <label class="block text-sm text-[#1E2E26]/75 mb-1" for="don-titolo">Titolo del materiale <span class="text-[#a33]">*</span></label>
                <input id="don-titolo" name="titolo" type="text" maxlength="140" placeholder="Es. Cartolina dal fronte, 1916" class="w-full border-2 border-[#E5DFCF] bg-white px-3 py-2 rounded text-[#1E2E26] focus:outline-none focus:border-[#C8923E]" />
              </div>

              <div>
                <label class="block text-sm text-[#1E2E26]/75 mb-1" for="don-descr">Descrizione <span class="text-[#a33]">*</span></label>
                <textarea id="don-descr" name="descrizione" rows="4" maxlength="2000" placeholder="Raccontateci cosa e', a chi apparteneva, cosa sapete della sua storia" class="w-full border-2 border-[#E5DFCF] bg-white px-3 py-2 rounded text-[#1E2E26] focus:outline-none focus:border-[#C8923E]"></textarea>
              </div>

              <div>
                <label class="block text-sm text-[#1E2E26]/75 mb-1" for="don-prov">Provenienza <span class="text-[#a33]">*</span></label>
                <input id="don-prov" name="provenienza" type="text" maxlength="200" placeholder="Es. Archivio famiglia Rossi, Vermiglio" class="w-full border-2 border-[#E5DFCF] bg-white px-3 py-2 rounded text-[#1E2E26] focus:outline-none focus:border-[#C8923E]" />
              </div>

              <div>
                <label class="block text-sm text-[#1E2E26]/75 mb-1" for="don-tipo">Tipo di materiale <span class="text-[#a33]">*</span></label>
                <select id="don-tipo" name="tipo" class="w-full border-2 border-[#E5DFCF] bg-white px-3 py-2 rounded text-[#1E2E26] focus:outline-none focus:border-[#C8923E]">
                  <option value="foto">Fotografia</option>
                  <option value="documento">Documento</option>
                  <option value="lettera">Lettera o cartolina</option>
                  <option value="oggetto_fotografato">Oggetto fotografato</option>
                  <option value="altro">Altro</option>
                </select>
              </div>

              <div class="grid sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm text-[#1E2E26]/75 mb-1" for="don-nome">Nome e cognome <span class="text-[#a33]">*</span></label>
                  <input id="don-nome" name="donatore_nome" type="text" maxlength="100" class="w-full border-2 border-[#E5DFCF] bg-white px-3 py-2 rounded text-[#1E2E26] focus:outline-none focus:border-[#C8923E]" />
                </div>
                <div>
                  <label class="block text-sm text-[#1E2E26]/75 mb-1" for="don-email">Email <span class="text-[#a33]">*</span></label>
                  <input id="don-email" name="donatore_email" type="email" maxlength="200" class="w-full border-2 border-[#E5DFCF] bg-white px-3 py-2 rounded text-[#1E2E26] focus:outline-none focus:border-[#C8923E]" />
                </div>
              </div>

              <div>
                <label class="block text-sm text-[#1E2E26]/75 mb-1" for="don-tel">Telefono (facoltativo)</label>
                <input id="don-tel" name="donatore_telefono" type="tel" maxlength="40" class="w-full border-2 border-[#E5DFCF] bg-white px-3 py-2 rounded text-[#1E2E26] focus:outline-none focus:border-[#C8923E]" />
              </div>

              <div>
                <label class="block text-sm text-[#1E2E26]/75 mb-1" for="file-donazione">File <span class="text-[#a33]">*</span> <span class="text-[#1E2E26]/55">(fino a 5: JPG, PNG, WebP o PDF, max 15 MB ciascuno)</span></label>
                <input id="file-donazione" name="file" type="file" multiple accept=".jpg,.jpeg,.png,.webp,.pdf,image/jpeg,image/png,image/webp,application/pdf" class="w-full text-sm text-[#1E2E26]" />
                <small id="file-riepilogo" class="block mt-1 text-[#1E2E26]/60"></small>
              </div>

              <label class="flex items-start gap-2 text-sm text-[#1E2E26]/80">
                <input name="consenso_diritti" type="checkbox" value="1" class="mt-1" />
                <span>Dichiaro di essere titolare dei diritti sul materiale o autorizzato dalla famiglia a donarlo. <span class="text-[#a33]">*</span></span>
              </label>
              <label class="flex items-start gap-2 text-sm text-[#1E2E26]/80">
                <input name="consenso_conservazione" type="checkbox" value="1" class="mt-1" />
                <span>Autorizzo El Brenz a conservare il materiale e, previa valutazione dei curatori, a pubblicarlo con indicazione della provenienza. <span class="text-[#a33]">*</span></span>
              </label>
              <label class="flex items-start gap-2 text-sm text-[#1E2E26]/80">
                <input name="consenso_privacy" type="checkbox" value="1" class="mt-1" />
                <span>Ho letto l'<a href="/privacy" target="_blank" rel="noopener" class="text-[#8a6215] underline">informativa privacy</a> e acconsento al trattamento dei dati per la gestione della donazione. <span class="text-[#a33]">*</span></span>
              </label>

              <div class="flex flex-wrap items-center gap-3">
                <button id="btn-donazione" type="submit" class="bg-[#1E2E26] text-[#F5EEDD] px-5 py-2.5 rounded text-sm font-medium hover:bg-[#2a3f34] transition-colors">Invia la donazione</button>
                <p id="esito-donazione" role="status" aria-live="polite" class="text-sm m-0"></p>
              </div>
            </form>
          </details>
        </div>
      </section>
    </div>

    {/* Cartellino del pezzo (overlay), popolato lato client */}
    <div id="museo-overlay" class="fixed inset-0 z-50 hidden items-start justify-center overflow-y-auto bg-[#1E2E26]/80 p-4" style="font-family: 'Inter', sans-serif;">
      <div class="relative bg-[#F8F1E4] max-w-2xl w-full my-6 rounded-md shadow-xl">
        <button id="museo-chiudi" type="button" aria-label="Chiudi" class="absolute top-2 right-3 text-2xl leading-none text-[#1E2E26]/60 hover:text-[#1E2E26]">×</button>
        <div id="museo-immagini" class="p-4 pt-10 space-y-3"></div>
        <div class="px-6 pb-6">
          <h3 id="museo-titolo" class="text-xl text-[#1E2E26] m-0 mb-2" style="font-family: 'Playfair Display', serif; font-weight: 500;"></h3>
          <p id="museo-descrizione" class="text-[#1E2E26]/85 leading-relaxed m-0 mb-4" style="font-family: 'Source Serif 4', Georgia, serif;"></p>
          {/* AGGIUNTA 1/8/2026 — il racconto del curatore. whitespace-pre-wrap
              perche' gli a capo sono il ritmo del testo: e' la stessa resa di
              /storie/[id], stessa famiglia e stessa interlinea. Resta nascosto
              finche' non c'e' un racconto, cosi' i pezzi di solo cartellino non
              guadagnano uno spazio vuoto. */}
          <div id="museo-racconto" class="hidden text-[#1E2E26]/85 whitespace-pre-wrap break-words m-0 mb-4" style="font-family: 'Source Serif 4', Georgia, serif; font-size: 1.05rem; line-height: 1.7;"></div>
          <dl id="museo-cartellino" class="text-sm text-[#1E2E26]/80 space-y-1.5 border-t border-[#C8923E]/30 pt-4"></dl>
          {/* Dal lightbox alla scheda con indirizzo proprio: da li' il pezzo si
              condivide e i motori lo vedono. Nascosto per i pezzi senza slug. */}
          <a id="museo-scheda" href="#" class="hidden mt-4 text-sm font-semibold text-[#8a6215] no-underline hover:underline">Apri la scheda intera →</a>
        </div>
      </div>
    </div>
  </main>

  <script>
    const overlay = document.getElementById('museo-overlay');
    const griglia = document.getElementById('museo-griglia');
    if (overlay && griglia) {
      const elImg = document.getElementById('museo-immagini')!;
      const elTit = document.getElementById('museo-titolo')!;
      const elDes = document.getElementById('museo-descrizione')!;
      const elCar = document.getElementById('museo-cartellino')!;
      const VALLE_L: Record<string, string> = {
        val_di_non: 'Val di Non', val_di_sole: 'Val di Sole', val_di_rabbi: 'Val di Rabbi',
        val_di_pejo: 'Val di Pejo', piu_valli: 'Più valli',
      };
      const TIPO_L: Record<string, string> = {
        foto: 'Fotografia', fotografia: 'Fotografia', cartolina: 'Cartolina',
        lettera: 'Lettera', documento: 'Documento', oggetto: 'Oggetto',
      };
      const riga = (k: string, v: string | null) =>
        v ? `<div><dt class="inline font-semibold text-[#8a6215]">${k}:</dt> <dd class="inline m-0">${v}</dd></div>` : '';

      // [9/8/2026] La scheda si costruisce qui nel browser, dove `imgRid` di
      // lib/immagini non arriva: stessa regola, riscritta in dieci righe. Senza,
      // aprire un pezzo scaricava le foto originali dei soci a piena
      // risoluzione — e' il difetto che sul telefono lasciava i riquadri vuoti.
      const rid = (u: string, larghezza: number) => {
        const PUBBLICO = '/storage/v1/object/public/';
        if (!u || !u.includes(PUBBLICO)) return u;
        const v = u.replace(PUBBLICO, '/storage/v1/render/image/public/');
        // [15/8] resize=contain, altrimenti Supabase ritaglia i lati invece
        // di rimpicciolire tutta la foto (vedi lib/immagini.ts).
        return `${v}${v.includes('?') ? '&' : '?'}width=${larghezza}&quality=75&resize=contain`;
      };

      function apri(p: any) {
        elImg.innerHTML = (p.immagini_urls || [])
          .map((u: string) => `<img src="${rid(u, 1200)}" srcset="${rid(u, 600)} 600w, ${rid(u, 1200)} 1200w" sizes="(min-width: 768px) 600px, 100vw" alt="${(p.titolo || '').replace(/"/g, '&quot;')}" class="w-full h-auto rounded" loading="lazy" />`)
          .join('');
        elTit.textContent = p.titolo || '';
        elDes.textContent = p.descrizione || '';
        // textContent, non innerHTML: il racconto e' testo scritto da una
        // persona e non deve poter iniettare markup.
        const elRac = document.getElementById('museo-racconto')!;
        elRac.textContent = p.racconto || '';
        elRac.classList.toggle('hidden', !p.racconto);
        elCar.innerHTML = [
          riga('Tipo', TIPO_L[p.tipo] || p.tipo),
          riga('Anno', p.anno ? String(p.anno) : (p.periodo || null)),
          riga('Luogo', p.luogo),
          riga('Valle', p.valle ? (VALLE_L[p.valle] || p.valle) : null),
          riga('Fonte', p.fonte),
          riga('Elaborazione', p.elaborazione),
          riga('Donatore', p.donatore),
        ].join('');
        const elScheda = document.getElementById('museo-scheda') as HTMLAnchorElement | null;
        if (elScheda) {
          if (p.slug) {
            elScheda.href = `/non-e-sole-grande-guerra/${p.slug}`;
            elScheda.classList.remove('hidden');
            elScheda.classList.add('inline-block');
          } else {
            elScheda.classList.add('hidden');
            elScheda.classList.remove('inline-block');
          }
        }
        overlay!.classList.remove('hidden');
        overlay!.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }
      function chiudi() {
        overlay!.classList.add('hidden');
        overlay!.classList.remove('flex');
        document.body.style.overflow = '';
      }

      // Le mattonelle ora sono LINK veri alla scheda del pezzo: i motori le
      // seguono, il tasto centrale apre in una scheda nuova, il menu contestuale
      // offre "copia indirizzo". Il click normale pero' continua ad aprire il
      // lightbox, che funziona ed e' piu' rapido per scorrere la collezione.
      // Si intercetta solo il click semplice: con ctrl/cmd/shift o col tasto
      // centrale si lascia fare al browser quello che l'utente si aspetta.
      griglia.querySelectorAll<HTMLAnchorElement>('.museo-tile').forEach((tile) => {
        tile.addEventListener('click', (e) => {
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || (e as MouseEvent).button !== 0) return;
          e.preventDefault();
          try { apri(JSON.parse(tile.dataset.pezzo || '{}')); } catch {}
        });
      });
      document.getElementById('museo-chiudi')?.addEventListener('click', chiudi);
      overlay.addEventListener('click', (e) => { if (e.target === overlay) chiudi(); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') chiudi(); });

      // Filtri
      const fTipo = document.getElementById('museo-f-tipo') as HTMLSelectElement | null;
      const fValle = document.getElementById('museo-f-valle') as HTMLSelectElement | null;
      const fPeriodo = document.getElementById('museo-f-periodo') as HTMLSelectElement | null;
      const vuoto = document.getElementById('museo-vuoto');
      function filtra() {
        const t = fTipo?.value || '';
        const v = fValle?.value || '';
        const pe = fPeriodo?.value || '';
        let visibili = 0;
        griglia!.querySelectorAll<HTMLElement>('.museo-tile').forEach((tile) => {
          const ok = (!t || tile.dataset.tipo === t)
            && (!v || tile.dataset.valle === v)
            && (!pe || tile.dataset.periodo === pe);
          tile.style.display = ok ? '' : 'none';
          if (ok) visibili++;
        });
        if (vuoto) vuoto.classList.toggle('hidden', visibili > 0);
      }
      fTipo?.addEventListener('change', filtra);
      fValle?.addEventListener('change', filtra);
      fPeriodo?.addEventListener('change', filtra);
    }
  </script>

  <script>
    // Form "Proponi materiale": invio all'edge museo-gg-proposta (honeypot + time-trap).
    const form = document.getElementById('mgp-form') as HTMLFormElement | null;
    if (form) {
      const aperturaTs = Date.now();
      const esito = document.getElementById('mgp-esito')!;
      const submit = document.getElementById('mgp-submit') as HTMLButtonElement;
      const mostra = (msg: string, ok: boolean) => {
        esito.classList.remove('hidden');
        esito.style.background = ok ? '#e9f5ee' : '#fbecec';
        esito.style.color = '#1E2E26';
        esito.textContent = msg;
      };
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        const nome = String(fd.get('nome') ?? '').trim();
        const contatto = String(fd.get('contatto') ?? '').trim();
        const descrizione = String(fd.get('descrizione') ?? '').trim();
        const consenso = (document.getElementById('mgp-consenso') as HTMLInputElement).checked;
        if (nome.length < 2) return mostra('Inserisci il tuo nome.', false);
        if (contatto.length < 3) return mostra('Lascia un contatto (email o telefono).', false);
        if (descrizione.length < 5) return mostra('Descrivi il materiale che vuoi proporre.', false);
        if (!consenso) return mostra('Serve il consenso per poterti ricontattare.', false);

        const payload = {
          nome, contatto, descrizione,
          tipo: String(fd.get('tipo') ?? ''),
          accettazione_privacy: consenso,
          _honeypot: String(fd.get('_honeypot') ?? ''),
          _ts: aperturaTs,
        };
        submit.disabled = true; submit.textContent = 'Invio…';
        try {
          const resp = await fetch(form.dataset.endpoint!, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await resp.json().catch(() => ({}));
          if (resp.ok && data.success) {
            form.reset();
            mostra('Grazie, abbiamo ricevuto la tua proposta: ti ricontatteremo al recapito indicato.', true);
          } else if (resp.status === 429) {
            mostra(data.error || 'Hai inviato troppe proposte. Riprova più tardi.', false);
          } else {
            mostra(data.error || 'Si è verificato un errore. Riprova o scrivi a info@elbrenz.eu.', false);
          }
        } catch {
          mostra('Errore di rete. Controlla la connessione e riprova.', false);
        } finally {
          submit.disabled = false; submit.textContent = 'Invia proposta';
        }
      });
    }
  </script>

  {/* DONA MATERIALE — submit del form upload verso l'edge donazione-upload.
      Validazione client (specchio del server), time-trap _ts, esito parlante. */}
  <script define:vars={{ EDGE_URL: SUPABASE_URL + '/functions/v1/donazione-upload' }}>
    const form = document.getElementById('form-donazione')
    const btn = document.getElementById('btn-donazione')
    const esito = document.getElementById('esito-donazione')
    const fileInput = document.getElementById('file-donazione')
    const riepilogo = document.getElementById('file-riepilogo')
    const MAX_FILES = 5, MAX_FILE = 15 * 1024 * 1024, MAX_TOT = 18 * 1024 * 1024
    const ts = Date.now()

    fileInput.addEventListener('change', () => {
      const fs = Array.from(fileInput.files || [])
      const tot = fs.reduce((a, f) => a + f.size, 0)
      riepilogo.textContent = fs.length
        ? `${fs.length} file, ${(tot / 1048576).toFixed(1)} MB totali`
        : ''
      riepilogo.style.color = (fs.length > MAX_FILES || tot > MAX_TOT || fs.some(f => f.size > MAX_FILE)) ? '#b23b3b' : ''
    })

    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      esito.textContent = ''
      const fs = Array.from(fileInput.files || [])
      if (fs.length === 0) { esito.textContent = 'Allega almeno un file.'; return }
      if (fs.length > MAX_FILES) { esito.textContent = 'Massimo 5 file per invio.'; return }
      if (fs.some(f => f.size > MAX_FILE)) { esito.textContent = 'Ogni file puo’ pesare al massimo 15 MB.'; return }
      if (fs.reduce((a, f) => a + f.size, 0) > MAX_TOT) { esito.textContent = 'Invio complessivo oltre 18 MB: dividi in piu’ invii.'; return }

      const fd = new FormData(form)
      fd.set('_ts', String(ts))
      btn.disabled = true
      btn.textContent = 'Invio in corso...'
      try {
        const res = await fetch(EDGE_URL, { method: 'POST', body: fd })
        const out = await res.json().catch(() => ({}))
        if (res.ok && out.success) {
          form.reset(); riepilogo.textContent = ''
          esito.style.color = '#2d8659'
          esito.textContent = 'Grazie! La donazione e’ arrivata: i curatori la esamineranno e vi ricontatteremo all’email indicata.'
        } else {
          esito.style.color = '#b23b3b'
          esito.textContent = out.error || 'Si e’ verificato un errore. Riprova o scrivi a info@elbrenz.eu.'
        }
      } catch {
        esito.style.color = '#b23b3b'
        esito.textContent = 'Connessione non riuscita. Riprova o scrivi a info@elbrenz.eu.'
      } finally {
        btn.disabled = false
        btn.textContent = 'Invia la donazione'
      }
    })
  </script>
</Layout>
