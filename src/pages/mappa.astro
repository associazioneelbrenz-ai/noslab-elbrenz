---
/**
 * /mappa — Mappa delle Valli (M-F1, Fase 1).
 *
 * Cartografia UFFICIALE PAT (WMS CTP 2020 + Ortofoto 2015, EPSG:3857
 * verificato dai GetCapabilities — STEP 0) con fallback OpenStreetMap se il
 * servizio provinciale non risponde. Due famiglie di punti filtrabili:
 * luoghi di interesse storico-culturale e attività convenzionate.
 *
 * SSR (prerender=false): i punti si leggono A OGNI RICHIESTA dalle viste
 * pubbliche (v_luoghi_mappa, v_convenzioni_mappa) — ogni luogo pubblicato
 * e ogni convenzione geolocalizzata appare senza rebuild (richiesta di
 * Cristian). L'elenco testuale sotto la mappa è server-rendered: SEO +
 * alternativa accessibile.
 *
 * CARICAMENTO DIFFERITO: Leaflet (npm, pinnato 1.9.4, zero CDN) si importa
 * dinamicamente SOLO al click "Carica la mappa": niente peso sul first load
 * (TBT) e nessuna richiesta a server terzi senza gesto dell'utente (privacy).
 * La futura PWA Soci erediterà v_luoghi_mappa tal quale.
 */

import { createClient } from '@supabase/supabase-js';
import Layout from '../layouts/Layout.astro';
import { CATEGORIE_LUOGHI, COLORI_LUOGHI } from '../lib/luoghi';

export const prerender = false;

const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL as string;
const SUPABASE_ANON = import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string;

type Luogo = {
  id: string; nome: string; categoria: string; valle: string;
  lat: number; lng: number; descrizione_breve: string | null; url_articolo: string | null; slug: string | null;
};
type PuntoConv = { convenzione_id: string; nome_punto: string; lat: number; lng: number };
type ConvenzioneMappa = {
  id: string; nome_attivita: string; categoria: string; localita: string | null;
  beneficio: string; lat: number; lng: number; punti?: { nome_punto: string; lat: number; lng: number }[];
};

let luoghi: Luogo[] = [];
let convenzioni: ConvenzioneMappa[] = [];
try {
  const sb = createClient(SUPABASE_URL, SUPABASE_ANON, { auth: { persistSession: false } });
  const [l, c, p] = await Promise.all([
    sb.from('v_luoghi_mappa').select('*').order('nome'),
    sb.from('v_convenzioni_mappa').select('*').order('nome_attivita'),
    // Multi-punto (21/7): una convenzione puo' avere piu' sedi. L'RLS
    // convenzioni_punti_pubblici espone SOLO i punti pubblicati e collegati a
    // convenzioni attive/in-mappa, quindi qui basta leggerli e raggrupparli.
    sb.from('convenzioni_punti').select('convenzione_id, nome_punto, lat, lng'),
  ]);
  luoghi = (l.data as Luogo[]) ?? [];
  convenzioni = (c.data as ConvenzioneMappa[]) ?? [];
  // Aggancia i punti figli alla convenzione; le convenzioni senza punti
  // restano col loro lat/lng singolo (fallback, com'era).
  const puntiPerConv: Record<string, { nome_punto: string; lat: number; lng: number }[]> = {};
  for (const pt of ((p.data as PuntoConv[]) ?? [])) {
    (puntiPerConv[pt.convenzione_id] ??= []).push({ nome_punto: pt.nome_punto, lat: pt.lat, lng: pt.lng });
  }
  convenzioni = convenzioni.map((cv) => ({ ...cv, punti: puntiPerConv[cv.id] ?? [] }));
} catch (e) {
  console.error('[mappa] lettura viste fallita:', e);
}

const VALLI: Record<string, string> = {
  val_di_non: 'Val di Non',
  val_di_sole: 'Val di Sole',
  val_di_rabbi: 'Val di Rabbi',
  val_di_pejo: 'Val di Pejo',
  fuori_valle: 'Fuori valle',
};

// Solo le categorie realmente presenti: niente pulsanti che non filtrano nulla.
const categoriePresenti = [...new Set(luoghi.map((l) => l.categoria))]
  .sort((a, b) => (CATEGORIE_LUOGHI[a] ?? a).localeCompare(CATEGORIE_LUOGHI[b] ?? b));

const datiMappa = { luoghi, convenzioni, valli: VALLI, categorie: CATEGORIE_LUOGHI, colori: COLORI_LUOGHI };
---

<Layout
  title="Mappa delle Valli"
  description="La mappa interattiva delle Valli del Noce: luoghi di interesse storico-culturale e attività convenzionate con l'Associazione El Brenz, su cartografia ufficiale della Provincia Autonoma di Trento."
  ogImage="/og/og-mappa.jpg"
>
  <header class="bg-[#1E2E26] text-[#F5EEDD]">
    <div class="max-w-5xl mx-auto px-6 py-14 md:py-16">
      <p class="text-[11px] tracking-[0.22em] uppercase text-[#D9A94E] font-medium m-0 mb-4" style="font-family: 'Inter', sans-serif;">
        Le nostre valli
      </p>
      <h1 class="text-3xl md:text-4xl leading-tight m-0 mb-3" style="font-family: 'Playfair Display', serif; font-weight: 500;">
        Mappa delle <em class="text-[#C8923E]">Valli</em>
      </h1>
      <p class="text-[#F5EEDD]/75 max-w-2xl m-0" style="font-family: 'Source Serif 4', Georgia, serif;">
        I luoghi dove la <em>nosa storia</em> è di casa e le realtà che accolgono i soci
        El Brenz, sulla cartografia ufficiale del Trentino.
      </p>
    </div>
  </header>

  <section class="bg-[#F8F1E4] py-10">
    <div class="max-w-5xl mx-auto px-6">

      {/* Filtri: tipo e valle. Stato replicato nella querystring (condivisibile). */}
      <div class="flex flex-wrap gap-2 mb-3" role="group" aria-label="Filtra per tipo" style="font-family: 'Inter', sans-serif;">
        <button type="button" data-filtro-tipo="tutti" aria-pressed="true" class="mappa-filtro bg-[#1E2E26] text-[#F5EEDD] px-4 py-2 text-xs uppercase tracking-wider rounded-full cursor-pointer border-2 border-[#1E2E26] focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#C8923E]">Tutto</button>
        <button type="button" data-filtro-tipo="luoghi" aria-pressed="false" class="mappa-filtro bg-white text-[#1E2E26] px-4 py-2 text-xs uppercase tracking-wider rounded-full cursor-pointer border-2 border-[#C8923E]/40 hover:border-[#C8923E] focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#C8923E]">Luoghi di interesse</button>
        <button type="button" data-filtro-tipo="convenzioni" aria-pressed="false" class="mappa-filtro bg-white text-[#1E2E26] px-4 py-2 text-xs uppercase tracking-wider rounded-full cursor-pointer border-2 border-[#C8923E]/40 hover:border-[#C8923E] focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#C8923E]">Convenzioni</button>
      </div>
      <div class="flex flex-wrap gap-2 mb-6" role="group" aria-label="Filtra per valle" style="font-family: 'Inter', sans-serif;">
        <button type="button" data-filtro-valle="tutte" aria-pressed="true" class="mappa-filtro-valle bg-[#1E2E26] text-[#F5EEDD] px-4 py-2 text-xs uppercase tracking-wider rounded-full cursor-pointer border-2 border-[#1E2E26] focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#C8923E]">Tutte le valli</button>
        {Object.entries(VALLI).filter(([k]) => k !== 'fuori_valle').map(([k, label]) => (
          <button type="button" data-filtro-valle={k} aria-pressed="false" class="mappa-filtro-valle bg-white text-[#1E2E26] px-4 py-2 text-xs uppercase tracking-wider rounded-full cursor-pointer border-2 border-[#C8923E]/40 hover:border-[#C8923E] focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#C8923E]">{label}</button>
        ))}
      </div>

      {/* Filtro per categoria: con 54 luoghi in sei categorie, senza questo
          la mappa si legge male. Vale solo per i luoghi; le convenzioni hanno
          gia' il loro filtro di tipo. */}
      <div class="flex flex-wrap gap-2 mb-3" role="group" aria-label="Filtra per categoria" style="font-family: 'Inter', sans-serif;">
        <button type="button" data-filtro-cat="tutte" aria-pressed="true" class="mappa-filtro-cat bg-[#1E2E26] text-[#F5EEDD] px-4 py-2 text-xs uppercase tracking-wider rounded-full cursor-pointer border-2 border-[#1E2E26] focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#C8923E]">Tutte le categorie</button>
        {categoriePresenti.map((c) => (
          <button type="button" data-filtro-cat={c} aria-pressed="false" class="mappa-filtro-cat bg-white text-[#1E2E26] px-4 py-2 text-xs uppercase tracking-wider rounded-full cursor-pointer border-2 border-[#C8923E]/40 hover:border-[#C8923E] focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#C8923E]">{CATEGORIE_LUOGHI[c] ?? c}</button>
        ))}
      </div>

      {/* Legenda dei colori: i pin sono colorati per categoria, va detto. */}
      <div class="flex flex-wrap gap-x-5 gap-y-2 mb-6 text-xs text-[#1E2E26]/70" style="font-family: 'Inter', sans-serif;">
        {categoriePresenti.map((c) => (
          <span class="inline-flex items-center gap-2">
            <span class="inline-block w-3 h-3 rounded-full" style={`background: ${COLORI_LUOGHI[c] ?? '#C8923E'};`} aria-hidden="true"></span>
            {CATEGORIE_LUOGHI[c] ?? c}
          </span>
        ))}
        <span class="inline-flex items-center gap-2">
          <span class="inline-block w-3 h-3 rounded-full" style="background: #1E2E26;" aria-hidden="true"></span>
          Convenzioni soci
        </span>
      </div>

      {/* Placeholder brand: la mappa si inizializza SOLO su gesto esplicito. */}
      <div id="mappa-placeholder" class="bg-[#F5EEDD] border border-[#C8923E]/50 rounded-md text-center py-20 px-6">
        <svg viewBox="0 0 120 80" class="mx-auto mb-5 w-20 h-auto" aria-hidden="true" role="presentation">
          <g fill="none" stroke="#C8923E" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 20 L44 12 L76 20 L106 12 V60 L76 68 L44 60 L14 68 Z"/>
            <path d="M44 12 V60 M76 20 V68"/>
          </g>
          <path d="M60 26 C53 26 47.5 31.5 47.5 38.5 C47.5 47.5 60 62 60 62 S72.5 47.5 72.5 38.5 C72.5 31.5 67 26 60 26 Z" fill="#C8923E" stroke="#1E2E26" stroke-width="2"/>
          <circle cx="60" cy="38.5" r="4.5" fill="#1E2E26"/>
        </svg>
        <p class="text-[#1E2E26]/75 max-w-md mx-auto mb-6" style="font-family: 'Source Serif 4', Georgia, serif;">
          La mappa usa la cartografia ufficiale della Provincia Autonoma di Trento.
          Si carica solo quando lo chiedi tu: nessun dato parte prima.
        </p>
        <button
          id="mappa-carica"
          type="button"
          class="inline-block bg-[#C8923E] text-[#1E2E26] px-8 py-3 text-sm font-medium tracking-wider uppercase cursor-pointer border-0 hover:bg-[#D9A94E] transition-colors focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#C8923E]"
          style="font-family: 'Inter', sans-serif;"
        >
          Carica la mappa
        </button>
      </div>

      <div id="mappa-wrap" class="hidden">
        <div id="mappa" class="h-[70vh] min-h-[420px] rounded-md border border-[#C8923E]/50 z-0" tabindex="0" aria-label="Mappa interattiva delle Valli del Noce"></div>
        <p id="mappa-nota-zoom" class="text-xs text-[#1E2E26]/55 mt-2 m-0" style="font-family: 'Inter', sans-serif;">
          Per usare lo zoom con la rotellina clicca prima sulla mappa. Su telefono: due dita.
        </p>
      </div>

      {/* Alternativa testuale accessibile + SEO: server-rendered, sempre fresca. */}
      <div class="mt-10">
        <h2 class="text-[11px] tracking-[0.2em] uppercase text-[#8a6215] font-medium mb-4 pb-2 border-b border-[#C8923E]/30" style="font-family: 'Inter', sans-serif;">
          I luoghi sulla mappa<span id="mappa-elenco-conteggio" class="text-[#1E2E26]/45 normal-case tracking-normal"></span>
        </h2>
        {luoghi.length === 0 && convenzioni.length === 0 ? (
          <p class="text-[#1E2E26]/60 text-sm" style="font-family: 'Source Serif 4', Georgia, serif;">
            I primi luoghi arriveranno presto: la mappa cresce man mano che il
            Direttivo pubblica i luoghi della <em>nosa storia</em> e le convenzioni
            si geolocalizzano.
          </p>
        ) : (
          <Fragment>
            {/* I data-* vengono dagli stessi record che alimentano i marker: e' quello
                che tiene allineate lista e mappa sotto lo stesso filtro. */}
            <ul id="mappa-elenco" class="grid gap-3 md:grid-cols-2 list-none p-0 m-0" style="font-family: 'Source Serif 4', Georgia, serif;">
              {luoghi.map((l) => (
                <li class="bg-white border-l-4 border-[#C8923E] px-4 py-3" data-tipo="luoghi" data-valle={l.valle} data-categoria={l.categoria} data-slug={l.slug}>
                  <strong class="text-[#1E2E26]">{l.nome}</strong>
                  <span class="text-xs text-[#1E2E26]/55"> · {CATEGORIE_LUOGHI[l.categoria] ?? l.categoria} · {VALLI[l.valle] ?? l.valle}</span>
                  {l.descrizione_breve && <p class="text-sm text-[#1E2E26]/75 m-0 mt-1">{l.descrizione_breve}</p>}
                  {l.url_articolo && <a href={l.url_articolo} class="text-sm text-[#8a6215] underline">Leggi la storia</a>}
                </li>
              ))}
              {convenzioni.map((c) => (
                <li class="bg-white border-l-4 border-[#1E2E26] px-4 py-3" data-tipo="convenzioni" data-valle="fuori_valle" data-categoria="convenzione">
                  <strong class="text-[#1E2E26]">{c.nome_attivita}</strong>
                  <span class="text-xs text-[#1E2E26]/55"> · Convenzione{c.localita ? ` · ${c.localita}` : ''}</span>
                  <p class="text-sm text-[#C8923E] font-medium m-0 mt-1" style="font-family: 'Inter', sans-serif;">{c.beneficio}</p>
                  <a href="/convenzioni" class="text-sm text-[#8a6215] underline">Vedi la convenzione</a>
                </li>
              ))}
            </ul>
            <p id="mappa-elenco-vuoto" hidden class="text-[#1E2E26]/60 text-sm m-0" style="font-family: 'Source Serif 4', Georgia, serif;">
              Nessun luogo per questa selezione: prova ad allargare il filtro.
            </p>
          </Fragment>
        )}
      </div>

      <p class="text-xs text-[#1E2E26]/50 mt-8 m-0" style="font-family: 'Inter', sans-serif;">
        Cartografia: © Provincia Autonoma di Trento · SIAT (CTP 2020, Ortofoto 2015), licenza CC BY ·
        carta storica d'impianto (1817-1855) © Provincia Autonoma di Trento, Servizio catasto, CC BY 4.0 ·
        in caso di indisponibilità del servizio provinciale: © OpenStreetMap contributors ·
        <a href="/crediti-e-licenze" class="underline">crediti e licenze</a>
      </p>
    </div>
  </section>
</Layout>

<style is:global>
  /* Badge cluster (markercluster) a sigillo: cerchio verde bosco, bordo oro. */
  .mc-cluster {
    width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center;
    background: #1E2E26; color: #D9A94E; border: 2px solid #C8923E;
    font-family: 'Inter', sans-serif; font-weight: 700; font-size: 14px;
    box-shadow: 0 2px 8px rgba(30,46,38,.35);
  }
  .marker-cluster, .marker-cluster div { background: transparent !important; }
  .leaflet-div-icon { background: transparent; border: 0; }

  /* [4/8] I PIN DEVONO STACCARSI DA QUALUNQUE SFONDO. Su ortofoto un pin
     scuro sparisce dentro un bosco e un pin chiaro sparisce dentro un prato
     secco: il bordo avorio da solo non basta. Un'ombra portata scura sotto la
     goccia la stacca da entrambi, e non cambia il colore della categoria. */
  .leaflet-marker-icon svg { filter: drop-shadow(0 1px 2px rgba(0,0,0,.55)); }
  .mc-cluster { box-shadow: 0 2px 8px rgba(0,0,0,.5); }

  /* Il pannello della carta storica. */
  .mappa-catasto {
    background: rgba(248,241,228,.96); border: 1px solid #C8923E; border-radius: 6px;
    padding: 8px 10px; max-width: 260px; font-family: 'Inter', sans-serif;
    box-shadow: 0 2px 10px rgba(30,46,38,.25);
  }
  .mappa-catasto .mc-riga { display: flex; align-items: center; gap: 8px; font-size: 12px; color: #1E2E26; }
  .mappa-catasto input[type=range] { flex: 1; accent-color: #C8923E; }
  .mappa-catasto .mc-nota { margin: 6px 0 0; font-size: 11.5px; line-height: 1.5; color: #1E2E26; }
  .mappa-catasto .mc-assente { margin: 0; color: #6b6255; }
  .mappa-catasto .mc-fuori { color: #8a6215; font-weight: 600; }
</style>

<script type="application/json" id="mappa-dati" set:html={JSON.stringify(datiMappa)} />

<script>
  // Mappa delle Valli — init SOLO su gesto (import dinamico di Leaflet).
  const BBOX_VALLI: [[number, number], [number, number]] = [[46.17, 10.48], [46.48, 11.18]];
  const WMS_BASE = 'https://siat.provincia.tn.it/geoserver/stem';
  const ATTR_PAT = 'Cartografia © <a href="https://siat.provincia.tn.it">Provincia Autonoma di Trento · SIAT</a> (CC BY)';
  const ATTR_OSM = '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors';

  import {
    COPERTURE, catastoDisponibile, coperturaPer, comuniCoperti,
    ATTRIBUZIONE_CATASTO, DATAZIONE_FONTE,
  } from '../lib/catastoStorico';

  const dati = JSON.parse(document.getElementById('mappa-dati')?.textContent ?? '{}');
  const btnCarica = document.getElementById('mappa-carica');
  const placeholder = document.getElementById('mappa-placeholder');
  const wrap = document.getElementById('mappa-wrap');

  let mappa: import('leaflet').Map | null = null;
  let markers: { tipo: string; valle: string; categoria?: string; slug?: string; m: import('leaflet').Marker }[] = [];
  let cluster: any = null;
  let filtroTipo = 'tutti';
  let filtroValle = 'tutte';
  let filtroCat = 'tutte';

  // [3/8/2026] Il luogo chiesto dal deep-link si legge UNA VOLTA, qui: piu'
  // avanti aggiornaBottoni() riscrive la querystring con i soli filtri, e
  // leggerlo dopo darebbe sempre vuoto. Era il motivo per cui ?luogo= spariva
  // dall'URL senza aprire niente.
  const LUOGO_URL = new URLSearchParams(location.search).get('luogo') ?? '';

  // stato filtri da querystring (link condivisibili)
  // Lettura dello stato dall'URL: usata al primo caricamento e a ogni popstate,
  // cosi' il deep-link e il tasto «indietro» danno la stessa vista.
  function leggiUrl() {
    const qs = new URLSearchParams(location.search);
    filtroTipo = ['luoghi', 'convenzioni'].includes(qs.get('tipo') ?? '') ? qs.get('tipo')! : 'tutti';
    filtroValle = Object.keys(dati.valli ?? {}).includes(qs.get('valle') ?? '') ? qs.get('valle')! : 'tutte';
    const cat = qs.get('categoria') ?? '';
    filtroCat = document.querySelector(`.mappa-filtro-cat[data-filtro-cat="${CSS.escape(cat)}"]`) ? cat : 'tutte';
  }
  leggiUrl();

  function aggiornaBottoni(modo: 'replace' | 'push' = 'replace') {
    document.querySelectorAll<HTMLButtonElement>('.mappa-filtro').forEach((b) => {
      const attivo = b.dataset.filtroTipo === filtroTipo;
      b.setAttribute('aria-pressed', String(attivo));
      b.classList.toggle('bg-[#1E2E26]', attivo);
      b.classList.toggle('text-[#F5EEDD]', attivo);
      b.classList.toggle('border-[#1E2E26]', attivo);
      b.classList.toggle('bg-white', !attivo);
      b.classList.toggle('text-[#1E2E26]', !attivo);
      b.classList.toggle('border-[#C8923E]/40', !attivo);
    });
    document.querySelectorAll<HTMLButtonElement>('.mappa-filtro-valle').forEach((b) => {
      const attivo = b.dataset.filtroValle === filtroValle;
      b.setAttribute('aria-pressed', String(attivo));
      b.classList.toggle('bg-[#1E2E26]', attivo);
      b.classList.toggle('text-[#F5EEDD]', attivo);
      b.classList.toggle('border-[#1E2E26]', attivo);
      b.classList.toggle('bg-white', !attivo);
      b.classList.toggle('text-[#1E2E26]', !attivo);
      b.classList.toggle('border-[#C8923E]/40', !attivo);
    });
    document.querySelectorAll<HTMLButtonElement>('.mappa-filtro-cat').forEach((b) => {
      const attivo = b.dataset.filtroCat === filtroCat;
      b.setAttribute('aria-pressed', String(attivo));
      b.classList.toggle('bg-[#1E2E26]', attivo);
      b.classList.toggle('text-[#F5EEDD]', attivo);
      b.classList.toggle('border-[#1E2E26]', attivo);
      b.classList.toggle('bg-white', !attivo);
      b.classList.toggle('text-[#1E2E26]', !attivo);
      b.classList.toggle('border-[#C8923E]/40', !attivo);
    });
    const p = new URLSearchParams();
    if (filtroTipo !== 'tutti') p.set('tipo', filtroTipo);
    if (filtroValle !== 'tutte') p.set('valle', filtroValle);
    if (filtroCat !== 'tutte') p.set('categoria', filtroCat);
    // Il luogo del deep-link resta nell'indirizzo: chi condivide il link che
    // ha ricevuto deve condividere la stessa vista, non la mappa generica.
    if (LUOGO_URL) p.set('luogo', LUOGO_URL);
    const url = p.toString() ? `?${p}` : location.pathname;
    // push sul click (il tasto «indietro» torna al filtro precedente),
    // replace all'avvio per non sporcare la cronologia.
    if (modo === 'push') history.pushState(null, '', url);
    else history.replaceState(null, '', url);
  }

  // UNICO predicato: lo stesso record decide se il marker sta nel cluster e se
  // la card resta visibile. Prima l'elenco ignorava i filtri e mostrava tutte
  // le valli anche con ?valle=val_di_non.
  function passa(tipo: string, valle: string, categoria?: string) {
    const okTipo = filtroTipo === 'tutti' || tipo === filtroTipo;
    // Le convenzioni non hanno una valle affidabile: restano fuori dal vincolo.
    const okValle = filtroValle === 'tutte' || valle === filtroValle || tipo === 'convenzioni';
    const okCat = filtroCat === 'tutte' || tipo === 'convenzioni' || categoria === filtroCat;
    return okTipo && okValle && okCat;
  }

  function applicaFiltri() {
    if (cluster) {
      for (const { tipo, valle, categoria, m } of markers) {
        if (passa(tipo, valle, categoria)) { if (!cluster.hasLayer(m)) cluster.addLayer(m); }
        else if (cluster.hasLayer(m)) cluster.removeLayer(m);
      }
    }
    // L'elenco si filtra anche a mappa non ancora caricata (init su gesto).
    let visibili = 0;
    document.querySelectorAll<HTMLLIElement>('#mappa-elenco > li').forEach((li) => {
      const ok = passa(li.dataset.tipo ?? '', li.dataset.valle ?? '', li.dataset.categoria);
      li.hidden = !ok;
      if (ok) visibili++;
    });
    const vuoto = document.getElementById('mappa-elenco-vuoto');
    const elenco = document.getElementById('mappa-elenco');
    if (vuoto) vuoto.hidden = visibili > 0;
    if (elenco) elenco.hidden = visibili === 0;
    const conteggio = document.getElementById('mappa-elenco-conteggio');
    if (conteggio) conteggio.textContent = visibili > 0 ? ` (${visibili})` : '';
  }

  document.querySelectorAll<HTMLButtonElement>('.mappa-filtro').forEach((b) =>
    b.addEventListener('click', () => { filtroTipo = b.dataset.filtroTipo!; aggiornaBottoni('push'); applicaFiltri(); }));
  document.querySelectorAll<HTMLButtonElement>('.mappa-filtro-valle').forEach((b) =>
    b.addEventListener('click', () => { filtroValle = b.dataset.filtroValle!; aggiornaBottoni('push'); applicaFiltri(); }));
  document.querySelectorAll<HTMLButtonElement>('.mappa-filtro-cat').forEach((b) =>
    b.addEventListener('click', () => { filtroCat = b.dataset.filtroCat!; aggiornaBottoni('push'); applicaFiltri(); }));
  window.addEventListener('popstate', () => { leggiUrl(); aggiornaBottoni(); applicaFiltri(); });
  aggiornaBottoni();
  applicaFiltri();

  /**
   * IL PANNELLO DEL CATASTO: trasparenza, avviso di copertura, attribuzione.
   *
   * [4/8/2026] Tre comportamenti, e il terzo e' quello che conta.
   *
   *  - se il livello NON esiste ancora, il pannello lo dice e spiega perche',
   *    invece di lasciare un interruttore morto o un riquadro vuoto;
   *  - se esiste ed e' acceso, compare il cursore della trasparenza, perche'
   *    il valore vero non e' vedere l'ottocento, e' vederlo SOPRA l'oggi;
   *  - se esiste ma ci si sposta FUORI dall'area coperta, lo dice: «per questa
   *    zona la carta storica non c'e' ancora». Senza quella riga, un'area
   *    bianca sembra un guasto del sito invece che un limite dei dati.
   */
  function montaPannelloCatasto(L: any, catasto: any) {
    const Pannello = L.Control.extend({
      options: { position: 'bottomleft' },
      onAdd() {
        const box = L.DomUtil.create('div', 'mappa-catasto');
        L.DomEvent.disableClickPropagation(box);
        box.innerHTML = catasto
          ? `<label class="mc-riga"><span>Carta storica</span>
               <input type="range" id="mc-opacita" min="20" max="100" value="70" step="5" aria-label="Trasparenza della carta storica" />
             </label>
             <p class="mc-nota" id="mc-copertura"></p>`
          : `<p class="mc-nota mc-assente"><strong>Carta storica: non ancora disponibile.</strong>
               Il catasto asburgico d&rsquo;impianto (${DATAZIONE_FONTE}) &egrave; pubblicato dalla
               Provincia con licenza aperta, ma il servizio di scaricamento non &egrave; pi&ugrave;
               raggiungibile e i fogli non sono ancora nostri. Appena ci saranno, comparir&agrave; qui.</p>`;
        return box;
      },
    });
    const pannello = new Pannello();
    pannello.addTo(mappa!);

    if (!catasto) return;

    const box = document.querySelector('.mappa-catasto') as HTMLElement;
    const cursore = document.getElementById('mc-opacita') as HTMLInputElement | null;
    const nota = document.getElementById('mc-copertura');

    // Il cursore e la nota servono solo a livello acceso: a livello spento
    // sarebbero due comandi che non comandano niente.
    const aggiorna = () => {
      const acceso = mappa!.hasLayer(catasto);
      box.style.display = acceso ? 'block' : 'none';
      if (!acceso || !nota) return;
      const c = mappa!.getCenter();
      const dentro = coperturaPer(c.lat, c.lng);
      nota.innerHTML = dentro
        ? `Comune catastale di <strong>${dentro.comuneCatastale}</strong>, rilievo ${dentro.rilievo}.`
        : `<span class="mc-fuori">Per questa zona la carta storica non c&rsquo;&egrave; ancora.</span>
           Coperti finora: ${comuniCoperti().join(', ')}.`;
    };

    cursore?.addEventListener('input', () => catasto.setOpacity(Number(cursore.value) / 100));
    mappa!.on('overlayadd overlayremove', aggiorna);
    mappa!.on('moveend zoomend', aggiorna);
    aggiorna();
  }

  function goccia(colori: { corpo: string; bordo: string }) {
    return `<svg viewBox="0 0 32 44" width="32" height="44" xmlns="http://www.w3.org/2000/svg"><path d="M16 1C8 1 1.5 7.5 1.5 15.5 1.5 26 16 43 16 43s14.5-17 14.5-27.5C30.5 7.5 24 1 16 1z" fill="${colori.corpo}" stroke="${colori.bordo}" stroke-width="2"/><circle cx="16" cy="15.5" r="5.5" fill="${colori.bordo}"/></svg>`;
  }

  // Carica Leaflet SELF-HOSTED (zero CDN, zero bundler): due file statici a
  // path fisso serviti da Netlify. Sostituisce il doppio import dinamico
  // (JS+CSS) che non si risolveva a runtime sulla pagina SSR (post mortem 12/7).
  function caricaLeaflet(): Promise<any> {
    if ((window as any).L?.markerClusterGroup) return Promise.resolve((window as any).L);
    const css: [string, string][] = [
      ['leaflet-css', '/leaflet/leaflet.css'],
      ['mc-css', '/leaflet/MarkerCluster.css'],
      ['mc-def-css', '/leaflet/MarkerCluster.Default.css'],
    ];
    for (const [id, href] of css) {
      if (!document.getElementById(id)) {
        const link = document.createElement('link');
        link.id = id; link.rel = 'stylesheet'; link.href = href;
        document.head.appendChild(link);
      }
    }
    const caricaScript = (src: string) => new Promise<void>((res, rej) => {
      const s = document.createElement('script');
      s.src = src; s.onload = () => res(); s.onerror = () => rej(new Error(src));
      document.head.appendChild(s);
    });
    return (async () => {
      if (!(window as any).L) await caricaScript('/leaflet/leaflet.js');
      if (!(window as any).L?.markerClusterGroup) await caricaScript('/leaflet/leaflet.markercluster.js');
      if (!(window as any).L?.markerClusterGroup) throw new Error('markercluster non caricato');
      return (window as any).L;
    })();
  }

  async function initMappa() {
    const L = await caricaLeaflet();

    placeholder?.classList.add('hidden');
    wrap?.classList.remove('hidden');

    mappa = L.map('mappa', {
      minZoom: 9,
      maxZoom: 17,
      scrollWheelZoom: false, // anti scroll-jacking: si attiva al click
      maxBounds: [[45.95, 10.2], [46.7, 11.45]],
    });
    mappa.fitBounds(BBOX_VALLI);
    mappa.on('click focus', () => mappa!.scrollWheelZoom.enable());

    // base PAT con fallback OSM: probe leggero con timeout
    let basiOk = false;
    try {
      const probe = await fetch(`${WMS_BASE}/ctp2020_bn_00/wms?SERVICE=WMS&REQUEST=GetCapabilities`, {
        method: 'HEAD', signal: AbortSignal.timeout(4000), mode: 'no-cors',
      });
      basiOk = true; void probe;
    } catch { basiOk = false; }

    // [4/8/2026] SELETTORE DI SFONDO A QUATTRO VOCI.
    //
    // La mappa standard smette di essere solo un ripiego e diventa una scelta:
    // su una carta tecnica in bianco e nero certi luoghi si leggono meglio,
    // sull'ortofoto altri. Il catasto d'impianto non e' uno sfondo alternativo
    // ma una SOVRAPPOSIZIONE con trasparenza, perche' il valore vero e' il
    // confronto: l'ottocento in trasparenza sull'oggi.
    const osm = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 17, attribution: ATTR_OSM,
    });

    const sfondi: Record<string, any> = { 'Mappa standard': osm };
    let sfondoIniziale = osm;

    if (basiOk) {
      const ctp = L.tileLayer.wms(`${WMS_BASE}/ctp2020_bn_00/wms`, {
        layers: 'ctp2020_bn_00', format: 'image/png', version: '1.3.0', attribution: ATTR_PAT,
      });
      const orto = L.tileLayer.wms(`${WMS_BASE}/ecw-rgb-2015/wms`, {
        layers: 'ecw-rgb-2015', format: 'image/jpeg', version: '1.3.0', attribution: ATTR_PAT,
      });
      sfondi['Carta tecnica'] = ctp;
      sfondi['Ortofoto'] = orto;
      sfondoIniziale = ctp;
    }
    sfondoIniziale.addTo(mappa);

    // --- LO SLOT DEL CATASTO D'IMPIANTO ---
    //
    // Il livello NON e' mai predefinito: chi arriva deve prima capire dove si
    // trova oggi. E finche' non ci sono coperture non si mette un riquadro
    // vuoto in mappa: si dice che per quella zona la carta storica non c'e'
    // ancora. Un'assenza spiegata e' informazione, una muta sembra un guasto.
    let catasto: any = null;
    if (catastoDisponibile()) {
      const c = COPERTURE[0];
      catasto = L.tileLayer(c.urlRiquadri, {
        minZoom: c.zoomMin, maxZoom: c.zoomMax,
        bounds: L.latLngBounds(c.confini),
        opacity: 0.7,
        attribution: ATTRIBUZIONE_CATASTO,
      });
    }

    const sovrapposti: Record<string, any> = {};
    if (catasto) sovrapposti[`Catasto d'impianto (${DATAZIONE_FONTE})`] = catasto;
    L.control.layers(sfondi, sovrapposti, { position: 'topright', collapsed: false }).addTo(mappa);

    montaPannelloCatasto(L, catasto);

    // Clustering: con 34+ punti la Val di Non diventa un grumo illeggibile. I
    // marker filtrati (valle/tipo) entrano/escono dal cluster in applicaFiltri().
    cluster = L.markerClusterGroup({
      showCoverageOnHover: false, maxClusterRadius: 46, spiderfyOnMaxZoom: true, chunkedLoading: true,
      iconCreateFunction: (c: any) => L.divIcon({ html: `<div class="mc-cluster">${c.getChildCount()}</div>`, className: '', iconSize: [40, 40] }),
    });
    cluster.addTo(mappa);

    // [4/8] IL GRUPPO CHE NON SI SEPARA PIU'. A zoom massimo due luoghi a
    // pochi metri restano insieme: cliccare all'infinito senza che si aprano
    // e' il modo di far credere che la mappa sia rotta. Qui il gruppo dice
    // CHI contiene, e da quell'elenco si arriva al luogo.
    cluster.on('clusterclick', (e: any) => {
      const gruppo = e.layer;
      if (mappa!.getZoom() < mappa!.getMaxZoom()) return;   // sotto il massimo si apre da solo
      const figli = gruppo.getAllChildMarkers();
      const voci = figli.map((m: any) => {
        const nome = m.options?.title ?? m.getPopup?.()?.getContent?.() ?? 'luogo';
        const testo = String(nome).replace(/<[^>]+>/g, ' ').trim().split(/\s{2,}/)[0];
        return `<li style="margin:0 0 4px;">${testo}</li>`;
      }).join('');
      L.popup({ maxWidth: 260 })
        .setLatLng(gruppo.getLatLng())
        .setContent(`<p style="margin:0 0 6px;font-weight:600;">${figli.length} luoghi qui</p>
                     <ul style="margin:0;padding-left:18px;font-size:13px;">${voci}</ul>`)
        .openOn(mappa!);
      e.originalEvent?.preventDefault?.();
    });

    // Pin colorato "a sigillo" per categoria (bordo avorio; fallback oro).
    const iconaLuogoCat = (cat: string) => L.divIcon({
      html: goccia({ corpo: dati.colori?.[cat] ?? '#C8923E', bordo: '#F5EEDD' }),
      className: '', iconSize: [32, 44], iconAnchor: [16, 43], popupAnchor: [0, -40],
    });
    const iconaConv = L.divIcon({
      html: goccia({ corpo: '#1E2E26', bordo: '#C8923E' }),
      className: '', iconSize: [32, 44], iconAnchor: [16, 43], popupAnchor: [0, -40],
    });

    for (const l of dati.luoghi ?? []) {
      const m = L.marker([l.lat, l.lng], { icon: iconaLuogoCat(l.categoria), title: l.nome, alt: l.nome });
      m.bindPopup(`
        <div style="font-family:'Source Serif 4',Georgia,serif;min-width:200px;max-width:250px;">
          <p style="font-family:'Playfair Display',serif;font-size:17px;color:#1E2E26;margin:0 0 4px;">${l.nome}</p>
          <span style="font-family:'Inter',sans-serif;font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:#8a6215;background:rgba(200,146,62,.15);border-radius:999px;padding:2px 10px;">${dati.categorie?.[l.categoria] ?? l.categoria}</span>
          ${l.descrizione_breve ? `<p style="font-size:13px;color:rgba(30,46,38,.8);margin:8px 0 0;">${l.descrizione_breve}</p>` : ''}
          ${l.slug ? `<p style="margin:8px 0 0;"><a href="/luoghi/${l.slug}" style="color:#8a6215;font-weight:600;">Scheda del luogo →</a></p>` : ''}
          ${l.url_articolo ? `<p style="margin:6px 0 0;"><a href="${l.url_articolo}" style="color:#8a6215;">Leggi la storia →</a></p>` : ''}
        </div>`);
      markers.push({ tipo: 'luoghi', valle: l.valle, categoria: l.categoria, slug: l.slug, m });
    }
    for (const c of dati.convenzioni ?? []) {
      // Multi-punto: un marker per ogni sede pubblicata; se non ci sono punti
      // figli, un solo marker sul lat/lng della convenzione (fallback).
      const sedi = (c.punti && c.punti.length)
        ? c.punti
        : [{ nome_punto: null, lat: c.lat, lng: c.lng }];
      for (const s of sedi) {
        if (typeof s.lat !== 'number' || typeof s.lng !== 'number') continue;
        const titolo = s.nome_punto ? `${c.nome_attivita} · ${s.nome_punto}` : c.nome_attivita;
        const m = L.marker([s.lat, s.lng], { icon: iconaConv, title: titolo, alt: titolo });
        m.bindPopup(`
          <div style="font-family:'Source Serif 4',Georgia,serif;min-width:200px;max-width:250px;">
            <p style="font-family:'Playfair Display',serif;font-size:17px;color:#1E2E26;margin:0 0 4px;">${c.nome_attivita}</p>
            ${s.nome_punto ? `<p style="font-family:'Inter',sans-serif;font-size:12px;color:#1E2E26;margin:0 0 4px;">${s.nome_punto}</p>` : ''}
            <span style="font-family:'Inter',sans-serif;font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:#F5EEDD;background:#1E2E26;border-radius:999px;padding:2px 10px;">Convenzione soci</span>
            <p style="font-size:13px;color:#8a6215;font-weight:600;margin:8px 0 0;">${c.beneficio}</p>
            <p style="margin:8px 0 0;"><a href="/convenzioni" style="color:#8a6215;">Vedi la convenzione →</a></p>
          </div>`);
        markers.push({ tipo: 'convenzioni', valle: '', m });
      }
    }
    applicaFiltri();
    apriLuogoDaUrl();
  }

  // [3/8/2026] Deep-link `?luogo=<slug>`: e' la destinazione delle schede
  // della vetrina in home, e senza questo ci arriverebbero su una mappa
  // indistinguibile da /mappa. Qui il luogo si apre gia': la mappa si centra
  // su di lui e il suo fumetto e' aperto. Se lo slug non esiste (luogo
  // spubblicato, link vecchio) non succede niente di male: resta la mappa
  // intera, che e' comunque una pagina utile.
  function apriLuogoDaUrl() {
    const slug = LUOGO_URL;
    if (!slug || !mappa || !cluster) return;
    const voce = markers.find((x) => x.slug === slug);
    if (!voce) return;
    const apri = () => { mappa!.setView(voce.m.getLatLng(), 14); voce.m.openPopup(); };
    // Il marker vive dentro il cluster: se e' raggruppato va prima srotolato,
    // altrimenti openPopup() parla a un elemento che non e' in pagina.
    if (typeof cluster.zoomToShowLayer === 'function') cluster.zoomToShowLayer(voce.m, apri);
    else apri();
    // L'elenco a fianco si allinea: chi arriva dalla home ritrova la scheda
    // da cui ha cliccato, non deve ricercarla.
    const li = document.querySelector<HTMLLIElement>(`#mappa-elenco > li[data-slug="${CSS.escape(slug)}"]`);
    if (li) li.classList.add('bg-[#FDF9F0]');
    // Si porta in vista la MAPPA, non la voce dell'elenco: chi ha cliccato la
    // scheda in home vuole vedere dov'e' il luogo, e una scrollIntoView sulla
    // voce lo scaricava molto piu' in basso, oltre la mappa appena aperta.
    document.getElementById('mappa-wrap')?.scrollIntoView({ block: 'center', behavior: 'smooth' });
  }

  // Il caricamento su gesto resta la regola (nessun tile senza volerlo), ma
  // chi arriva con ?luogo= il gesto lo ha gia' fatto: cliccare la scheda.
  if (LUOGO_URL) {
    initMappa().catch((e) => console.error('[mappa] init da deep-link fallita:', e));
  }

  btnCarica?.addEventListener('click', () => {
    btnCarica.textContent = 'Carico…';
    initMappa().catch((e) => {
      console.error('[mappa] init fallita:', e);
      btnCarica.textContent = 'Riprova a caricare la mappa';
      const box = document.getElementById('mappa-placeholder');
      if (box && !document.getElementById('mappa-errore')) {
        const p = document.createElement('p');
        p.id = 'mappa-errore';
        p.style.cssText = 'color:#a33;font-size:12px;margin-top:12px;text-align:center;';
        p.textContent = 'Dettaglio errore: ' + (e?.message ?? String(e));
        box.appendChild(p);
      }
    });
  });
</script>
