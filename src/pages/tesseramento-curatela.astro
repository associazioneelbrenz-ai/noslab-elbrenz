---
/**
 * /tesseramento-curatela — il pannello del segretario: tutte le domande in un
 * posto solo, con lo stato della quota accanto a ciascuna.
 *
 * [4/8/2026] Perche' esiste. Finora alle domande ci si arrivava SOLO dai
 * collegamenti nelle email di notifica. Se una mail finiva nello spam o veniva
 * archiviata per sbaglio, quella domanda spariva dai radar: a luglio tre sono
 * rimaste ferme sei giorni cosi'. E non esisteva nessun posto dove vedere,
 * insieme, chi ha pagato e chi no: quella mancanza il 21 luglio e il 3 agosto
 * e' costata due tessere emesse senza quota.
 *
 * Accesso: sessione OTP + livello di ruolo >= 50, verificato LATO SERVER
 * dall'edge (ramo /json/coda). Non si legge da RLS perche' le policy di
 * domande_tesseramento pretendono aal2, che la sessione OTP non ha: passare
 * dall'edge con un gate esplicito e' piu' onesto che abbassare le policy.
 *
 * Le AZIONI non stanno qui: ogni riga porta al suo /scheda-domanda/vista/...
 * con il token firmato, che e' la strada gia' collaudata. Questo e' un indice,
 * non un secondo pannello di comando: due posti da cui approvare sono due
 * posti da tenere allineati.
 */
import Layout from '../layouts/Layout.astro';

export const prerender = false;

const SB_URL = import.meta.env.PUBLIC_SUPABASE_URL || 'https://wacknihvdjxltiqvxtqr.supabase.co';
const CODA_URL = `${SB_URL}/functions/v1/scheda-domanda/json/coda`;
const inputCls = 'w-full border-2 border-[#E5DFCF] bg-white px-4 py-2.5 text-[#1E2E26] rounded focus:outline-none focus:border-[#C8923E]';
---

<Layout title="Curatela tesseramento · El Brenz" description="Coda delle domande di tesseramento, riservata al Direttivo." ogImage="/og/og-default.jpg" noindex={true}>
  <main class="bg-[#F8F1E4] min-h-screen" data-coda-url={CODA_URL} id="tc-root">
    <div class="max-w-5xl mx-auto px-6 py-12 md:py-16" style="font-family: 'Inter', sans-serif;">
      <p class="text-[11px] tracking-[0.22em] uppercase text-[#8a6215] font-semibold m-0 mb-2">Area riservata · Direttivo</p>
      <h1 class="text-3xl md:text-4xl text-[#1E2E26] m-0 mb-8" style="font-family: 'Playfair Display', serif; font-weight: 500;">Curatela · Tesseramento</h1>

      <p id="tc-loading" class="text-[#1E2E26]/60">Carico…</p>

      {/* LOGIN */}
      <section id="tc-login" class="hidden bg-white border border-[#E5DFCF] rounded p-6 md:p-8 max-w-md">
        <div id="tc-login-1">
          <p class="text-sm text-[#1E2E26]/70 m-0 mb-4">Accedi con la tua email: ti invieremo un codice di verifica.</p>
          <label class="block text-sm text-[#1E2E26]/75 mb-1" for="tc-email">Email</label>
          <input class={inputCls} type="email" id="tc-email" autocomplete="email" placeholder="nome@esempio.it" />
          <button type="button" id="tc-send" class="mt-4 w-full bg-[#1E2E26] text-[#F5EEDD] py-3 rounded font-medium hover:bg-[#2a3f34] transition-colors">Invia codice</button>
        </div>
        <div id="tc-login-2" class="hidden">
          <p class="text-sm text-[#1E2E26]/70 m-0 mb-4">Inserisci il codice a 6 cifre inviato a <strong id="tc-email-echo"></strong>.</p>
          <input class={`${inputCls} tracking-[0.4em] text-center text-xl`} type="text" id="tc-code" inputmode="numeric" maxlength="6" placeholder="000000" />
          <button type="button" id="tc-verify" class="mt-4 w-full bg-[#C8923E] text-[#1E2E26] py-3 rounded font-semibold hover:bg-[#D9A94E] transition-colors">Verifica e accedi</button>
          <button type="button" id="tc-back" class="mt-2 w-full text-sm text-[#8a6215] underline bg-transparent border-0 cursor-pointer">Cambia email</button>
        </div>
        <div id="tc-login-err" class="hidden mt-3 text-sm rounded px-3 py-2" style="background:#fbecec;color:#1E2E26;"></div>
      </section>

      {/* NO ACCESS */}
      <section id="tc-noaccess" class="hidden bg-white border border-[#E5DFCF] rounded p-6 max-w-md">
        <p class="m-0 text-[#1E2E26]/80">Questa area è riservata al direttivo (segretario o amministratore). Se pensi di dover avere accesso, chiedilo al segretario.</p>
        <button type="button" id="tc-logout-2" class="mt-4 text-sm text-[#8a6215] underline bg-transparent border-0 cursor-pointer">Esci</button>
      </section>

      {/* PANNELLO */}
      <section id="tc-app" class="hidden">
        <div class="flex items-center justify-between mb-6">
          <p class="text-sm text-[#1E2E26]/70 m-0">Ciao <strong id="tc-utente"></strong></p>
          <button type="button" id="tc-logout" class="text-sm text-[#8a6215] underline bg-transparent border-0 cursor-pointer">Esci</button>
        </div>

        {/* I numeri che contano, letti dai dati e mai scritti a mano */}
        <div id="tc-riepilogo" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 mb-2"></div>
        <p id="tc-nota-manca" class="text-[13px] text-[#1E2E26]/65 m-0 mb-8"></p>

        <div class="flex flex-wrap items-center gap-2 mb-4">
          <button type="button" data-filtro="da_lavorare" class="tc-filtro bg-[#1E2E26] text-[#F5EEDD] border border-[#1E2E26] rounded-full px-4 py-1.5 text-[13px] cursor-pointer">Da lavorare</button>
          <button type="button" data-filtro="senza_incasso" class="tc-filtro bg-white text-[#1E2E26] border border-[#C8923E]/40 rounded-full px-4 py-1.5 text-[13px] cursor-pointer">Ammessi senza incasso</button>
          <button type="button" data-filtro="parziale" class="tc-filtro bg-white text-[#1E2E26] border border-[#C8923E]/40 rounded-full px-4 py-1.5 text-[13px] cursor-pointer">Parziali</button>
          <button type="button" data-filtro="da_regolarizzare" class="tc-filtro bg-white text-[#1E2E26] border border-[#C8923E]/40 rounded-full px-4 py-1.5 text-[13px] cursor-pointer">Da regolarizzare</button>
          <button type="button" data-filtro="in_regola" class="tc-filtro bg-white text-[#1E2E26] border border-[#C8923E]/40 rounded-full px-4 py-1.5 text-[13px] cursor-pointer">In regola</button>
          <button type="button" data-filtro="tutte" class="tc-filtro bg-white text-[#1E2E26] border border-[#C8923E]/40 rounded-full px-4 py-1.5 text-[13px] cursor-pointer">Tutte</button>
          <input id="tc-cerca" type="search" placeholder="Cerca nome o email…" class="ml-auto border border-[#E5DFCF] bg-white rounded px-3 py-1.5 text-[13px] text-[#1E2E26] focus:outline-none focus:border-[#C8923E]" />
        </div>

        <div id="tc-lista" class="grid gap-3"></div>

        {/* MODULO: registrare un incasso gia' avvenuto fuori dal sistema.
            Chiede il minimo indispensabile e niente di piu': importo, data
            reale, mezzo, e una nota. La casella «data ricostruita» esiste
            perche' chi registra una quota raccolta due anni fa non si ricorda
            il giorno, e va bene: basta che lo dica. Una data ricostruita
            dichiarata e' un dato onesto, una inventata e taciuta e' un falso. */}
        <div id="tc-reg" class="hidden fixed inset-0 z-50 bg-[#1E2E26]/60 overflow-y-auto p-4 md:p-8">
          <div class="bg-white rounded-lg border-t-4 border-[#C8923E] max-w-lg mx-auto p-6 md:p-8">
            <div class="flex items-start justify-between gap-4 mb-1">
              <h3 class="text-xl text-[#1E2E26] m-0" style="font-family: 'Playfair Display', serif;">Registra un incasso già avvenuto</h3>
              <button type="button" id="tc-reg-chiudi" class="text-[#1E2E26]/50 bg-transparent border-0 text-2xl leading-none cursor-pointer" aria-label="Chiudi">&times;</button>
            </div>
            <p id="tc-reg-chi" class="text-[13px] text-[#1E2E26]/65 m-0 mb-5"></p>

            <div class="grid gap-4">
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-sm text-[#1E2E26]/75 mb-1" for="tc-reg-importo">Importo in euro <span class="text-[#a33]">*</span></label>
                  <input class={inputCls} type="number" id="tc-reg-importo" min="0.01" max="1000" step="0.01" placeholder="10.00" />
                </div>
                <div>
                  <label class="block text-sm text-[#1E2E26]/75 mb-1" for="tc-reg-tipo">Cosa</label>
                  <select class={inputCls} id="tc-reg-tipo">
                    <option value="quota">Quota sociale</option>
                    <option value="integrazione">Integrazione</option>
                  </select>
                </div>
              </div>

              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-sm text-[#1E2E26]/75 mb-1" for="tc-reg-data">Data dell'incasso <span class="text-[#a33]">*</span></label>
                  <input class={inputCls} type="date" id="tc-reg-data" />
                </div>
                <div>
                  <label class="block text-sm text-[#1E2E26]/75 mb-1" for="tc-reg-metodo">Come è arrivata</label>
                  <select class={inputCls} id="tc-reg-metodo">
                    <option value="contanti">Contanti</option>
                    <option value="bonifico">Bonifico</option>
                    <option value="altro">Altro</option>
                  </select>
                </div>
              </div>

              <label class="flex items-start gap-2 text-sm text-[#1E2E26]/85 cursor-pointer">
                <input type="checkbox" id="tc-reg-ricostruita" class="mt-1 w-4 h-4 accent-[#C8923E]" />
                <span>La data è <strong>ricostruita</strong>, non esatta. Spuntala se ricordi il periodo ma non il giorno: resta scritto che è una ricostruzione.</span>
              </label>

              <div>
                <label class="block text-sm text-[#1E2E26]/75 mb-1" for="tc-reg-incassante">Chi ha materialmente incassato <span class="text-[#a33]">*</span></label>
                <select class={inputCls} id="tc-reg-incassante"></select>
              </div>

              <div>
                <label class="block text-sm text-[#1E2E26]/75 mb-1" for="tc-reg-note">Nota</label>
                <textarea class={inputCls} id="tc-reg-note" rows="2" maxlength="500" placeholder="es. quota raccolta alla serata del 12 luglio, registro cartaceo pagina 4"></textarea>
              </div>

              <label class="flex items-start gap-2 text-sm text-[#1E2E26]/85 cursor-pointer">
                <input type="checkbox" id="tc-reg-attestazione" class="mt-1 w-4 h-4 accent-[#C8923E]" />
                <span>Attesto che questo versamento è stato ricevuto davvero e che i dati qui sopra sono quelli reali. <span class="text-[#a33]">*</span></span>
              </label>

              <div id="tc-reg-esito" class="hidden rounded px-4 py-3 text-sm"></div>

              <div class="flex flex-wrap gap-3 items-center">
                <button type="button" id="tc-reg-salva" class="bg-[#C8923E] text-[#1E2E26] px-6 py-3 rounded font-semibold text-sm cursor-pointer border-0 hover:bg-[#D9A94E] transition-colors">Registra l'incasso</button>
                <span class="text-[12px] text-[#1E2E26]/55">Resta scritto chi lo ha registrato e quando. Dopo non si modifica: si annulla con un motivo.</span>
              </div>
            </div>
          </div>
        </div>
        <p id="tc-vuoto" class="hidden text-[#1E2E26]/60 bg-white border border-[#E5DFCF] rounded p-6 text-center m-0">Niente in questa selezione.</p>

        {/* CASSA — da v_incassi, che tiene insieme quote, integrazioni e
            anticipi delle gite senza duplicare una riga. */}
        <div class="mt-12 pt-8 border-t border-[#E5DFCF]">
          <div class="flex items-baseline justify-between mb-1">
            <h2 class="text-xl text-[#1E2E26] m-0" style="font-family: 'Playfair Display', serif;">Cassa</h2>
            <button type="button" id="tc-cassa-toggle" class="text-[13px] text-[#8a6215] underline bg-transparent border-0 cursor-pointer">Mostra il dettaglio</button>
          </div>
          <p class="text-[13px] text-[#1E2E26]/55 m-0 mb-4">Ogni incasso una volta sola: le quote e le integrazioni dal tesseramento, gli anticipi dalle iscrizioni alle gite.</p>
          <div id="tc-cassa" class="grid gap-3"></div>
          <div id="tc-cassa-dettaglio" class="hidden mt-4 overflow-x-auto"></div>
        </div>
      </section>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabase';
  import { proteggiCuratela2fa } from '../lib/curatela2fa';

  const $ = (id: string) => document.getElementById(id);
  const show = (id: string) => $(id)?.classList.remove('hidden');
  const hide = (id: string) => $(id)?.classList.add('hidden');
  const val = (id: string) => ($(id) as HTMLInputElement)?.value ?? '';
  const esc = (s: unknown) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  const dataIt = (s: string | null) => { if (!s) return '—'; try { return new Date(s).toLocaleDateString('it-IT', { timeZone: 'Europe/Rome' }); } catch { return s; } };
  const giorniDa = (s: string | null) => { if (!s) return 0; return Math.floor((Date.now() - new Date(s).getTime()) / 86400000); };

  const CODA_URL = $('tc-root')!.getAttribute('data-coda-url')!;
  let righe: any[] = [];
  let filtro = 'da_lavorare';

  /* Le etichette sono quelle di v_soci_in_regola, una per una: se la vista un
     domani aggiunge una posizione, qui manca l'etichetta e si vede subito,
     invece di ritrovarsi tutto ammucchiato sotto un fallback che mente. */
  const POSIZIONE: Record<string, { testo: string; sfondo: string; colore: string }> = {
    in_regola: { testo: 'In regola', sfondo: '#eaf3ee', colore: '#2d8659' },
    parziale: { testo: 'Parziale', sfondo: '#fdf3df', colore: '#8a6215' },
    in_regola_per_deroga: { testo: 'In deroga', sfondo: '#FDF9F0', colore: '#8a6215' },
    da_regolarizzare: { testo: 'Da regolarizzare', sfondo: '#eef2f7', colore: '#4a6180' },
    ammesso_senza_incasso: { testo: 'Ammesso senza incasso', sfondo: '#fbecec', colore: '#a33' },
    account_di_sistema: { testo: 'Account di servizio', sfondo: '#f1f1f1', colore: '#666' },
    in_coda: { testo: 'In coda', sfondo: '#fdf3df', colore: '#8a6215' },
    respinta: { testo: 'Respinta', sfondo: '#fbecec', colore: '#a33' },
    annullata: { testo: 'Annullata', sfondo: '#f1f1f1', colore: '#666' },
  };
  let incassi: any[] = [];
  let incassanti: any[] = [];
  let io = '';
  let socioCorrente: any = null;
  const REGISTRA_URL = 'https://wacknihvdjxltiqvxtqr.supabase.co/functions/v1/contanti-registra';

  async function init() {
    const { data: { session } } = await supabase.auth.getSession();
    hide('tc-loading');
    if (!session) { show('tc-login'); return; }
    if (!(await proteggiCuratela2fa())) { window.location.reload(); return; }

    const r = await fetch(CODA_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${session.access_token}` },
      body: '{}',
    });
    const d = await r.json();
    // Il "non autorizzato" lo decide il server, non questa pagina: nascondere
    // un pannello lato client non protegge niente.
    if (!d.ok) { show(d.error === 'non_autorizzato' ? 'tc-noaccess' : 'tc-login'); return; }

    righe = d.righe ?? [];
    incassi = d.incassi ?? [];
    incassanti = d.incassanti ?? [];
    io = d.io ?? '';
    ($('tc-utente') as HTMLElement).textContent = session.user.user_metadata?.nome || session.user.email || '';
    show('tc-app');
    riepilogo();
    render();
    renderCassa();
  }

  function riepilogo() {
    const conta = (p: string) => righe.filter((x) => x.posizione === p).length;
    const daLavorare = righe.filter((x) => x.stato === 'in_attesa').length;
    const senzaIncasso = conta('ammesso_senza_incasso');
    const parziali = conta('parziale');
    const daRegolarizzare = conta('da_regolarizzare');
    const mancaInTutto = righe
      .filter((x) => x.posizione === 'parziale')
      .reduce((t, x) => t + Number(x.manca || 0), 0);
    /* L'incassato viene da v_incassi, non dalla somma delle righe socio: le
       due cose sarebbero quasi uguali e la differenza, gli anticipi delle
       gite, e' proprio quella che si vuole vedere. */
    const incassato = incassi
      .filter((x) => x.stato === 'completato')
      .reduce((t, x) => t + Number(x.importo || 0), 0);
    const card = (n: string | number, testo: string, colore: string) =>
      `<div class="bg-white border border-[#E5DFCF] rounded p-4">
         <p class="text-2xl m-0" style="font-family:'Playfair Display',serif;color:${colore};">${esc(n)}</p>
         <p class="text-[12px] text-[#1E2E26]/60 m-0 mt-1">${esc(testo)}</p>
       </div>`;
    /* Le cinque posizioni che indicano un'azione diversa, piu' la coda. I
       numeri arrivano dalla vista: qui si contano righe, non si decide niente. */
    $('tc-riepilogo')!.innerHTML =
      card(daLavorare, 'in coda', daLavorare > 0 ? '#8a6215' : '#1E2E26')
      + card(conta('in_regola'), 'in regola', '#2d8659')
      + card(parziali, parziali === 1 ? 'parziale' : 'parziali', parziali > 0 ? '#8a6215' : '#1E2E26')
      + card(daRegolarizzare, 'da regolarizzare', daRegolarizzare > 0 ? '#4a6180' : '#1E2E26')
      + card(senzaIncasso, 'ammessi senza incasso', senzaIncasso > 0 ? '#a33' : '#1E2E26')
      + card(`${incassato.toFixed(0)} €`, 'incassato in tutto', '#1E2E26');
    const nota = $('tc-nota-manca')!;
    nota.innerHTML = parziali > 0
      ? `Ai ${parziali} soci parziali manca in tutto <strong>${mancaInTutto.toFixed(2)} €</strong> per raggiungere la quota dell'anno.`
      : '';
  }

  /* La cassa. Un riquadro per tipo di incasso, e sotto il dettaglio riga per
     riga se lo si chiede. Tutti i numeri sono somme di righe che arrivano dal
     server: qui non si calcola niente che non si possa ricavare dalle tabelle. */
  function renderCassa() {
    const completati = incassi.filter((x) => x.stato === 'completato');
    const perTipo = new Map<string, { quante: number; totale: number; dove: Set<string> }>();
    for (const x of completati) {
      const k = String(x.tipo);
      if (!perTipo.has(k)) perTipo.set(k, { quante: 0, totale: 0, dove: new Set() });
      const v = perTipo.get(k)!;
      v.quante++; v.totale += Number(x.importo || 0); v.dove.add(String(x.tabella));
    }
    const ETICHETTA: Record<string, string> = {
      quota: 'Quote sociali', integrazione: 'Integrazioni', donazione: 'Donazioni',
      anticipo_gita: 'Anticipi gite',
    };
    const blocchi = [...perTipo.entries()].sort((a, b) => b[1].totale - a[1].totale).map(([tipo, v]) => {
      /* Gli anticipi della gita annullata sono incassati ma da restituire:
         sommarli agli altri senza dirlo darebbe una cassa piu' ricca di
         quella vera. */
      const daRestituire = tipo === 'anticipo_gita';
      return `<div class="bg-white border ${daRestituire ? 'border-[#8a3a3a]/40' : 'border-[#E5DFCF]'} rounded p-4 flex items-baseline justify-between gap-4">
         <span>
           <span class="text-[15px] text-[#1E2E26]">${esc(ETICHETTA[tipo] ?? tipo)}${daRestituire ? ' <span style="color:#8a3a3a;font-weight:600;">da restituire</span>' : ''}</span>
           <span class="block text-[12px] text-[#1E2E26]/50 mt-0.5">${esc(v.quante)} incass${v.quante === 1 ? 'o' : 'i'} · da ${esc([...v.dove].join(', '))}${daRestituire ? ' · gita annullata' : ''}</span>
         </span>
         <span class="text-xl whitespace-nowrap" style="font-family:'Playfair Display',serif;${daRestituire ? 'color:#8a3a3a;' : ''}">${esc(v.totale.toFixed(2))} €</span>
       </div>`;
    });
    const totale = completati.reduce((t, x) => t + Number(x.importo || 0), 0);
    const daRestituire = completati.filter((x) => x.tipo === 'anticipo_gita')
      .reduce((t, x) => t + Number(x.importo || 0), 0);
    blocchi.push(`<div class="bg-[#1E2E26] text-[#F5EEDD] rounded p-4 flex items-baseline justify-between gap-4">
         <span>
           <span class="text-[15px]">Totale incassato</span>
           ${daRestituire ? `<span class="block text-[12px] opacity-70 mt-0.5">di cui ${esc(daRestituire.toFixed(2))} € da restituire: resta ${esc((totale - daRestituire).toFixed(2))} €</span>` : ''}
         </span>
         <span class="text-xl whitespace-nowrap" style="font-family:'Playfair Display',serif;">${esc(totale.toFixed(2))} €</span>
       </div>`);
    /* Le righe non completate non spariscono: un bonifico in verifica e' una
       cosa che il segretario deve sapere che esiste. */
    const inSospeso = incassi.filter((x) => x.stato !== 'completato' && x.stato !== 'annullato');
    if (inSospeso.length) {
      const t = inSospeso.reduce((s, x) => s + Number(x.importo || 0), 0);
      blocchi.push(`<div class="bg-[#FDF9F0] border border-[#E8DFC7] rounded p-4 flex items-baseline justify-between gap-4">
           <span>
             <span class="text-[15px] text-[#1E2E26]">Non ancora completati</span>
             <span class="block text-[12px] text-[#1E2E26]/50 mt-0.5">${esc(inSospeso.length)} rig${inSospeso.length === 1 ? 'a' : 'he'} fra creati e in verifica</span>
           </span>
           <span class="text-xl whitespace-nowrap" style="font-family:'Playfair Display',serif;color:#8a6215;">${esc(t.toFixed(2))} €</span>
         </div>`);
    }
    $('tc-cassa')!.innerHTML = blocchi.join('');

    $('tc-cassa-dettaglio')!.innerHTML = `<table class="w-full text-[13px] border-collapse">
      <thead><tr class="text-left text-[#1E2E26]/55">
        <th class="py-2 pr-3 font-medium">Quando</th><th class="py-2 pr-3 font-medium">Chi</th>
        <th class="py-2 pr-3 font-medium">Cosa</th><th class="py-2 pr-3 font-medium">Metodo</th>
        <th class="py-2 pr-3 font-medium">Stato</th><th class="py-2 pr-3 font-medium text-right">Importo</th>
      </tr></thead><tbody>${incassi.map((x) => `<tr class="border-t border-[#E5DFCF]">
        <td class="py-2 pr-3 whitespace-nowrap">${esc(dataIt(x.quando))}</td>
        <td class="py-2 pr-3">${esc(x.nome || x.email || '—')}</td>
        <td class="py-2 pr-3">${esc(ETICHETTA[x.tipo] ?? x.tipo)}</td>
        <td class="py-2 pr-3">${esc(x.metodo === 'paypal' ? 'PayPal/carta' : x.metodo || '—')}</td>
        <td class="py-2 pr-3" style="color:${x.stato === 'completato' ? '#2d8659' : x.stato === 'annullato' ? '#999' : '#8a6215'};">${esc(x.stato)}</td>
        <td class="py-2 pr-3 text-right whitespace-nowrap">${esc(Number(x.importo || 0).toFixed(2))} €</td>
      </tr>`).join('')}</tbody></table>`;
  }

  function passa(x: any) {
    const q = val('tc-cerca').trim().toLowerCase();
    if (q && !`${x.nome} ${x.email}`.toLowerCase().includes(q)) return false;
    if (filtro === 'tutte') return true;
    if (filtro === 'da_lavorare') return x.stato === 'in_attesa';
    if (filtro === 'senza_incasso') return x.posizione === 'ammesso_senza_incasso';
    if (filtro === 'da_regolarizzare') return x.posizione === 'da_regolarizzare';
    if (filtro === 'parziale') return x.posizione === 'parziale';
    if (filtro === 'in_regola') return x.posizione === 'in_regola' || x.posizione === 'in_regola_per_deroga';
    return true;
  }

  function render() {
    const visibili = righe.filter(passa);
    $('tc-vuoto')!.classList.toggle('hidden', visibili.length > 0);
    $('tc-lista')!.innerHTML = visibili.map((x) => {
      const p = POSIZIONE[x.posizione] ?? POSIZIONE.non_ammesso;
      const giorni = giorniDa(x.approvata_il);
      /* Un'attesa lunga si dice, non si lascia dedurre da una data: e' il
         segnale che a luglio e' mancato per sei giorni. */
      const attesa = (x.stato === 'in_attesa' || x.posizione === 'ammesso_senza_incasso') && giorni >= 3
        ? `<span class="text-[12px] font-semibold" style="color:#a33;">da ${giorni} giorni</span>` : '';
      /* Chi e' gia' stato avvisato deve vedersi, altrimenti il segretario
         telefona a chi ha ricevuto una mail ieri. */
      const avvisi = (x.promemoria ?? []).filter((p: any) => p.esito === 'inviato');
      const promemoria = avvisi.length
        ? `<span class="text-[12px] text-[#1E2E26]/55"> · promemoria ${avvisi.map((p: any) => `n.${esc(p.numero)} del ${esc(dataIt(p.inviato_il))}`).join(', ')}</span>`
        : '';
      const quota = x.posizione === 'parziale'
        ? `<span style="color:#8a6215;">versati ${esc(Number(x.totale_incassato).toFixed(2))} € su ${esc(Number(x.quota_dovuta).toFixed(2))} €: <strong>mancano ${esc(Number(x.manca).toFixed(2))} €</strong>${x.metodi_incasso ? ` · ${esc(x.metodi_incasso === 'paypal' ? 'PayPal/carta' : x.metodi_incasso)}` : ''}</span>`
        : x.quota_incassata
        ? `<span style="color:#2d8659;">✓ ${esc(Number(x.totale_incassato).toFixed(2))} € via ${esc(x.metodi_incasso === 'paypal' ? 'PayPal/carta' : x.metodi_incasso || 'n/d')}, ${esc(dataIt(x.ultimo_incasso_il))}</span>`
        : x.in_deroga
          ? `<span style="color:#8a6215;">in deroga · ${esc(x.deroga_pagamento_motivo)}</span>`
          : x.posizione === 'da_regolarizzare'
            ? `<span style="color:#4a6180;">ha versato prima del sistema: manca il dato, non la quota</span>`
            : `<span style="color:#a33;">nessun incasso${x.metodo_scelto ? ` · ha scelto ${esc(x.metodo_scelto)}` : ' · nessun metodo scelto'}${Number(x.pagamenti_in_verifica) > 0 ? ` · <strong>${esc(x.pagamenti_in_verifica)} in verifica</strong>` : ''}${x.tentativi_non_riusciti ? ` · ${esc(x.tentativi_non_riusciti)} tentativo/i non riuscito/i` : ''}</span>`;
      /* Il bottone di registrazione sta sulla riga della persona: e' li' che
         il segretario si accorge che manca un incasso, non in un modulo a
         parte dove poi deve ridigitare nome ed email. */
      const registrabile = ['parziale', 'da_regolarizzare', 'ammesso_senza_incasso', 'in_regola'].includes(x.posizione);
      const azioni = registrabile
        ? `<button type="button" data-registra="${esc(x.domanda_id)}" class="mt-3 text-[13px] text-[#8a6215] underline bg-transparent border-0 p-0 cursor-pointer">Registra un incasso già avvenuto</button>`
        : '';
      return `<div class="bg-white border border-[#E5DFCF] hover:border-[#C8923E] rounded p-4 transition-colors">
        <a href="${esc(x.vista)}" class="block no-underline">
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <span class="text-[16px] text-[#1E2E26] font-medium" style="font-family:'Playfair Display',serif;">${esc(x.nome)}</span>
          <span class="text-[12px] px-2 py-0.5 rounded-full" style="background:${p.sfondo};color:${p.colore};">${esc(p.testo)}</span>
          ${x.numero_tessera != null ? `<span class="text-[12px] text-[#1E2E26]/55">tessera n. ${esc(x.numero_tessera)}</span>` : ''}
          ${attesa}
        </div>
        <p class="text-[13px] text-[#1E2E26]/60 m-0 mt-1">${esc(x.email)}${x.approvata_il ? ` · ammesso il ${esc(dataIt(x.approvata_il))}` : ''}${promemoria}</p>
        <p class="text-[13px] m-0 mt-1.5">${quota}</p>
        </a>
        ${azioni}
      </div>`;
    }).join('');

    document.querySelectorAll('[data-registra]').forEach((b) => b.addEventListener('click', () => {
      apriRegistrazione(String((b as HTMLElement).dataset.registra));
    }));
  }

  // ---- REGISTRAZIONE MANUALE ----
  function apriRegistrazione(domandaId: string) {
    socioCorrente = righe.find((x) => x.domanda_id === domandaId);
    if (!socioCorrente) return;
    const manca = Number(socioCorrente.manca || 0);
    ($('tc-reg-chi') as HTMLElement).innerHTML =
      `<strong>${esc(socioCorrente.nome)}</strong> · ${esc(socioCorrente.email)}`
      + (manca > 0 ? ` · gli mancano <strong>${esc(manca.toFixed(2))} €</strong> per la quota ${esc(socioCorrente.anno ?? '')}` : ' · risulta già in regola');
    // Precompilo l'importo con quello che manca: e' il valore giusto nove
    // volte su dieci, e resta modificabile.
    ($('tc-reg-importo') as HTMLInputElement).value = manca > 0 ? manca.toFixed(2) : '';
    ($('tc-reg-tipo') as HTMLSelectElement).value = 'quota';
    ($('tc-reg-data') as HTMLInputElement).value = '';
    ($('tc-reg-metodo') as HTMLSelectElement).value = 'contanti';
    ($('tc-reg-ricostruita') as HTMLInputElement).checked = false;
    ($('tc-reg-attestazione') as HTMLInputElement).checked = false;
    ($('tc-reg-note') as HTMLTextAreaElement).value = '';
    $('tc-reg-esito')!.classList.add('hidden');
    const sel = $('tc-reg-incassante') as HTMLSelectElement;
    sel.innerHTML = incassanti.map((p: any) =>
      `<option value="${esc(p.id)}"${p.id === io ? ' selected' : ''}>${esc(p.nome)}${p.id === io ? ' (tu)' : ''}</option>`).join('');
    show('tc-reg');
  }

  function esitoReg(msg: string, ok: boolean) {
    const e = $('tc-reg-esito')!;
    e.classList.remove('hidden');
    e.style.background = ok ? '#eaf3ee' : '#fbecec';
    e.style.borderLeft = `4px solid ${ok ? '#2d8659' : '#a33'}`;
    e.textContent = msg;
  }

  $('tc-reg-chiudi')?.addEventListener('click', () => hide('tc-reg'));
  $('tc-reg')?.addEventListener('click', (e) => { if (e.target === $('tc-reg')) hide('tc-reg'); });

  $('tc-reg-salva')?.addEventListener('click', async () => {
    if (!socioCorrente) return;
    const importo = Number(val('tc-reg-importo'));
    const data = val('tc-reg-data');
    const incassante = val('tc-reg-incassante');
    const attestato = ($('tc-reg-attestazione') as HTMLInputElement).checked;
    if (!Number.isFinite(importo) || importo <= 0) return esitoReg('Scrivi un importo valido.', false);
    if (!/^\d{4}-\d{2}-\d{2}$/.test(data)) return esitoReg('Scegli la data dell\'incasso.', false);
    if (!incassante) return esitoReg('Indica chi ha materialmente incassato.', false);
    // L'attestazione non e' un fastidio burocratico: e' la riga che dice che
    // dietro a questo dato c'e' una persona che ci mette la faccia.
    if (!attestato) return esitoReg('Serve l\'attestazione: è denaro, e resta agli atti.', false);

    const btn = $('tc-reg-salva') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = 'Registro…';
    try {
      const { data: { session } } = await supabase.auth.getSession();
      const r = await fetch(REGISTRA_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${session?.access_token ?? ''}` },
        body: JSON.stringify({
          nome: socioCorrente.nome, email: socioCorrente.email,
          importo, tipo: val('tc-reg-tipo'), metodo: val('tc-reg-metodo'),
          incassato_il: data, incassato_da: incassante,
          data_ricostruita: ($('tc-reg-ricostruita') as HTMLInputElement).checked,
          note: val('tc-reg-note'),
          attestazione: true, consenso_modalita: 'verbale',
        }),
      });
      const j = await r.json();
      if (r.ok && !j.error) {
        esitoReg('Incasso registrato. Ricarico il pannello…', true);
        setTimeout(() => window.location.reload(), 1200);
      } else {
        esitoReg(j.detail || j.error || 'Registrazione non riuscita.', false);
        btn.disabled = false; btn.textContent = 'Registra l\'incasso';
      }
    } catch {
      esitoReg('Errore di connessione. Riprova.', false);
      btn.disabled = false; btn.textContent = 'Registra l\'incasso';
    }
  });

  document.querySelectorAll('.tc-filtro').forEach((b) => b.addEventListener('click', () => {
    filtro = (b as HTMLElement).dataset.filtro!;
    document.querySelectorAll('.tc-filtro').forEach((o) => {
      const attivo = o === b;
      o.classList.toggle('bg-[#1E2E26]', attivo); o.classList.toggle('text-[#F5EEDD]', attivo);
      o.classList.toggle('border-[#1E2E26]', attivo);
      o.classList.toggle('bg-white', !attivo); o.classList.toggle('text-[#1E2E26]', !attivo);
      o.classList.toggle('border-[#C8923E]/40', !attivo);
    });
    render();
  }));
  $('tc-cerca')?.addEventListener('input', render);
  $('tc-cassa-toggle')?.addEventListener('click', () => {
    const box = $('tc-cassa-dettaglio')!;
    const aperto = !box.classList.contains('hidden');
    box.classList.toggle('hidden', aperto);
    ($('tc-cassa-toggle') as HTMLElement).textContent = aperto ? 'Mostra il dettaglio' : 'Nascondi il dettaglio';
  });

  // ---- LOGIN (stesso flusso delle altre curatele) ----
  const loginErr = (t: string) => { const e = $('tc-login-err')!; e.classList.remove('hidden'); e.textContent = t; };
  $('tc-send')?.addEventListener('click', async () => {
    const email = val('tc-email').trim().toLowerCase();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { loginErr('Email non valida.'); return; }
    $('tc-login-err')?.classList.add('hidden');
    const btn = $('tc-send') as HTMLButtonElement; btn.disabled = true; btn.textContent = 'Invio…';
    const { data, error } = await supabase.functions.invoke('otp-request', { body: { email, scope: 'login' } });
    btn.disabled = false; btn.textContent = 'Invia codice';
    if (error || !data?.ok) { loginErr('Impossibile inviare il codice. Riprova.'); return; }
    (window as any)._tcEmail = email;
    ($('tc-email-echo') as HTMLElement).textContent = email;
    hide('tc-login-1'); show('tc-login-2');
    setTimeout(() => ($('tc-code') as HTMLInputElement)?.focus(), 100);
  });
  $('tc-back')?.addEventListener('click', () => { hide('tc-login-2'); show('tc-login-1'); });
  $('tc-verify')?.addEventListener('click', async () => {
    const codice = val('tc-code').replace(/\D/g, '');
    if (!/^\d{6}$/.test(codice)) { loginErr('Il codice deve essere di 6 cifre.'); return; }
    $('tc-login-err')?.classList.add('hidden');
    const btn = $('tc-verify') as HTMLButtonElement; btn.disabled = true; btn.textContent = 'Verifica…';
    const { data, error } = await supabase.functions.invoke('otp-verify', { body: { email: (window as any)._tcEmail, codice, scope: 'login' } });
    if (error || !data?.ok || !data?.session) { btn.disabled = false; btn.textContent = 'Verifica e accedi'; loginErr('Codice errato o scaduto.'); return; }
    await supabase.auth.setSession({ access_token: data.session.access_token, refresh_token: data.session.refresh_token });
    window.location.reload();
  });
  const logout = async () => { await supabase.auth.signOut(); window.location.reload(); };
  $('tc-logout')?.addEventListener('click', logout);
  $('tc-logout-2')?.addEventListener('click', logout);

  init();
</script>
