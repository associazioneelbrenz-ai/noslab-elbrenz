---
/**
 * /guardiani-de-la-lenga — motore crowdsourced del glossario del ladino
 * anaunico (Guardiani de la lenga, 12/07/2026). Doppia funzione: alimenta
 * il glossario (dizionario_lemma) e fa lead-gen.
 *
 * SSR (prerender=false): il glossario vivo legge la vista pubblica
 * `glossario_pubblico` (mai dati personali) a ogni richiesta. Il form POSTa
 * a `guardiani-contributo`; ogni contributo passa da curatela umana.
 *
 * FLAG GUARDIANI_LIVE (default false): finché OFF la pagina è noindex e non
 * è linkata (card home + voce menu nascoste) — si evita di esporre un guscio
 * vuoto. GUARDIANI_CLASSIFICA_LIVE (default false): V2, classifica/premi non
 * implementati (solo colonna punti predisposta a DB).
 *
 * GRAFIA da confermare con Union Ladin Nonesa: "de la lenga" vs "dla lenga".
 */

import { createClient } from '@supabase/supabase-js';
import Layout from '../layouts/Layout.astro';

export const prerender = false;

const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL as string;
const SUPABASE_ANON = import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string;
const ENDPOINT = `${SUPABASE_URL}/functions/v1/guardiani-contributo`;
const ENDPOINT_AUDIO = `${SUPABASE_URL}/functions/v1/glossario-audio`;
const LIVE = import.meta.env.GUARDIANI_LIVE === 'true';

const VARIANTI: [string, string][] = [
  ['noneso', 'Noneso · Val di Non'],
  ['solander', 'Solander · Val di Sole'],
  ['rabies', 'Rabies · Val di Rabbi'],
  ['pegaes', 'Pegaes · Val di Pejo'],
];
const TIPI: [string, string][] = [['parola', 'Parola'], ['frase', 'Frase'], ['espressione', 'Espressione']];

type Voce = {
  id: string; termine: string; tipo: string | null; variante: string | null;
  comune: string | null; significato_it: string; esempio_uso: string | null;
  contributore_firma: string | null;
  // [7/8/2026] Aggiunti con il dizionario: lo slug per la scheda propria di
  // ogni voce, la variante italiana perche' la ricerca funzioni anche partendo
  // dall'italiano, la categoria grammaticale che in un dizionario e' parte
  // della voce e non un dettaglio.
  slug?: string | null; variante_italiana?: string | null;
  categoria_gramm?: string | null; etimologia?: string | null; proverbi?: string | null;
};
let glossario: Voce[] = [];
// [10/8/2026] IL VOCABOLARIO CONTROLLATO.
// Paesi e categorie grammaticali non sono piu' testo libero: con dieci
// contributori diventerebbero dieci grafie della stessa cosa, e nei dati c'e'
// gia' «RALLO» tutto maiuscolo accanto agli altri paesi scritti normalmente.
// Gli elenchi vivono a database e li governano i curatori: chi propone una
// parola non deve dover indovinare come si scrive il nome del suo paese.
type VocVoce = { dominio: string; valore: string; etichetta: string; gruppo: string | null; ordine: number };
let comuni: VocVoce[] = [];
let categorie: VocVoce[] = [];
try {
  const sb = createClient(SUPABASE_URL, SUPABASE_ANON, { auth: { persistSession: false } });
  const { data } = await sb.from('glossario_pubblico').select('*').order('termine').limit(300);
  glossario = (data as Voce[]) ?? [];
  const { data: vv } = await sb.from('vocabolario_pubblico').select('*').order('ordine').order('etichetta');
  for (const v of (vv as VocVoce[]) ?? []) {
    if (v.dominio === 'comune') comuni.push(v);
    else if (v.dominio === 'categoria_gramm') categorie.push(v);
  }
} catch (e) {
  console.error('[guardiani] lettura glossario fallita:', e);
}
// I paesi si mostrano raggruppati per valle: un elenco di sessanta nomi in fila
// e' un elenco che non si legge.
const gruppiComuni = [...new Set(comuni.map((c) => c.gruppo ?? ''))];

// [7/8/2026] LA RICERCA DEVE FUNZIONARE NELLE DUE DIREZIONI E PERDONARE.
// Chi cerca «pipistrello» deve arrivare a Barbustel, e chi cerca «barbustel»
// deve arrivare al pipistrello. E deve tollerare accenti e grafie
// approssimate, perche' chi cerca non sa come si scrive: e' il motivo per cui
// viene a cercare. La chiave di ricerca mette insieme lemma, significato,
// variante italiana e comune, tutto senza accenti.
function norm(t: unknown): string {
  return (t ?? '').toString().toLowerCase()
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
    .replace(/\s+/g, ' ').trim();
}
const comuniPresenti = [...new Set(glossario.map((v) => v.comune).filter(Boolean))].sort();
const iniziali = [...new Set(glossario.map((v) => (v.termine ?? '?').trim().charAt(0).toUpperCase()))].sort();
const VARIANTE_LABEL = Object.fromEntries(VARIANTI);
const input = 'w-full px-3 py-2 rounded bg-white text-[#1E2E26] border border-[#C8923E]/40 focus:outline-none focus:border-[#C8923E]';
---

<Layout
  title="Guardiani de la lenga"
  description="Custodiamo insieme il ladino anaunico delle Valli del Noce: proponi parole, frasi e proverbi nelle quattro parlate (noneso, solander, rabies, pegaes) e falle entrare nel glossario vivo di El Brenz."
  ogImage="/og/og-guardiani.jpg"
  noindex={!LIVE}
>
  {/* 1. HERO / MANIFESTO */}
  <header class="bg-[#1E2E26] text-[#F5EEDD]">
    <div class="max-w-4xl mx-auto px-6 py-16 md:py-24">
      <p class="text-[11px] tracking-[0.22em] uppercase text-[#D9A94E] font-medium m-0 mb-4" style="font-family: 'Inter', sans-serif;">Un progetto di comunità</p>
      <h1 class="text-4xl md:text-5xl leading-tight m-0 mb-5" style="font-family: 'Playfair Display', serif; font-weight: 500;">
        Guardiani de la <em class="text-[#C8923E]" style="font-style: italic;">lenga</em>
      </h1>
      <p class="text-lg leading-relaxed text-[#F5EEDD]/85 m-0 max-w-2xl" style="font-family: 'Source Serif 4', Georgia, serif;">
        Ogni paese delle nostre valli custodisce parole che nessun dizionario ha
        ancora raccolto. Il <em>noneso</em>, il <em>solander</em>, il <em>rabies</em>,
        il <em>pegaes</em>: quattro parlate del ladino anaunico che vivono nella voce
        di chi le parla. Aiutaci a custodirle prima che si perdano: proponi un termine,
        un curatore lo valida, e diventa patrimonio di tutti.
      </p>
      <p class="text-[#D9A94E] italic font-serif mt-6 text-lg">Raìs fonde no le ’nglacia</p>
    </div>
  </header>

  {!LIVE && (
    <div class="bg-[#FDF9F0] border-b border-[#C8923E]/30">
      <p class="max-w-4xl mx-auto px-6 py-3 text-sm text-[#8a6215] m-0" style="font-family: 'Inter', sans-serif;">
        Anteprima riservata: la pagina non è ancora pubblica (in attesa dei primi termini validati).
      </p>
    </div>
  )}

  <section class="bg-[#F8F1E4] py-14">
    <div class="max-w-4xl mx-auto px-6">

      {/* 2. COME FUNZIONA */}
      <h2 class="text-[11px] tracking-[0.2em] uppercase text-[#8a6215] font-medium mb-6 text-center" style="font-family: 'Inter', sans-serif;">Come funziona</h2>
      <ol class="grid md:grid-cols-3 gap-5 list-none p-0 m-0 mb-16" style="font-family: 'Source Serif 4', Georgia, serif;">
        <li class="bg-[#F5EEDD] border border-[#C8923E]/40 rounded-md p-6 text-center">
          <span class="block text-3xl text-[#C8923E] mb-2" style="font-family: 'Playfair Display', serif;">1</span>
          <strong class="block text-[#1E2E26] mb-1">Proponi</strong>
          <span class="text-sm text-[#1E2E26]/75">Una parola, una frase o un proverbio, con il paese e la parlata.</span>
        </li>
        <li class="bg-[#F5EEDD] border border-[#C8923E]/40 rounded-md p-6 text-center">
          <span class="block text-3xl text-[#C8923E] mb-2" style="font-family: 'Playfair Display', serif;">2</span>
          <strong class="block text-[#1E2E26] mb-1">La Commissione valida</strong>
          <span class="text-sm text-[#1E2E26]/75">La Commissione Linguistica di El Brenz (portavoce Cristian Bresadola) o l'Union Ladin Nonesa valida ogni contributo.</span>
        </li>
        <li class="bg-[#F5EEDD] border border-[#C8923E]/40 rounded-md p-6 text-center">
          <span class="block text-3xl text-[#C8923E] mb-2" style="font-family: 'Playfair Display', serif;">3</span>
          <strong class="block text-[#1E2E26] mb-1">Entra nel glossario</strong>
          <span class="text-sm text-[#1E2E26]/75">Diventa parte del patrimonio vivo delle valli, con il tuo nome se vuoi.</span>
        </li>
      </ol>

      {/* 3. FORM DI CONTRIBUTO */}
      <div id="proponi" class="bg-[#F5EEDD] border border-[#C8923E]/50 rounded-md p-6 md:p-8 mb-16 scroll-mt-20">
        <h2 class="text-2xl text-[#1E2E26] m-0 mb-1" style="font-family: 'Playfair Display', serif; font-weight: 500;">Proponi un termine</h2>
        <p class="text-sm text-[#1E2E26]/70 m-0 mb-6" style="font-family: 'Source Serif 4', Georgia, serif;">Serve poco: la parola, dove si dice, e una riga che la spieghi. Tutto il resto è facoltativo e si può aggiungere anche dopo. Il contributo appare nel glossario solo dopo la validazione di un curatore.</p>
        <form id="guardiani-form" data-endpoint={ENDPOINT} data-audio={ENDPOINT_AUDIO} class="grid gap-4" novalidate style="font-family: 'Inter', sans-serif;">
          <input type="text" name="_honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
          <div class="grid md:grid-cols-2 gap-4">
            <div><label class="block text-sm mb-1 text-[#1E2E26]/80">Termine, frase o proverbio *</label><input name="termine" required maxlength="200" class={input} placeholder="in ladino anaunico" /></div>
            <div><label class="block text-sm mb-1 text-[#1E2E26]/80">Parlata *</label><select name="variante" required class={input}><option value="">Scegli…</option>{VARIANTI.map(([v, l]) => <option value={v}>{l}</option>)}</select></div>
            <div><label class="block text-sm mb-1 text-[#1E2E26]/80">Tipo *</label><select name="tipo" required class={input}><option value="">Scegli…</option>{TIPI.map(([v, l]) => <option value={v}>{l}</option>)}</select></div>
            {/* IL PAESE. Mancava in ventiquattro casi su centoquarantasei, e chi
                propone una parola sa sempre dove si dice: qui diventa
                obbligatorio, ma con la strada per chi non trova il suo. */}
            <div>
              <label class="block text-sm mb-1 text-[#1E2E26]/80">Paese o frazione *</label>
              <select name="comune_scelta" required class={input}>
                <option value="">Scegli…</option>
                {gruppiComuni.map((g) => (
                  g
                    ? <optgroup label={g}>{comuni.filter((c) => (c.gruppo ?? '') === g).map((c) => <option value={c.valore}>{c.etichetta}</option>)}</optgroup>
                    : <>{comuni.filter((c) => !c.gruppo).map((c) => <option value={c.valore}>{c.etichetta}</option>)}</>
                ))}
                <option value="__altro">Il mio paese non c’è nell’elenco…</option>
              </select>
              <input name="comune_altro" maxlength="100" class={input + ' mt-2 hidden'} id="gu-comune-altro" placeholder="Scrivi il nome del paese" />
            </div>
          </div>

          {/* LA DEFINIZIONE, E LA SUA ALTERNATIVA.
              Chiedere sempre «una riga che spieghi» era sbagliato, e l'ha
              scoperto Monica in mezz'ora: «asá» vuol dire «abbastanza», e di
              «abbastanza» non esiste una perifrasi che non sia riempitivo.
              Vale per tutti gli avverbi, le preposizioni, le esclamazioni.
              Quindi si chiede di farsi capire, non di scrivere lungo: o la
              definizione estesa, o una frase in cui la parola compare. */}
          <div>
            <label class="block text-sm mb-1 text-[#1E2E26]/80">Che cosa vuol dire, in italiano *</label>
            <textarea name="significato" required rows="2" maxlength="2000" class={input} placeholder="il pipistrello, che d’estate esce al tramonto dai fienili"></textarea>
            <p class="text-[12px] text-[#1E2E26]/60 m-0 mt-1">
              Se puoi, spiega la cosa invece di tradurla soltanto: «il pipistrello,
              che d’estate esce al tramonto dai fienili» dice molto più di «pipistrello».
              Ma certe parole non si spiegano così: <em>asá</em> vuol dire
              «abbastanza», e basta: in quel caso scrivi la traduzione qui e
              mettici sotto una frase d’esempio, che spiega meglio di qualunque giro di parole.
            </p>
            <p id="gu-def-conta" class="text-[12px] m-0 mt-1"></p>
          </div>

          {/* I TRE CAMPI CHE NESSUNO COMPILAVA. Erano vuoti sul cento per cento
              dei lemmi, e non per disinteresse: il modulo non diceva cosa
              scriverci. Restano facoltativi, con un esempio breve accanto. */}
          <div class="grid md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm mb-1 text-[#1E2E26]/80">Esempio d’uso</label>
              <input name="esempio" maxlength="1000" class={input} placeholder="una frase in cui la parola compare" />
              <p class="text-[12px] text-[#1E2E26]/60 m-0 mt-1">Come la diresti tu, in ladino.</p>
            </div>
            <div>
              <label class="block text-sm mb-1 text-[#1E2E26]/80">Che parte del discorso è</label>
              <select name="categoria" class={input}>
                <option value="">Non lo so / lascio in bianco</option>
                {categorie.map((c) => <option value={c.valore}>{c.etichetta}</option>)}
              </select>
              <p class="text-[12px] text-[#1E2E26]/60 m-0 mt-1">Se sei in dubbio, lascia stare: lo mette un curatore.</p>
            </div>
            <div>
              <label class="block text-sm mb-1 text-[#1E2E26]/80">Da dove viene la parola</label>
              <textarea name="etimologia" rows="2" maxlength="1500" class={input}></textarea>
              <p class="text-[12px] text-[#1E2E26]/60 m-0 mt-1">Se lo sai: dal latino, dal tedesco, da un mestiere. Se non lo sai, meglio vuoto che inventato.</p>
            </div>
            <div>
              <label class="block text-sm mb-1 text-[#1E2E26]/80">Un detto in cui compare</label>
              <textarea name="proverbi" rows="2" maxlength="1500" class={input}></textarea>
              <p class="text-[12px] text-[#1E2E26]/60 m-0 mt-1">Un modo di dire, una filastrocca, una frase che diceva qualcuno in casa.</p>
            </div>
          </div>

          {/* ══════ LA VOCE ══════
              E' il pezzo che vale piu' di tutto il resto. La grafia del ladino
              anaunico non e' normalizzata: chi legge «Barbustel» non sa come
              suona. E soprattutto l'archivio delle voci comincia a riempirsi
              senza che nessuno organizzi interviste.
              Il pulsante che registra viene PRIMA del caricamento di un file:
              nessuno apre l'applicazione dei memo, registra, salva, torna qui e
              cerca il file; ma tutti tengono premuto un pulsante e dicono una
              parola. */}
          <div class="border-t border-[#C8923E]/30 pt-4">
            <p class="text-[11px] tracking-[0.2em] uppercase text-[#8a6215] font-semibold m-0 mb-1">La voce · facoltativa</p>
            <p class="text-sm text-[#1E2E26]/75 m-0 mb-3" style="font-family: 'Source Serif 4', Georgia, serif;">
              Dilla ad alta voce: bastano tre secondi. È la cosa più preziosa che
              puoi darci, perché la scrittura non dice come suona.
            </p>

            <div class="flex gap-2 flex-wrap items-center">
              <button type="button" id="au-rec" class="bg-[#1E2E26] text-[#F5EEDD] px-5 py-2.5 rounded text-sm font-semibold border-0 cursor-pointer">● Registra</button>
              <button type="button" id="au-stop" class="hidden bg-[#a33] text-white px-5 py-2.5 rounded text-sm font-semibold border-0 cursor-pointer">■ Ferma</button>
              <span id="au-timer" class="text-sm text-[#1E2E26]/70"></span>
              <label class="text-sm text-[#8a6215] underline cursor-pointer">
                oppure carica un file
                <input type="file" id="au-file" accept="audio/*,.m4a,.mp3,.wav,.ogg,.webm,.3gp,.caf,.amr" class="hidden" />
              </label>
            </div>
            <p id="au-nota" class="text-[12px] text-[#1E2E26]/60 m-0 mt-2"></p>

            <div id="au-pronta" class="hidden mt-3 bg-white border border-[#C8923E]/40 rounded p-4">
              <audio id="au-play" controls class="w-full mb-3"></audio>
              <button type="button" id="au-rifai" class="bg-transparent border-0 p-0 text-sm text-[#8a6215] underline cursor-pointer mb-3">Rifacciamola</button>

              <p class="text-sm text-[#1E2E26]/80 m-0 mb-2">Chi sta parlando?</p>
              <label class="flex items-start gap-2 text-sm text-[#1E2E26]/80 mb-1">
                <input type="radio" name="au_chi" value="io" checked class="mt-1 accent-[#C8923E]" />
                <span>Sono io. So che la registrazione sarà pubblicata nel glossario con il mio nome, e che posso chiedere di toglierla.</span>
              </label>
              <label class="flex items-start gap-2 text-sm text-[#1E2E26]/80">
                <input type="radio" name="au_chi" value="altri" class="mt-1 accent-[#C8923E]" />
                <span>È un’altra persona che ha acconsentito.</span>
              </label>

              <div id="au-altri" class="hidden mt-3 grid gap-2">
                <input id="au-parlante" maxlength="120" class={input} placeholder="Nome di chi parla" />
                <label class="flex items-start gap-2 text-sm text-[#1E2E26]/80">
                  <input type="checkbox" id="au-consenso" class="mt-1 accent-[#C8923E]" />
                  <span>Confermo che chi parla è d’accordo che la sua voce sia pubblicata nel glossario. Il consenso lo dà chi parla, non chi registra.</span>
                </label>
              </div>

              <label class="flex items-start gap-2 text-sm text-[#1E2E26]/80 mt-3">
                <input type="checkbox" id="au-anonimo" class="mt-1 accent-[#C8923E]" />
                <span>Pubblicatela senza il nome di chi parla.</span>
              </label>
              <p class="text-[12px] text-[#1E2E26]/55 m-0 mt-2">
                Un curatore ascolta prima di pubblicare. Come trattiamo la voce sta
                nell’<a href="/privacy" target="_blank" class="text-[#8a6215] underline">informativa privacy</a>.
              </p>
            </div>
          </div>
          <div class="border-t border-[#C8923E]/30 pt-4 grid md:grid-cols-2 gap-4">
            <div><label class="block text-sm mb-1 text-[#1E2E26]/80">Il tuo nome *</label><input name="nome" required maxlength="100" class={input} /></div>
            <div><label class="block text-sm mb-1 text-[#1E2E26]/80">La tua email *</label><input name="email" type="email" required maxlength="200" class={input} /></div>
          </div>
          <label class="flex items-start gap-2 text-sm text-[#1E2E26]/80"><input type="checkbox" name="consenso_glossario" required class="mt-1 accent-[#C8923E]" /><span>Acconsento che il mio contributo sia usato nel glossario e nei materiali dell’Associazione, come da <a href="/privacy" target="_blank" class="text-[#8a6215] underline">informativa privacy</a>. *</span></label>
          <label class="flex items-start gap-2 text-sm text-[#1E2E26]/80"><input type="checkbox" name="licenza_accettata" required class="mt-1 accent-[#C8923E]" /><span>Cedo il contributo con licenza <strong>CC BY 4.0</strong>: l’Associazione potrà usarlo (glossario, Lunari, Os dal Nos, assistente Andreas) citando la fonte. *</span></label>
          <label class="flex items-start gap-2 text-sm text-[#1E2E26]/80"><input type="checkbox" name="consenso_firma" class="mt-1 accent-[#C8923E]" /><span>Voglio comparire con il mio nome tra chi ha contribuito (altrimenti resto anonimo nel glossario).</span></label>
          <label class="flex items-start gap-2 text-sm text-[#1E2E26]/80"><input type="checkbox" name="consenso_marketing" class="mt-1 accent-[#C8923E]" /><span>Tenetemi aggiornato sul glossario e sui progetti della lingua (riceverai una email per confermare l’iscrizione).</span></label>
          <div id="guardiani-feedback" class="hidden rounded px-4 py-3 text-sm"></div>
          <div><button id="guardiani-invia" type="submit" class="bg-[#C8923E] text-[#1E2E26] px-7 py-3 text-sm font-medium tracking-wider uppercase rounded cursor-pointer border-0 hover:bg-[#D9A94E] transition-colors focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#C8923E]">Invia il contributo</button></div>
        </form>
      </div>

      {/* 4. GLOSSARIO VIVO */}
      <h2 class="text-2xl text-[#1E2E26] m-0 mb-1 text-center" style="font-family: 'Playfair Display', serif; font-weight: 500;">Il glossario vivo</h2>
      <p class="text-sm text-[#1E2E26]/70 m-0 mb-6 text-center" style="font-family: 'Source Serif 4', Georgia, serif;">{glossario.length > 0 ? `${glossario.length} termini custoditi finora` : 'Cresce a ogni contributo validato'}</p>
      {glossario.length > 0 ? (
        <>
          <div class="flex flex-wrap gap-3 mb-5 justify-center" style="font-family: 'Inter', sans-serif;">
            <input id="gloss-cerca" type="search" placeholder="Cerca…" class="px-3 py-2 rounded bg-white border border-[#C8923E]/40 text-sm text-[#1E2E26] focus:outline-none focus:border-[#C8923E]" />
            <select id="gloss-filtro" class="px-3 py-2 rounded bg-white border border-[#C8923E]/40 text-sm text-[#1E2E26] focus:outline-none focus:border-[#C8923E]">
              <option value="">Tutte le parlate</option>{VARIANTI.map(([v, l]) => <option value={v}>{l}</option>)}
            </select>
            <select id="gloss-comune" class="px-3 py-2 rounded bg-white border border-[#C8923E]/40 text-sm text-[#1E2E26] focus:outline-none focus:border-[#C8923E]">
              <option value="">Tutti i paesi</option>{comuniPresenti.map((c) => <option value={c}>{c}</option>)}
            </select>
            <select id="gloss-tipo" class="px-3 py-2 rounded bg-white border border-[#C8923E]/40 text-sm text-[#1E2E26] focus:outline-none focus:border-[#C8923E]">
              <option value="">Parole e detti</option>
              <option value="parola">Solo parole</option>
              <option value="detto">Solo detti e modi di dire</option>
            </select>
          </div>
          <div class="flex flex-wrap gap-1 justify-center mb-5" style="font-family: 'Inter', sans-serif;">
            {iniziali.map((L) => (
              <button type="button" class="gloss-lettera w-8 h-8 rounded text-sm text-[#1E2E26] border border-[#C8923E]/40 cursor-pointer transition-colors" data-lettera={L} style="background: transparent;">{L}</button>
            ))}
          </div>
          <ul id="gloss-lista" class="grid gap-3 md:grid-cols-2 list-none p-0 m-0" style="font-family: 'Source Serif 4', Georgia, serif;">
            {glossario.map((v) => (
              <li class="gloss-voce bg-white border-l-4 border-[#C8923E] px-4 py-3" data-t={norm(`${v.termine} ${v.significato_it ?? ''} ${v.variante_italiana ?? ''} ${v.comune ?? ''}`)} data-v={v.variante ?? ''} data-c={v.comune ?? ''} data-tipo={v.tipo ?? 'parola'} data-l={(v.termine ?? '?').trim().charAt(0).toUpperCase()}>
                <a href={v.slug ? `/guardiani-de-la-lenga/${v.slug}` : '#'} class="no-underline"><strong class="text-[#1E2E26] hover:underline" style="font-family: 'Playfair Display', serif;">{v.termine}</strong></a>
                <span class="text-[10px] uppercase tracking-wider text-[#C8923E] ml-2" style="font-family: 'Inter', sans-serif;">{v.variante ? VARIANTE_LABEL[v.variante]?.split(' · ')[0] : ''}{v.comune ? ` · ${v.comune}` : ''}</span>
                <p class="text-sm text-[#1E2E26]/80 m-0 mt-1">{v.significato_it}</p>
                {v.esempio_uso && <p class="text-xs text-[#1E2E26]/55 italic m-0 mt-1">« {v.esempio_uso} »</p>}
                {v.contributore_firma && <p class="text-[11px] text-[#8a6215] m-0 mt-1">· {v.contributore_firma}</p>}
              </li>
            ))}
          </ul>
          <p id="gloss-vuoto" class="hidden text-center text-sm text-[#1E2E26]/60 mt-4">Nessun termine trovato.</p>
          {/* Un archivio linguistico che vive in un solo posto non e' un
              archivio: la copia da stampare e da portarsi via sta qui. */}
          <p class="text-center text-sm mt-6 m-0" style="font-family: 'Inter', sans-serif;">
            <a href="/guardiani-de-la-lenga/esporta" class="text-[#8a6215] underline">
              Il glossario intero in una pagina, da leggere, stampare o scaricare
            </a>
          </p>
        </>
      ) : (
        <p class="text-center text-[#1E2E26]/70" style="font-family: 'Source Serif 4', Georgia, serif;">Il primo termine potresti proporlo tu: <a href="#proponi" class="text-[#8a6215] underline">comincia da qui</a>.</p>
      )}

      {/* 5. CHI VALIDA / PARTNER */}
      <div class="mt-16 bg-[#1E2E26] text-[#F5EEDD] rounded-md p-6 md:p-8 text-center">
        <h2 class="text-[11px] tracking-[0.2em] uppercase text-[#D9A94E] font-medium mb-3" style="font-family: 'Inter', sans-serif;">Chi custodisce con noi</h2>
        <p class="text-[#F5EEDD]/85 m-0 max-w-2xl mx-auto" style="font-family: 'Source Serif 4', Georgia, serif;">
          I contributi proposti dalla comunità vengono validati, prima della
          pubblicazione, da una delle due autorità linguistiche di riferimento: la
          <strong>Commissione Linguistica dell'Associazione El Brenz</strong> o
          l'<strong>Union Ladin Nonesa</strong>. È sufficiente la validazione di una
          delle due. Solo i lemmi validati diventano pubblici, custoditi con i
          <a href="/custodi-della-memoria" class="text-[#D9A94E] underline">custodi della memoria</a>:
          le persone e le famiglie che tengono viva la <em>nosa lenga</em>.
        </p>
      </div>
    </div>
  </section>
  {/*
    IL POPUP DEI PUNTI. Compare SOLO dopo che una proposta e' andata a buon fine:
    e' l'unico momento in cui un invito non suona come una richiesta, perche' la
    persona ha appena dato qualcosa e le si sta dicendo che quel qualcosa vale.
    Fuori di qui non compare mai, nemmeno al secondo invio nella stessa sessione.
  */}
  <div id="pop-punti" class="fixed inset-0 z-[60] hidden items-center justify-center px-5"
       style="background: rgba(15,25,20,0.55); backdrop-filter: blur(2px);"
       role="dialog" aria-modal="true" aria-labelledby="pop-punti-titolo">
    <div class="bg-[#FDF9F0] rounded-xl border border-[#C8923E]/40 max-w-md w-full p-7 relative"
         style="box-shadow: 0 18px 50px rgba(0,0,0,0.3);">

      <button id="pop-punti-chiudi" type="button" aria-label="Chiudi"
              class="absolute top-3 right-4 text-2xl leading-none text-[#1E2E26]/40 hover:text-[#1E2E26] bg-transparent border-0 cursor-pointer">×</button>

      <p class="text-[11px] tracking-[0.22em] uppercase text-[#8a6215] font-semibold m-0 mb-3"
         style="font-family: 'Inter', sans-serif;">Guardiani de la lenga</p>

      <h2 id="pop-punti-titolo" class="text-2xl md:text-[28px] leading-tight text-[#1E2E26] m-0 mb-4"
          style="font-family: 'Playfair Display', serif; font-weight: 500;">
        Quella parola adesso è al sicuro.
      </h2>

      <p class="text-[#1E2E26]/85 leading-relaxed m-0 mb-4"
         style="font-family: 'Source Serif 4', Georgia, serif;">
        L’hai portata tu, e resta con il tuo nome accanto. Se diventi socio,
        <strong id="pop-punti-cifra">i tuoi punti ti aspettano</strong>: contati
        da quando hai cominciato.
      </p>

      <p id="pop-punti-spiega" class="text-[#1E2E26]/75 leading-relaxed m-0 mb-4 text-[15px]"
         style="font-family: 'Source Serif 4', Georgia, serif;"></p>

      <p class="text-[#1E2E26]/85 leading-relaxed m-0 mb-5"
         style="font-family: 'Source Serif 4', Georgia, serif;">
        Non è un gioco a premi: è il modo che abbiamo per dire chi tiene in piedi questo lavoro.
        E conta anche fuori di qui: le attività convenzionate con El Brenz riservano
        <strong>sconti e coupon</strong> a chi l’Associazione la tiene viva.
      </p>

      <a href="/tesseramento"
         class="block text-center bg-[#C8923E] text-[#1E2E26] font-semibold px-6 py-3 rounded-md no-underline hover:bg-[#D9A94E] transition-colors mb-3"
         style="font-family: 'Inter', sans-serif;">Scopri come tesserarsi</a>

      <a href="/convenzioni"
         class="block text-center text-[#8a6215] font-semibold no-underline hover:underline mb-4 text-sm"
         style="font-family: 'Inter', sans-serif;">Guarda le convenzioni attive →</a>

      {/* La via d'uscita, in chiaro. Un invito che non la offre e' una trappola,
          e chi la sente non torna a proporre una seconda parola. */}
      <p class="text-[13px] text-[#1E2E26]/60 text-center m-0" style="font-family: 'Inter', sans-serif;">
        Nessuna fretta: le tue parole restano nostre comunque.
      </p>
    </div>
  </div>

</Layout>

<script>
  const form = document.getElementById('guardiani-form') as HTMLFormElement | null;
  if (form) {
    const endpoint = form.dataset.endpoint!;
    const aperto = Date.now();
    const feedback = document.getElementById('guardiani-feedback')!;
    const invia = document.getElementById('guardiani-invia') as HTMLButtonElement;
    function mostra(msg: string, ok: boolean) {
      feedback.classList.remove('hidden');
      feedback.style.background = ok ? '#eaf3ee' : '#fbecec';
      feedback.style.borderLeft = `3px solid ${ok ? '#2d8659' : '#a33'}`;
      feedback.style.color = '#1E2E26';
      feedback.textContent = msg;
      feedback.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
    // Il popup dei punti. La cifra e' quella VERA quando il server la manda:
    // «ti aspettano gia' 125 punti» batte qualunque aggettivo, e non si puo'
    // smentire. Se il server non la manda, si resta sul valore di una parola
    // sola, che e' comunque vero e non promette niente di piu'.
    // [10/8] LA CIFRA ARRIVA DAL SERVER E NON SI INVENTA PIU'.
    // Prima moltiplicava per venticinque un numero che il server non mandava
    // mai: la frase era quindi sempre la stessa, e da oggi sarebbe anche
    // sbagliata, perche' i valori stanno in configurazione e una parola secca
    // vale meno di una parola fatta bene. Se il server non manda niente, si
    // tace sulla cifra invece di dirne una a caso.
    function apriPopupPunti(email, punti) {
      const pop = document.getElementById('pop-punti');
      if (!pop) return;
      const cifra = document.getElementById('pop-punti-cifra');
      const n = punti && Number(punti.lemmi_pubblicati) || 0;
      const per = punti && Number(punti.per_parola) || 0;
      if (cifra) {
        cifra.textContent = (n > 0 && per > 0)
          ? `ti aspettano già ${n * per} punti`
          : 'i tuoi punti ti aspettano';
      }
      const spiega = document.getElementById('pop-punti-spiega');
      if (spiega && punti) {
        spiega.textContent = 'Una parola con la definizione vera, l’esempio e il paese vale '
          + punti.per_parola_completa + ' punti invece di ' + punti.per_parola
          + '. E una parola detta con la tua voce ne vale ' + punti.per_voce + ': è l’unica cosa, in tutto l’archivio, che se si perde non torna.';
      }
      pop.classList.remove('hidden');
      pop.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }
    function chiudiPopupPunti() {
      const pop = document.getElementById('pop-punti');
      if (!pop) return;
      pop.classList.add('hidden');
      pop.classList.remove('flex');
      document.body.style.overflow = '';
    }
    document.getElementById('pop-punti-chiudi')?.addEventListener('click', chiudiPopupPunti);
    // Si chiude toccando fuori e con Esc: su un telefono il tasto × e' piccolo,
    // e un popup che non si chiude facilmente diventa un fastidio, non un invito.
    document.getElementById('pop-punti')?.addEventListener('click', (ev) => {
      if (ev.target === document.getElementById('pop-punti')) chiudiPopupPunti();
    });
    document.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape') chiudiPopupPunti();
    });

    function utm() {
      const q = new URLSearchParams(location.search);
      const u = { source: q.get('utm_source') || '', medium: q.get('utm_medium') || '', campaign: q.get('utm_campaign') || '' };
      return u.source || u.medium || u.campaign ? u : null;
    }

    // ── IL PAESE CHE NON C'E' NELL'ELENCO ────────────────────────────────
    const comuneSel = form.querySelector('[name=comune_scelta]');
    const comuneAltro = document.getElementById('gu-comune-altro');
    comuneSel?.addEventListener('change', () => {
      const altro = comuneSel.value === '__altro';
      comuneAltro?.classList.toggle('hidden', !altro);
      if (altro) comuneAltro?.focus();
    });
    function comuneScelto() {
      if (!comuneSel) return '';
      return comuneSel.value === '__altro'
        ? (comuneAltro?.value || '').trim()
        : comuneSel.value;
    }

    // ── LA DEFINIZIONE, contata mentre si scrive ─────────────────────────
    // Non e' un capriccio sul numero di caratteri: e' il modo di far vedere,
    // nel momento in cui uno scrive «pipistrello», che manca qualcosa.
    const defEl = form.querySelector('[name=significato]');
    const esEl = form.querySelector('[name=esempio]');
    const defConta = document.getElementById('gu-def-conta');
    // La spia non conta caratteri: dice se la voce si capisce. Ci sono due modi
    // per farla capire, e mostrarne uno solo era il difetto di stamattina.
    function spiegata() {
      const d = (defEl?.value || '').trim();
      const e = (esEl?.value || '').trim();
      return d.length >= 15 || (d.length >= 2 && e.length >= 5);
    }
    function contaDef() {
      if (!defEl || !defConta) return;
      const d = defEl.value.trim();
      if (!d) { defConta.textContent = ''; return; }
      if (spiegata()) {
        defConta.style.color = '#2d8659';
        defConta.textContent = d.length >= 15
          ? 'Così va bene.'
          : 'Va bene: è corta, ma l’esempio qui sotto la spiega.';
      } else {
        defConta.style.color = '#8a6215';
        defConta.textContent = 'È una traduzione. Va benissimo se aggiungi una frase d’esempio qui sotto; altrimenti allunga un po’ la spiegazione.';
      }
    }
    defEl?.addEventListener('input', contaDef);
    esEl?.addEventListener('input', contaDef);

    // ── LA VOCE ───────────────────────────────────────────────────────────
    // MediaRecorder c'e' su iOS dal 14.3 ma con regole sue: il tipo lo sceglie
    // il browser (Safari da' audio/mp4, Chrome audio/webm), e chiederne uno
    // che non conosce fa fallire la costruzione in silenzio. Percio' si prova
    // in ordine e si accetta il predefinito. Se non funziona niente, il
    // caricamento del file resta la strada di riserva, e resta sempre visibile.
    const MAX_SEC = 90;
    let registratore = null;
    let pezzi = [];
    let audioBlob = null;
    let audioNome = 'voce.webm';
    let tSpento = null;
    let partito = 0;
    // [10/8, sera] LA DURATA SI FERMA QUANDO SI FERMA LA REGISTRAZIONE.
    // Veniva calcolata al momento dell'INVIO, come tempo passato da quando si
    // era premuto «Registra»: quindi conteneva anche i minuti spesi a finire il
    // modulo. La prima voce di Monica risulta di tre minuti con un file da venti
    // chilobyte, che sono una decina di secondi. Un archivio linguistico in cui
    // la durata dichiarata non e' la durata vera e' un archivio che mente su un
    // metadato, ed e' il tipo di errore che non si scopre piu'.
    let durataReg = 0;
    // [13/8/2026] La durata di un file CARICATO. Prima si mandava zero, con la
    // spiegazione «di un file caricato non conosciamo la durata»: era vera un
    // passo prima, non qui. Il file passa da `inWav`, che lo DECODIFICA per
    // convertirlo, e a quel punto la durata esatta ce l'abbiamo in mano.
    // Delle dieci voci in attesa, l'unica senza durata e' l'unica caricata.
    let durataDecodificata = 0;
    const btnRec = document.getElementById('au-rec');
    const btnStop = document.getElementById('au-stop');
    const timer = document.getElementById('au-timer');
    const nota = document.getElementById('au-nota');
    const pronta = document.getElementById('au-pronta');
    const play = document.getElementById('au-play');

    if (!navigator.mediaDevices || typeof window.MediaRecorder === 'undefined') {
      btnRec?.classList.add('hidden');
      if (nota) nota.textContent = 'Il tuo browser non registra: puoi comunque caricare un file audio (un memo vocale va benissimo).';
    }

    // ── LA CONVERSIONE, che non è un dettaglio tecnico ──────────────────────
    //
    // [10/8/2026 sera] Le prime cinque voci le ha registrate Monica da Android:
    // Chrome produce WebM con codifica Opus. Apple non lo riproduce. Non è una
    // mancanza del telefono di chi ascolta: perfino il framework audio di macOS
    // si rifiuta di aprire quei file. Il curatore, da iPhone, vedeva «Errore»
    // sopra una registrazione perfettamente integra, e da pubblicata l'avrebbe
    // vista così metà del pubblico.
    //
    // Quindi si converte QUI, sul telefono di chi registra, prima di caricare.
    // Ogni browser sa decodificare cio' che ha registrato lui: Chrome il suo
    // WebM, Safari il suo mp4. Nessuno deve saper leggere il formato di un
    // altro, ed è il motivo per cui questa strada funziona dove un convertitore
    // sul server richiederebbe un'infrastruttura che non abbiamo.
    //
    // Si converte in WAV, non in mp3: è senza compressione, lo apre qualunque
    // programma, e fra trent'anni si aprirà ancora. Per un archivio di voci che
    // devono sopravvivere a chi le ha dette, è la scelta giusta anche a costo
    // di file più grandi.
    //
    // Mono a 24 kHz: metà esatta dei 48 kHz con cui registrano i telefoni,
    // quindi nessun artefatto di ricampionamento, dodici kilohertz di banda
    // (molto più del telefono) e 48 KB al secondo, che tiene i novanta secondi
    // massimi sotto il tetto dei sei megabyte.
    //
    // SE LA CONVERSIONE NON RIESCE SI CARICA L'ORIGINALE. Una voce registrata
    // e persa per un errore di conversione sarebbe il danno peggiore fra i due.
    const HZ = 24000;

    function wavDaCampioni(campioni, hz) {
      const n = campioni.length;
      const buf = new ArrayBuffer(44 + n * 2);
      const v = new DataView(buf);
      const testo = (off, s) => { for (let i = 0; i < s.length; i++) v.setUint8(off + i, s.charCodeAt(i)); };
      testo(0, 'RIFF'); v.setUint32(4, 36 + n * 2, true); testo(8, 'WAVE');
      testo(12, 'fmt '); v.setUint32(16, 16, true); v.setUint16(20, 1, true);
      v.setUint16(22, 1, true); v.setUint32(24, hz, true);
      v.setUint32(28, hz * 2, true); v.setUint16(32, 2, true); v.setUint16(34, 16, true);
      testo(36, 'data'); v.setUint32(40, n * 2, true);
      for (let i = 0; i < n; i++) {
        const c = Math.max(-1, Math.min(1, campioni[i]));
        v.setInt16(44 + i * 2, c < 0 ? c * 0x8000 : c * 0x7fff, true);
      }
      return new Blob([buf], { type: 'audio/wav' });
    }

    async function inWav(blob) {
      const Ctx = window.AudioContext || window.webkitAudioContext;
      if (!Ctx) return null;
      const ctx = new Ctx();
      try {
        const audio = await ctx.decodeAudioData(await blob.arrayBuffer());
        durataDecodificata = Math.max(1, Math.round(audio.duration || 0));
        // Le voci si mescolano in una sola: un archivio linguistico non ha
        // bisogno della stereofonia, e la meta' dello spazio si': si somma e
        // si divide, non si butta via un canale.
        const canali = [];
        for (let c = 0; c < audio.numberOfChannels; c++) canali.push(audio.getChannelData(c));
        const mono = new Float32Array(audio.length);
        for (let i = 0; i < audio.length; i++) {
          let s = 0;
          for (const c of canali) s += c[i];
          mono[i] = s / canali.length;
        }
        // Ricampionamento lineare: scritto a mano perche' OfflineAudioContext
        // su Safari ha avuto per anni limiti sulla frequenza, e qui la cosa
        // che non deve fallire e' proprio Safari.
        const rapporto = audio.sampleRate / hzUtile(audio.sampleRate);
        const quanti = Math.floor(mono.length / rapporto);
        const fuori = new Float32Array(quanti);
        for (let i = 0; i < quanti; i++) {
          const p = i * rapporto;
          const a = Math.floor(p), b = Math.min(a + 1, mono.length - 1);
          fuori[i] = mono[a] + (mono[b] - mono[a]) * (p - a);
        }
        return wavDaCampioni(fuori, hzUtile(audio.sampleRate));
      } catch (_) {
        return null;
      } finally {
        try { ctx.close(); } catch (_) { /* gia' chiuso */ }
      }
    }
    // Non si ricampiona mai VERSO L'ALTO: se la registrazione e' gia' sotto i
    // 24 kHz, inventare campioni non aggiunge niente e pesa il doppio.
    function hzUtile(originale) { return Math.min(HZ, originale); }

    function mostraPronta(blob, nomeFile) {
      audioBlob = blob;
      audioNome = nomeFile;
      if (play) play.src = URL.createObjectURL(blob);
      pronta?.classList.remove('hidden');
      if (nota) nota.textContent = 'Riascoltala: se non ti convince, rifalla. Meglio una registrazione fatta in cucina che nessuna registrazione.';
    }

    btnRec?.addEventListener('click', async () => {
      try {
        const flusso = await navigator.mediaDevices.getUserMedia({ audio: true });
        const tipi = ['audio/webm;codecs=opus', 'audio/webm', 'audio/mp4', 'audio/ogg;codecs=opus', ''];
        let scelto = '';
        for (const t of tipi) {
          if (t === '' || (window.MediaRecorder.isTypeSupported && window.MediaRecorder.isTypeSupported(t))) { scelto = t; break; }
        }
        registratore = scelto ? new window.MediaRecorder(flusso, { mimeType: scelto }) : new window.MediaRecorder(flusso);
        pezzi = [];
        registratore.ondataavailable = (ev) => { if (ev.data && ev.data.size) pezzi.push(ev.data); };
        registratore.onstop = () => {
          flusso.getTracks().forEach((t) => t.stop());
          // Qui, e non all'invio: da qui in poi il tempo che passa e' quello di
          // chi compila il modulo, non quello della voce.
          durataReg = Math.max(1, Math.round((Date.now() - partito) / 1000));
          const tipo = registratore.mimeType || 'audio/webm';
          const est = tipo.indexOf('mp4') >= 0 ? 'm4a' : tipo.indexOf('ogg') >= 0 ? 'ogg' : 'webm';
          const grezzo = new Blob(pezzi, { type: tipo });
          if (nota) nota.textContent = 'Preparo la registrazione…';
          inWav(grezzo).then(function (wav) {
            // Se la conversione non riesce si carica l'originale: una voce
            // registrata e persa per un errore di formato sarebbe il danno
            // peggiore fra i due.
            mostraPronta(wav || grezzo, wav ? 'voce.wav' : 'voce.' + est);
          });
        };
        registratore.start();
        partito = Date.now();
        btnRec.classList.add('hidden');
        btnStop?.classList.remove('hidden');
        pronta?.classList.add('hidden');
        if (nota) nota.textContent = 'Sto registrando. Dì la parola, poi ferma.';
        tSpento = setInterval(() => {
          const s = Math.floor((Date.now() - partito) / 1000);
          if (timer) timer.textContent = s + 's';
          // Trenta secondi per una parola, un minuto e mezzo per una frase.
          // Non e' un archivio di interviste: quello e' un'altra cosa.
          if (s >= MAX_SEC) btnStop?.click();
        }, 250);
      } catch (err) {
        if (nota) nota.textContent = 'Non riesco ad accedere al microfono. Controlla il permesso nel browser, oppure carica un file audio.';
      }
    });

    btnStop?.addEventListener('click', () => {
      if (tSpento) { clearInterval(tSpento); tSpento = null; }
      try { registratore && registratore.state !== 'inactive' && registratore.stop(); } catch { /* gia' fermo */ }
      btnStop.classList.add('hidden');
      btnRec?.classList.remove('hidden');
    });

    document.getElementById('au-rifai')?.addEventListener('click', () => {
      audioBlob = null;
      durataReg = 0;
      pronta?.classList.add('hidden');
      if (timer) timer.textContent = '';
      if (nota) nota.textContent = '';
    });

    document.getElementById('au-file')?.addEventListener('change', (ev) => {
      const f = ev.target.files && ev.target.files[0];
      if (!f) return;
      if (f.size > 6 * 1024 * 1024) {
        if (nota) nota.textContent = 'Il file è troppo grande: al massimo 6 MB. Per una parola bastano pochi secondi.';
        return;
      }
      // La durata la scopre `inWav` decodificando: si azzera qui e si riprende
      // dopo la conversione. Se il browser non sa decodificare il file resta
      // zero, che a database diventa null — meglio un dato assente di uno
      // inventato, che resta la regola.
      durataReg = 0;
      durataDecodificata = 0;
      if (nota) nota.textContent = 'Preparo il file…';
      inWav(f).then(function (wav) {
        // Anche i file caricati passano dalla conversione: un ogg/opus mandato
        // da un telefono Android sarebbe muto su iPhone esattamente come una
        // registrazione. Se il browser non sa decodificarlo, si tiene com'e'.
        if (durataDecodificata > 0) durataReg = durataDecodificata;
        mostraPronta(wav || f, wav ? 'voce.wav' : (f.name || 'voce'));
      });
    });

    document.querySelectorAll('[name=au_chi]').forEach((r) => r.addEventListener('change', () => {
      document.getElementById('au-altri')?.classList.toggle('hidden', r.value !== 'altri' || !r.checked);
    }));

    async function mandaVoce(lemmaId) {
      if (!audioBlob || !lemmaId) return null;
      const altri = document.querySelector('[name=au_chi]:checked')?.value === 'altri';
      const parlante = (document.getElementById('au-parlante')?.value || '').trim();
      const consenso = !!document.getElementById('au-consenso')?.checked;
      if (altri && (!parlante || !consenso)) {
        return 'Per la voce di un’altra persona servono il nome e la conferma del consenso: la parola è arrivata lo stesso, la voce no.';
      }
      const fd = new FormData();
      fd.append('audio', audioBlob, audioNome);
      fd.append('lemma_id', lemmaId);
      fd.append('voce_di_altri', altri ? 'true' : 'false');
      fd.append('nome_parlante', parlante);
      fd.append('consenso_parlante', consenso ? 'true' : 'false');
      fd.append('anonimo', document.getElementById('au-anonimo')?.checked ? 'true' : 'false');
      fd.append('portato_da_nome', (form.querySelector('[name=nome]')?.value || '').trim());
      fd.append('portato_da_email', (form.querySelector('[name=email]')?.value || '').trim());
      fd.append('durata', String(durataReg || 0));
      fd.append('mime', audioBlob.type || '');
      try {
        const r = await fetch(form.dataset.audio, { method: 'POST', body: fd });
        const d = await r.json().catch(() => ({}));
        // Si dice com'e' andata davvero: una voce data per salvata e persa e'
        // peggio di una voce mai chiesta.
        return d && d.ok ? null : 'La parola è arrivata, la voce no: ' + (d.dettaglio || d.errore || 'errore sconosciuto') + '. Puoi riprovare dalla scheda quando sarà pubblicata.';
      } catch {
        return 'La parola è arrivata, la voce no (errore di rete). Riprova più tardi.';
      }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      feedback.classList.add('hidden');
      const g = (n: string) => (form.querySelector(`[name=${n}]`) as HTMLInputElement);
      const payload = {
        termine: g('termine').value.trim(), significato: g('significato').value.trim(),
        variante: g('variante').value, tipo: g('tipo').value,
        comune: comuneScelto(), esempio: g('esempio').value.trim(),
        categoria: g('categoria').value, etimologia: g('etimologia').value.trim(),
        proverbi: g('proverbi').value.trim(),
        nome: g('nome').value.trim(), email: g('email').value.trim(),
        consenso_glossario: g('consenso_glossario').checked,
        licenza_accettata: g('licenza_accettata').checked,
        consenso_firma: g('consenso_firma').checked,
        consenso_marketing: g('consenso_marketing').checked,
        _honeypot: (form.querySelector('[name=_honeypot]') as HTMLInputElement).value,
        _ts: aperto, utm: utm(),
      };
      if (!payload.termine) return mostra('Scrivi il termine.', false);
      if (!payload.variante || !payload.tipo) return mostra('Scegli parlata e tipo.', false);
      if (!payload.comune) return mostra('Dicci in che paese si dice: una parola senza il luogo perde metà del suo valore.', false);
      if (payload.significato.length < 2) return mostra('Scrivi che cosa vuol dire in italiano.', false);
      if (!spiegata()) return mostra('Manca la spiegazione, e ci sono due modi per darla: una riga che spieghi la cosa («il pipistrello, che d’estate esce al tramonto dai fienili» invece di «pipistrello»), oppure, per le parole che un giro di parole non spiega come «abbastanza», una frase d’esempio in cui la parola compare.', false);
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(payload.email)) return mostra('Email non valida.', false);
      if (!payload.consenso_glossario || !payload.licenza_accettata) return mostra('Servono il consenso al glossario e l’accettazione della licenza.', false);
      invia.disabled = true; invia.textContent = 'Invio…';
      try {
        const r = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        const d = await r.json().catch(() => ({}));
        if (r.ok && d.success) {
          const guaioVoce = await mandaVoce(d.lemma_id);
          mostra(guaioVoce
            ? guaioVoce
            : (audioBlob
              ? 'Grazie! La parola e la tua voce sono arrivate: un curatore le controlla e appena validate entrano nel glossario.'
              : 'Grazie! Il tuo contributo è arrivato: un curatore lo controlla e appena validato entra nel glossario.'),
            !guaioVoce);
          // [8/8] Il momento in cui la persona ha appena dato qualcosa e' l'unico
          // in cui un invito non suona come una richiesta. Il popup arriva qui e
          // in nessun altro punto della pagina.
          apriPopupPunti(payload.email, d.punti);
          form.reset();
          audioBlob = null;
          pronta?.classList.add('hidden');
          if (timer) timer.textContent = '';
          if (defConta) defConta.textContent = '';
          comuneAltro?.classList.add('hidden');
        }
        else mostra(d.error || 'Si è verificato un errore: riprova o scrivi a info@elbrenz.eu.', false);
      } catch { mostra('Errore di rete: riprova.', false); }
      finally { invia.disabled = false; invia.textContent = 'Invia il contributo'; }
    });
  }
  // glossario vivo: ricerca + filtro parlata (client-side)
  const cerca = document.getElementById('gloss-cerca') as HTMLInputElement | null;
  const filtro = document.getElementById('gloss-filtro') as HTMLSelectElement | null;
  const vuoto = document.getElementById('gloss-vuoto');
  const fComune = document.getElementById('gloss-comune') as HTMLSelectElement | null;
  const fTipo = document.getElementById('gloss-tipo') as HTMLSelectElement | null;
  let lettera = '';
  // Stessa normalizzazione della chiave: senza, «perche'» non troverebbe
  // «perche» e chi cerca penserebbe che la parola non c'e'.
  const norma = (t: string) => t.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim();
  function applica() {
    const q = norma(cerca?.value ?? '');
    const v = filtro?.value ?? '';
    const c = fComune?.value ?? '';
    const tp = fTipo?.value ?? '';
    let visibili = 0;
    document.querySelectorAll<HTMLElement>('.gloss-voce').forEach((li) => {
      const eDetto = (li.dataset.tipo ?? 'parola') !== 'parola';
      const ok = (!q || (li.dataset.t ?? '').includes(q)) && (!v || li.dataset.v === v)
        && (!c || li.dataset.c === c)
        && (!tp || (tp === 'detto' ? eDetto : !eDetto))
        && (!lettera || li.dataset.l === lettera);
      li.style.display = ok ? '' : 'none';
      if (ok) visibili++;
    });
    vuoto?.classList.toggle('hidden', visibili > 0);
  }
  cerca?.addEventListener('input', applica);
  filtro?.addEventListener('change', applica);
  fComune?.addEventListener('change', applica);
  fTipo?.addEventListener('change', applica);
  // L'indice alfabetico: in un dizionario e' il modo naturale di girare le
  // pagine. Ricliccando la stessa lettera si torna a tutte.
  document.querySelectorAll<HTMLElement>('.gloss-lettera').forEach((b) => {
    b.addEventListener('click', () => {
      lettera = lettera === b.dataset.lettera ? '' : (b.dataset.lettera ?? '');
      document.querySelectorAll<HTMLElement>('.gloss-lettera').forEach((x) => {
        x.style.background = x.dataset.lettera === lettera ? '#C8923E' : 'transparent';
      });
      applica();
    });
  });
</script>
