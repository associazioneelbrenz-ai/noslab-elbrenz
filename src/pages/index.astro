---
/**
 * Home — El Brenz da le Val del Nos
 *
 * Hero identitario: titolo principale + motto in ladino + 2 CTA.
 * Niente articoli dinamici (saranno in M2).
 */

import Layout from '../layouts/Layout.astro';
import FirmaIstituzionale from '../components/FirmaIstituzionale.astro';

// [10/8/2026] LA HOME NON SI FISSA PIU' AL BUILD.
//
// Era generata una volta sola, e la conseguenza peggiore non erano i caroselli
// vecchi: era la card della gita. Lo stato lo decide `config_app`, ma qui si
// congelava alla ricostruzione, tanto che il commento qui sotto avvertiva
// «per riaprire una gita non basta cambiare il DB, serve un deploy». Vale anche
// al contrario, ed e' peggio: chiudendo la gita in configurazione, questa
// pagina avrebbe continuato a invitare la gente a pagare centoventi euro
// finche' qualcuno non ricostruiva il sito.
//
// Ora si compone quando qualcuno la chiede, e a frenare le invocazioni ci pensa
// la CDN invece del build: cinque minuti di cache condivisa piu' un giorno di
// stale-while-revalidate. Tutti chiedono lo stesso indirizzo, quindi e' la
// pagina dove la cache rende di piu': mille visite costano quanto una.
//
// Si puo' mettere in cache CONDIVISA perche' qui dentro non c'e' niente di
// personale: si leggono solo viste pubbliche e configurazione. Il giorno che
// questa pagina dovesse mostrare qualcosa che dipende da chi guarda, questa
// riga va tolta prima di quel giorno, non dopo.
export const prerender = false;

Astro.response.headers.set('Cache-Control', 'public, max-age=60');
Astro.response.headers.set(
  'Netlify-CDN-Cache-Control',
  'public, s-maxage=300, stale-while-revalidate=86400',
);

// M2.6-bis: box "Sostieni El Brenz" — esiste in pagina SOLO col flag
// go-live pagamenti attivo (build time, vedi src/lib/pagamenti.ts).
import { PAGAMENTI_LIVE } from '../lib/pagamenti';
import LightboxEmbed from '../components/LightboxEmbed.astro';
// Interstitial locandina Ritterspiele (solo home; si auto-disattiva dopo il
// 14/8/2026 e a posti esauriti — vedi il componente).
import PopupLocandinaRitterspiele from '../components/PopupLocandinaRitterspiele.astro';
import { createClient } from '@supabase/supabase-js';
import fs from 'node:fs';
// Cimiteri di guerra in home (addendum "Albo dei nomi, incipit, card in
// home", 26/8/2026 §5.2): testo definitivo, non più due conteggi calcolati
// al volo — i numeri (114, 49, 55...) sono fatti fissi del fondo di Malè,
// non cambiano con un secondo fondo come cambiava il vecchio conteggio.
import { OG_CIMITERI_ORIZZONTALE } from '../lib/memoria';

// M2.9 (deroga 8/7/2026): quando Cristian fornisce gli URL dei 3 post
// Instagram delle migole, inserirli qui: le celle diventano embed
// click-to-load (un click carica tutte e tre — il consenso vale per il
// provider). Finché è null restano le thumbnail statiche self-hosted.
function migoleUrls(): [string, string, string] | null {
  // M2.9-bis: reel PUBBLICI forniti da Cristian l'8/7/2026 (senza ?igsh=,
  // che è tracking di condivisione). Formato verticale → rapporto 9:16.
  return [
    'https://www.instagram.com/reel/DaK4JBVMQAE/',
    'https://www.instagram.com/reel/DZe6NM8MxxI/',
    'https://www.instagram.com/reel/DS5Vl-RjC84/',
  ];
}
const MIGOLE_POST_URLS = migoleUrls();

// M2.9-ter: copertine dei reel. Path FISSI — quando Cristian carica
// public/social/migole/migola-{1,2,3}.jpg basta una rebuild, zero
// modifiche al codice. Finché mancano, restano i placeholder brandizzati
// già esistenti (migola-0N.webp). Il check è a build time (SSG).
function copertinaMigola(n: number): string {
  return fs.existsSync(`public/social/migole/migola-${n}.jpg`)
    ? `/social/migole/migola-${n}.jpg`
    : `/social/migole/migola-0${n}.webp`;
}

// M2.9-ter (rifinitura): titoli VISIBILI sulle copertine (fascia alta).
const MIGOLE_ETICHETTE = ['Storia delle valli', 'Parlate ladine', 'Memoria e radici'];

// AGGIUNTA M2.4 (home ricca): blocco "Ultimi articoli".
// Riusa gli helper di lib/articoli e lo stesso filtro produzione di
// PaginaPilastro (!draft && !archivio). Ordinamento data desc, primi 4.
import { createClient } from '@supabase/supabase-js';
// getCollection serve ancora, ma solo per la collection `eventi` (i NOSTRI
// appuntamenti in home): gli articoli non passano piu' di qui.
import { getCollection } from 'astro:content';
import { statoGita } from '../lib/postiGita';
import { formatDataIT, nomePilastro } from '../lib/articoli';
import { schemaOrganization } from '../lib/schema';
import { imgRid, srcSetCard } from '../lib/immagini';
import { MIGOLE, miniatura, embed } from '../data/video';
import CardDdl1539 from '../components/CardDdl1539.astro';
import IndicatoreScorri from '../components/IndicatoreScorri.astro';

// [3/8/2026] Stato della gita: fonte unica config_app, la stessa che consulta
// l'edge gita-crea-ordine. La home non deve invitare a pagare un viaggio che
// non si fa. [10/8/2026] La pagina non e' piu' prerenderizzata: il valore si
// legge a ogni composizione, quindi aprire o chiudere una gita e' un UPDATE e
// non un deploy. Era il difetto piu' caro di tutta la home.
// [4/8/2026, secondo giro] Tre esiti, non due, e la build NON si ferma piu'.
// Fermarla era la difesa contro il congelamento di «annullata» in una pagina
// generata una volta; ma bloccare l'intero deploy per un dato solo punisce
// anche tutto il resto del sito. Adesso la card della gita resta, e sparisce
// SOLO il pezzo che dipende dal dato: niente contatore, niente «Annullata»,
// niente invito. La traccia resta nel log della build, che `statoGita` scrive
// a voce alta.
const statoGitaOra = await statoGita();
const gitaAnnullata = statoGitaOra === 'annullata';
const gitaAperta = statoGitaOra === 'aperta';
// [24/8/2026] Conclusa != annullata: la data e' passata, l'evento si e'
// svolto. Niente invito a iscriversi (gitaAperta e' gia' false), ma nemmeno
// il badge rosso "Annullata", che sarebbe falso.
const gitaConclusaOra = statoGitaOra === 'conclusa';

// MODIFICA 2/8/2026 — anche la home legge dalla vista, come /articoli,
// /articoli/<slug> e /archivio-storico. Prima passava dal ponte
// legacy_wp_id -> v_articoli_seo per recuperare le copertine, ed era rimasta
// la seconda strada verso gli stessi dati: due sorgenti che possono divergere
// sono un guasto che aspetta il suo giorno.
//
// Il ponte non serve piu': `immagine_copertina_url` sta sulla stessa riga, e
// vale sia per gli articoli migrati sia per quelli nuovi. Era proprio il
// problema visto l'1/8, quando un pezzo appena scritto restava senza immagine
// in mezzo alle altre tre perche' non aveva un legacy_wp_id.
//
// Stesso filtro di prima: produzione, cioe' non archiviati.
const SB_ART_URL = import.meta.env.PUBLIC_SUPABASE_URL || 'https://wacknihvdjxltiqvxtqr.supabase.co';
const SB_ART_ANON = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';

let ultimiArticoli: any[] = [];
try {
  const sbArt = createClient(SB_ART_URL, SB_ART_ANON, { auth: { persistSession: false } });
  const { data } = await sbArt
    .from('v_articoli_pubblici')
    .select('slug, titolo, estratto, immagine_copertina_url, pilastro, pubblicato_at, noindex, archivio')
    .eq('archivio', false)
    .order('pubblicato_at', { ascending: false })
    .limit(8);
  ultimiArticoli = ((data as any[]) ?? [])
    .filter((a) => a.slug && a.noindex !== true)
    .slice(0, 4)
    .map((a) => ({
      id: a.slug,
      data: {
        title: a.titolo,
        excerpt: a.estratto ?? '',
        pilastro: a.pilastro ?? '_da_assegnare',
        data_pubblicazione: a.pubblicato_at ? new Date(a.pubblicato_at) : new Date(0),
        copertina: a.immagine_copertina_url ?? null,
      },
    }));
} catch (e) {
  console.error('[home] lettura articoli fallita:', e);
}

// Le card con immagine si notano molto piu' di quelle di solo testo. Chi non
// ha copertina resta testuale, senza riempitivi finti.
const copertinaDi = (a: any): string | null => a.data.copertina

// AGGIUNTA 2/8/2026 — la mappa in prima fila (brief attuativo IV.5).
// Conteggio e pin letti al build da v_luoghi_mappa: il numero non si scrive
// mai a mano (un numero scritto a mano diventa falso e nessuno se ne
// accorge), e i pin sono SOLO i sei curati con in_anteprima — la Val di Non
// pesa 35 luoghi su 57 e un'anteprima non curata mostrerebbe quasi solo lei.
let luoghiTotale = 0;
type LuogoVetrina = {
  nome: string; slug: string; categoria: string; valle: string;
  descrizione_breve: string | null; lat: number; lng: number; colore: string;
};
let pinAnteprima: LuogoVetrina[] = [];
// Tavolozza per categoria (brief 3/8): castelli oro scuro, chiese verde,
// Grande Guerra mattone, cultura materiale bruno, natura verde chiaro,
// musei grigio ardesia. Sobria di proposito: non deve litigare col marchio.
const COLORE_CAT: Record<string, string> = {
  castelli_e_residenze: '#b0872f', chiese_e_santuari: '#4b6b42',
  grande_guerra: '#8a3a3a', cultura_materiale: '#7a5c3a',
  natura_e_paesaggio: '#7fa05a', musei_e_collezioni: '#5c6b73',
};
// Nomi leggibili: sul sito non compaiono mai gli identificativi del database.
const NOME_CAT: Record<string, string> = {
  castelli_e_residenze: 'Castelli e residenze', chiese_e_santuari: 'Chiese e santuari',
  grande_guerra: 'Grande Guerra', natura_e_paesaggio: 'Natura e paesaggio',
  cultura_materiale: 'Cultura materiale', musei_e_collezioni: 'Musei',
};
const NOME_VALLE: Record<string, string> = {
  val_di_non: 'Val di Non', val_di_sole: 'Val di Sole',
  val_di_rabbi: 'Val di Rabbi', val_di_pejo: 'Val di Pejo',
};
// Le pastiglie sono l'ordine deciso nel brief, non l'ordine del database.
const PASTIGLIE_CAT = [
  'castelli_e_residenze', 'chiese_e_santuari', 'grande_guerra',
  'natura_e_paesaggio', 'cultura_materiale', 'musei_e_collezioni',
];
try {
  const sbLuoghi = createClient(SB_ART_URL, SB_ART_ANON, { auth: { persistSession: false } });
  const { data } = await sbLuoghi
    .from('v_luoghi_mappa')
    .select('nome, slug, categoria, valle, descrizione_breve, lat, lng, in_anteprima')
    .order('valle').order('nome');
  const righe = (data as any[]) ?? [];
  luoghiTotale = righe.length;
  pinAnteprima = righe
    .filter((l) => l.in_anteprima === true && l.lat && l.lng)
    .map((l) => ({
      nome: l.nome, slug: l.slug, categoria: l.categoria, valle: l.valle,
      descrizione_breve: l.descrizione_breve,
      lat: l.lat, lng: l.lng, colore: COLORE_CAT[l.categoria] ?? '#C8923E',
    }));
} catch (e) {
  console.error('[home] lettura luoghi fallita:', e);
}

/** Tronca l'excerpt a ~160 caratteri per la card, con ellissi. */
function troncaExcerpt(testo: string): string {
  return testo.length > 160 ? `${testo.slice(0, 157).trimEnd()}…` : testo;
}

// AGGIUNTA M2.4 — blocco "Prossimi eventi" dalla collection eventi:
// data >= oggi (mezzanotte del giorno di build, SSG), niente bozze né
// annullati, ordinati per data ascendente, max 3. Con collection vuota
// il template mostra il fallback testuale, la sezione non sparisce.
const oggi = new Date();
oggi.setHours(0, 0, 0, 0);

const eventiFuturi = (
  await getCollection('eventi', ({ data }) => !data.bozza && !data.annullato)
)
  .filter((e) => e.data.data.getTime() >= oggi.getTime())
  .sort((a, b) => a.data.data.getTime() - b.data.data.getTime())
  .slice(0, 3);

// Countdown posti gita: la barra è popolata a runtime (client) leggendo la
// vista pubblica aggregata v_posti_gita (solo conteggi, nessun dato personale).
const SB_URL = import.meta.env.PUBLIC_SUPABASE_URL || 'https://wacknihvdjxltiqvxtqr.supabase.co';
const SB_ANON = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';

/** Data compatta per il riquadro della card evento, es. { giorno: "12", mese: "SET", anno: "2026" }. */
function dataCompattaEvento(data: Date): { giorno: string; mese: string; anno: string } {
  return {
    giorno: new Intl.DateTimeFormat('it-IT', { day: 'numeric' }).format(data),
    mese: new Intl.DateTimeFormat('it-IT', { month: 'short' })
      .format(data)
      .replace('.', '')
      .toUpperCase(),
    anno: String(data.getFullYear()),
  };
}

// M5.0 (10/7/2026) — marquee "Con noi nelle valli": loghi delle convenzioni
// ATTIVE letti a BUILD TIME dalla vista pubblica (i futuri loghi entrano da
// soli al rebuild). Per la striscia serve la variante orizzontale: derivata
// per convenzione di naming (-payoff/-vert -> -orizz, preferendo .webp);
// se il file ha un nome diverso resta il logo originale. Se 0 attive con
// logo, la sezione non si renderizza.
type ConvenzioneMarquee = { nome_attivita: string; logo_path: string | null };
let convenzionateMarquee: { nome: string; src: string }[] = [];
try {
  const sb = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL as string,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string,
    { auth: { persistSession: false } },
  );
  const { data } = await sb.from('convenzioni_pubbliche')
    .select('nome_attivita, logo_path')
    .order('nome_attivita', { ascending: true });
  convenzionateMarquee = ((data as ConvenzioneMarquee[]) ?? [])
    .filter((c) => c.logo_path)
    .map((c) => ({
      nome: c.nome_attivita,
      src: `${import.meta.env.PUBLIC_SUPABASE_URL}/storage/v1/object/public/assets-pubblici/${
        (c.logo_path as string).replace(/-(payoff|vert)\.(png|webp)$/, '-orizz.webp')
      }`,
    }));
} catch (e) {
  console.error('[home] marquee convenzioni: lettura fallita:', e);
  convenzionateMarquee = [];
}
// FIX mobile 10/7 (Safari iOS): niente lazy sulle immagini del nastro e
// width/height ESPLICITI (le img dentro un transform non vengono osservate
// dal lazy-load di Safari: restavano scariche e, senza dimensioni
// intrinseche, collassavano a larghezza zero -> striscia vuota).
// Dimensioni lette a BUILD TIME dagli header PNG/WebP dei loghi.
async function dimensioniLogo(url: string): Promise<{ w: number; h: number }> {
  try {
    const r = await fetch(url);
    const b = new Uint8Array(await r.arrayBuffer());
    const dv = new DataView(b.buffer);
    if (b[0] === 0x89 && b[1] === 0x50) {
      return { w: dv.getUint32(16), h: dv.getUint32(20) }; // PNG IHDR
    }
    if (b[8] === 0x57 && b[9] === 0x45) { // RIFF....WEBP
      const fourcc = String.fromCharCode(b[12], b[13], b[14], b[15]);
      if (fourcc === 'VP8X') {
        return { w: 1 + (b[24] | (b[25] << 8) | (b[26] << 16)), h: 1 + (b[27] | (b[28] << 8) | (b[29] << 16)) };
      }
      if (fourcc === 'VP8L') {
        const n = dv.getUint32(21, true);
        return { w: 1 + (n & 0x3fff), h: 1 + ((n >> 14) & 0x3fff) };
      }
      if (fourcc === 'VP8 ') {
        return { w: dv.getUint16(26, true) & 0x3fff, h: dv.getUint16(28, true) & 0x3fff };
      }
    }
  } catch (e) {
    console.error('[home] marquee: dimensioni logo non lette:', url, e);
  }
  return { w: 200, h: 64 }; // fallback prudente: evita comunque il collasso
}
const marqueeConDim = await Promise.all(
  convenzionateMarquee.map(async (c) => ({ ...c, ...(await dimensioniLogo(c.src)) })),
);

// Il singolo gruppo deve essere SEMPRE piu' largo del viewport (>=1440px di
// sicurezza, anche a 320px): ripetizioni calcolate sulla larghezza RESA
// (h mobile 64px + gap 96px). Con piu' convenzioni attive scenderanno da sole.
const larghezzaSet = marqueeConDim.reduce((t, c) => t + (c.w * 64) / c.h + 96, 0);
const nRipetizioni = Math.max(1, Math.ceil(1440 / Math.max(1, larghezzaSet)));
const filaMarquee = marqueeConDim.length > 0
  ? Array.from({ length: nRipetizioni }, () => marqueeConDim).flat()
  : [];
const marqueeRipetute = filaMarquee.slice(marqueeConDim.length);
// durata proporzionale alla lunghezza della fila (~5s per logo, rif. 40s/8)
const durataMarquee = `${filaMarquee.length * 5}s`;

// Guardiani de la lenga: card in home dietro flag (default OFF).
const GUARDIANI_LIVE = import.meta.env.GUARDIANI_LIVE === 'true';

// RIDISEGNO HOME · Blocco B (27/7/2026) — classi condivise delle card-progetto
// della griglia DESKTOP (>=1024px). Card ad altezze uguali (flex-col + h-full),
// immagine ad aspect ratio uniforme (object-cover), testo troncato a 3 righe
// (line-clamp), CTA sempre in fondo (mt-auto). Hover sobrio + reduced-motion.
const PCARD = "flex flex-col h-full bg-[#F5EEDD] rounded-md border border-[#C8923E]/50 overflow-hidden transition-[transform,box-shadow] duration-200 hover:-translate-y-1 hover:border-[#C8923E] hover:shadow-[0_14px_34px_rgba(30,46,38,0.16)] motion-reduce:transition-none motion-reduce:hover:translate-y-0";
const PMEDIA = "aspect-[16/9] overflow-hidden bg-[#1E2E26]";
const PIMG = "w-full h-full object-cover";
const PBODY = "flex flex-col flex-1 p-7";
const PTITLE = "text-2xl leading-snug m-0 mb-3 text-[#1E2E26]";
const PTEXT = "text-[15px] text-[#1E2E26]/80 leading-relaxed m-0 line-clamp-3";
const PFOOT = "mt-auto pt-6";
const PCTA = "inline-block bg-[#C8923E] text-[#1E2E26] px-6 py-3 text-sm font-medium tracking-wider uppercase no-underline rounded hover:bg-[#D9A94E] transition-colors focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#C8923E]";
const PEYE = "text-[10px] tracking-[0.18em] uppercase text-[#8a6215] font-semibold m-0 mb-2";
const PSUB = "mt-3 m-0 text-sm text-[#1E2E26]/60 truncate";
const PILL_ORO = "text-[11px] tracking-[0.14em] uppercase border border-[#C8923E]/60 text-[#D9A94E] px-3 py-1";
const PILL_TENUE = "text-[11px] tracking-[0.14em] uppercase border border-[#F5EEDD]/25 text-[#F5EEDD]/75 px-3 py-1";
---
<Layout ogImage="/og/og-home.jpg"
  title="El Brenz da le Val del Nos"
  description="Associazione Storico Culturale Linguistica El Brenz delle Valli del Noce. Custodiamo la lingua ladino-anaunica e la storia di Val di Non, Val di Sole, Val di Rabbi e Val di Pejo."
>

  {/* A5 — dati strutturati dell'ente (una sola volta, in home) */}
  <script type="application/ld+json" set:html={JSON.stringify(schemaOrganization())} />

  {/* PROVA (14/7): richiamo laterale — logo El Brenz dorato che pulsa, porta al
      tesseramento. Fisso a sinistra, si espande in "Diventa socio" all'hover.
      Nascosto su mobile per non coprire i contenuti; reduced-motion safe. */}
  <a href="/tesseramento" class="eb-side-cta hidden md:flex" aria-label="Diventa socio di El Brenz" title="Diventa socio">
    <img src="/logo-eb-header@2x.png" alt="" width="44" height="44" decoding="async" />
    <span class="eb-side-cta__label">Diventa socio</span>
  </a>

  <section class="relative bg-[#1E2E26] text-[#F5EEDD] overflow-hidden">

    {/* AGGIUNTA hero foto (M2.5): lago alpino come sfondo, sotto un overlay
        verde brand a gradiente (più chiaro in alto, più scuro verso il basso)
        per leggibilità del testo avorio e degli accenti oro. Il bg-[#1E2E26]
        della section resta come fallback durante il caricamento. */}
    {/* WebP ottimizzate (mobile 828w ~137K, desktop 1600w ~387K) con
        fallback JPEG originale per i browser senza supporto WebP. */}
    <picture>
      <source media="(max-width: 767px)" srcset="/hero-lago-mobile.webp" type="image/webp" />
      <source srcset="/hero-lago.webp" type="image/webp" />
      <img
        src="/hero-lago.jpg"
        alt=""
        aria-hidden="true"
        class="absolute inset-0 w-full h-full object-cover pointer-events-none"
        width="2048"
        height="1536"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <div
      class="absolute inset-0 pointer-events-none bg-gradient-to-b from-[#1E2E26]/65 via-[#1E2E26]/75 to-[#1E2E26]/90"
      aria-hidden="true"
    ></div>

    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 1200 400"
        preserveAspectRatio="none"
        class="absolute bottom-0 left-0 right-0 w-full h-2/3"
      >
        <path
          d="M0,400 L0,260 L140,180 L260,230 L380,120 L520,200 L680,100 L820,220 L960,150 L1100,260 L1200,200 L1200,400 Z"
          fill="#192821"
          opacity="0.7"
        />
        <path
          d="M0,400 L0,320 L200,260 L380,300 L560,220 L740,300 L920,240 L1100,320 L1200,280 L1200,400 Z"
          fill="#0F1D18"
          opacity="0.85"
        />
      </svg>
    </div>

    {/* [9/8] EROE PIU' CORTO SU TELEFONO.
     Michele riferisce che molti guardano il titolo e chiudono. La causa non
     e' che manchi un invito: e' che la prima schermata sembra una pagina
     intera, e niente lascia intuire che sotto continui. Nessuna freccia
     convince quanto VEDERE che qualcosa comincia.
     Qui si tagliano solo le spaziature del telefono - erano 416px di margini
     prima ancora dei contenuti - perche' il fondo crema della sezione
     successiva spunti sotto i pulsanti. Ogni valore `md:` resta invariato:
     sul grande la pagina non cambia di un pixel. */}
