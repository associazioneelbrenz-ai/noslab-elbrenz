  }
  .eb-cta-socio:hover,
  .eb-cta-socio:focus-visible { animation-play-state: paused; }
  .eb-cta-socio:hover { box-shadow: 0 12px 30px rgba(200,146,62,0.65); }
  @keyframes ebCtaBreath {
    0%, 100% { transform: scale(1);     box-shadow: 0 8px 22px rgba(200,146,62,0.45), 0 0 0 0 rgba(217,169,78,0.6); }
    50%      { transform: scale(1.05);  box-shadow: 0 12px 30px rgba(200,146,62,0.6), 0 0 0 14px rgba(217,169,78,0); }
  }
  @keyframes ebCtaShine {
    0%       { transform: translateX(-130%); }
