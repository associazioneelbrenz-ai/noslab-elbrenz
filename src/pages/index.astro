<style>
  /* [3/8/2026] Vetrina della mappa in home (brief blocco 2).
     Da 1024px: colonna schede fissa a 300px + mappa per il resto, alta 340px.
     Sotto: la mappa sta sopra (200px) e le schede scorrono in orizzontale con
     lo snap, una e mezza per volta, cosi' si capisce a occhio che si scorre. */
  .eb-vetrina-mappa { display: grid; gap: 16px; }
  .eb-vetrina-mappa-cornice {
    position: relative; overflow: hidden; border-radius: 6px;
    border: 1px solid #E5DFCF; background: #F5EEDD; height: 200px;
  }
  .eb-vetrina-schede {
    display: flex; gap: 12px; overflow-x: auto;
    scroll-snap-type: x mandatory;
    margin-inline: -24px; padding-inline: 24px; padding-bottom: 6px;
  }
  .eb-vetrina-scheda-li { scroll-snap-align: start; flex: 0 0 66%; min-width: 0; }
  .eb-vetrina-scheda { height: 100%; }
  /* Una riga sola, tagliata dal browser: mai troncare a mano nel codice, il
     testo a database resta intero e chi legge con lo screen reader lo sente. */
  .eb-una-riga {
    display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (min-width: 1024px) {
    .eb-vetrina-mappa {
      grid-template-columns: 300px 1fr;
      grid-template-areas: "schede mappa";
      align-items: start; gap: 24px;
    }
    /* Il brief fissa 340px. Con sei schede da tre righe la colonna arriva a
       circa 620px, e una mappa alta 340 lascia un buco a destra grande quanto
       due schede. Qui 340 diventa il MINIMO e la mappa accompagna la colonna:
       il numero del brief e' rispettato come pavimento, non come gabbia. */
    .eb-vetrina-mappa { align-items: stretch; }
    .eb-vetrina-mappa-cornice { grid-area: mappa; height: auto; min-height: 340px; }
    .eb-vetrina-schede {
      grid-area: schede; display: flex; flex-direction: column;
      overflow: visible; margin-inline: 0; padding-inline: 0; padding-bottom: 0;
    }
    .eb-vetrina-scheda-li { flex: 0 0 auto; }
  }
  /* Evidenziazione a due vie fra scheda e marker: sulla scheda in evidenza il
     bordo si accende, sul marker corrispondente il pin cresce. Su touch non
     scatta ed e' giusto cosi', non e' essenziale. */
  .eb-vetrina-scheda.eb-in-evidenza { border-color: #C8923E; background: #FDF9F0; }
</style>

<style is:global>
  /* Etichette permanenti accanto ai pin della vetrina: leggibili sull'OSM
     chiaro senza il fumetto pieno di Leaflet, che sarebbe troppo pesante per
     sei nomi tutti accesi insieme. Sotto i 768px non vengono nemmeno create
     (lo decide lo script), qui restano solo le regole d'aspetto. */
  .eb-vetrina-etichetta {
    background: rgba(245, 238, 221, .92);
    border: 1px solid rgba(200, 146, 62, .55);
    border-radius: 4px;
    color: #1E2E26;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 600;
    padding: 2px 7px;
    box-shadow: 0 1px 4px rgba(30, 46, 38, .18);
    white-space: nowrap;
  }
  .eb-vetrina-etichetta::before { display: none; }

  /* Queste due vivono qui e non nel blocco scopato perche' gli elementi a cui
     si applicano li crea Leaflet a runtime: non portano l'attributo di scope
     di Astro, e una regola scopata non li toccherebbe mai. */
  .eb-pin-vetrina { transition: transform .18s ease; transform-origin: 50% 100%; display: inline-block; }
  .eb-pin-vetrina.eb-in-evidenza { transform: scale(1.35); }
  /* L'attribuzione OSM resta VISIBILE: e' una condizione della licenza, non
     un dettaglio estetico. Solo rimpicciolita per non rubare la scena. */
  #eb-mappa-viva .leaflet-control-attribution {
    font-size: 9px; background: rgba(245, 238, 221, .82);
  }
</style>
