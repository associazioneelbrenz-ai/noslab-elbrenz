<script define:vars={{ SB_URL, SB_ANON, PIN_ANTEPRIMA: pinAnteprima }}>
  // Countdown posti gita: legge la vista aggregata v_posti_gita (solo numeri).
  (function () {
    const wrap = document.querySelector('[data-gita-countdown]');
    if (!wrap || !SB_URL || !SB_ANON) return;
    const testo = wrap.querySelector('[data-gita-testo]');
    const barra = wrap.querySelector('[data-gita-barra]');
    fetch(`${SB_URL}/rest/v1/v_posti_gita?select=posti_totali,posti_occupati`, {
      headers: { apikey: SB_ANON, Authorization: `Bearer ${SB_ANON}` },
    })
      .then((r) => (r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status))))
      .then((rows) => {
        const row = Array.isArray(rows) ? rows[0] : null;
        // [4/8/2026] Prima qui c'era `if (!row) return;`, e i puntini di
        // «… di 54» restavano per sempre: sembra un caricamento che non
        // finisce, e chi guarda non sa se sono rimasti due posti o cinquanta.
        // Non e' una bugia, ma non e' nemmeno un'informazione: si dice che il
        // dato non c'e'.
        if (!row) throw new Error('nessuna riga in v_posti_gita');
        // [4/8/2026 sera] Qui c'era `|| 54`: se la vista avesse mai restituito
        // un totale vuoto, la pagina avrebbe stampato una cifra che nessuno le
        // aveva detto, e sarebbe sembrata il dato vero. Il totale o si legge o
        // non c'e': in quel caso si finisce nel catch, che scrive
        // «non disponibile». (JavaScript e basta: siamo in un define:vars.)
        const totali = Number(row.posti_totali);
        if (!Number.isFinite(totali) || totali <= 0) throw new Error('posti_totali non leggibile');
        const occupati = Math.min(Number(row.posti_occupati) || 0, totali);
        const disponibili = Math.max(totali - occupati, 0);
        if (testo) testo.textContent = `${disponibili} di ${totali}`;
        if (barra) barra.style.width = `${Math.round((occupati / totali) * 100)}%`;
        if (disponibili <= 10 && disponibili > 0 && testo) {
          testo.textContent = `Ultimi ${disponibili} posti!`;
          testo.style.color = '#a33';
        } else if (disponibili === 0 && testo) {
          testo.textContent = 'Posti esauriti';
          testo.style.color = '#a33';
        }
      })
      .catch((e) => {
        // Rumoroso: un difetto che non si vede e' un difetto che dura mesi.
        console.error('[gita] contatore posti non leggibile:', e?.message ?? e);
        if (testo) {
          testo.textContent = 'non disponibile';
          testo.style.color = '#8a8278';
        }
        // La barra a zero direbbe «nessun posto occupato», che e'
        // un'affermazione. Meglio toglierla del tutto.
        //
        // [4/8/2026 sera] QUI C'ERA `as HTMLElement | null`, E COSTAVA CARO.
        // Questo blocco usa `define:vars`, quindi Astro lo emette INLINE e NON
        // lo compila: l'annotazione TypeScript arrivava cruda al browser, che
        // andava in SyntaxError sull'INTERO blocco di 273 righe. Morivano
        // insieme il contatore posti, la mappa della vetrina e il carosello
        // eventi, e in home restava per sempre il segnaposto «… di 54».
        // `astro check` non lo vede, la build resta verde: si vede solo
        // aprendo la pagina. In un blocco `define:vars` si scrive JavaScript
        // e basta, niente tipi.
        const barraWrap = barra && barra.parentElement;
        if (barraWrap) barraWrap.style.display = 'none';
      });
  })();

  // [3/8/2026] La mappa della vetrina (brief blocco 2). Sostituisce la
  // striscia-teaser: prima erano sei pin muti su una vista che arrivava dal
  // Bernina alle Pale di San Martino, quattro volte l'estensione che serviva,
  // e nessun nome era leggibile senza cliccare. Adesso i nomi stanno nelle
  // schede accanto, e la mappa fa solo la prova.
  //
  // Leaflet resta SELF-HOSTED da /public/leaflet, zero CDN. Ne' lo script ne'
  // un tile partono prima che la sezione entri nel viewport: fino ad allora
  // c'e' il segnaposto avorio col marchio. Se qualcosa fallisce restano le
  // schede, che sono gia' nel markup servito: la mappa e' la prova, non il
  // contenuto.
  (function () {
    const cornice = document.getElementById('eb-mappa-viva');
    if (!cornice || !window.IntersectionObserver || !PIN_ANTEPRIMA || PIN_ANTEPRIMA.length === 0) return;

    const segnaposto = document.getElementById('eb-mappa-segnaposto');
    // Le etichette permanenti sotto i 768px si accavallerebbero: si spengono.
    const etichette = window.matchMedia('(min-width: 768px)').matches;
    // L'evidenziazione a due vie ha senso col puntatore; su touch si salta.
    const puntatore = window.matchMedia('(hover: hover)').matches;

    let avviata = false;
    function accendi() {
      if (avviata) return;
      avviata = true;
      if (!document.getElementById('eb-leaflet-css')) {
        const css = document.createElement('link');
        css.id = 'eb-leaflet-css'; css.rel = 'stylesheet'; css.href = '/leaflet/leaflet.css';
        document.head.appendChild(css);
      }
      const s = document.createElement('script');
      s.src = '/leaflet/leaflet.js';
      s.onload = function () {
        try {
          const L = window.L;
          // Vetrina, non strumento: niente trascinamento, niente zoom, niente
          // tastiera. Cosi' sul telefono non ruba lo scorrimento della pagina.
          const map = L.map(cornice, {
            zoomControl: false, attributionControl: true,
            dragging: false, touchZoom: false, scrollWheelZoom: false,
            doubleClickZoom: false, boxZoom: false, keyboard: false, tap: false,
          });
          // Attribuzione OSM VISIBILE: e' una condizione della licenza.
          L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 17,
            attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
          }).addTo(map);
          const goccia = (c) => '<svg viewBox="0 0 32 44" width="26" height="36" xmlns="http://www.w3.org/2000/svg"><path d="M16 1C8 1 1.5 7.5 1.5 15.5 1.5 26 16 43 16 43s14.5-17 14.5-27.5C30.5 7.5 24 1 16 1z" fill="' + c + '" stroke="#F5EEDD" stroke-width="2"/><circle cx="16" cy="15.5" r="5" fill="#F5EEDD"/></svg>';

          const perSlug = {};
          for (const p of PIN_ANTEPRIMA) {
            const m = L.marker([p.lat, p.lng], {
              interactive: puntatore, keyboard: false, title: p.nome,
              icon: L.divIcon({
                html: '<span class="eb-pin-vetrina" role="img" aria-label="' + String(p.nome).replace(/"/g, '&quot;') + '">' + goccia(p.colore) + '</span>',
                className: 'eb-mappa-pin', iconSize: [26, 36], iconAnchor: [13, 35],
              }),
            }).addTo(map);
            if (etichette) {
              m.bindTooltip(p.nome, { permanent: true, direction: 'right', className: 'eb-vetrina-etichetta', offset: [10, -14] });
            }
            perSlug[p.slug] = m;
          }

          // Inquadratura sui sei marker: nessun centro e nessuno zoom cablati,
          // se i luoghi in anteprima cambiano la vista si adatta da sola.
          // invalidateSize() PRIMA di fitBounds: la cornice viene misurata
          // quando la sezione e' appena entrata in pagina, e se Leaflet ha in
          // mano una dimensione vecchia calcola un inquadramento che taglia
          // fuori i luoghi ai bordi. Con la colonna che accompagna le schede
          // la differenza e' di parecchie centinaia di pixel.
          // Il padding del brief e' [40, 40]. Con le etichette accese pero' il
          // nome sta a DESTRA del pin, e quello piu' a est (Castel Thun)
          // finiva mezzo fuori dalla cornice: fitBounds inquadra i marker, non
          // i loro cartellini. Si aggiunge spazio solo a destra, e solo quando
          // le etichette ci sono davvero.
          const respiro = etichette
            ? { paddingTopLeft: [40, 40], paddingBottomRight: [180, 40] }
            : { padding: [40, 40] };
          const inquadra = () => {
            map.invalidateSize();
            map.fitBounds(L.latLngBounds(PIN_ANTEPRIMA.map((p) => [p.lat, p.lng])), {
              ...respiro, maxZoom: 11,
            });
          };
          inquadra();
          // Le schede caricano i loro caratteri dopo: quando l'altezza della
          // colonna si assesta, si rimisura. Una volta sola, non a ogni frame.
          if (window.ResizeObserver) {
            let ultima = cornice.clientHeight;
            const ro = new ResizeObserver(() => {
              if (Math.abs(cornice.clientHeight - ultima) < 8) return;
              ultima = cornice.clientHeight;
              inquadra();
            });
            ro.observe(cornice);
          }

          if (puntatore) {
            const schede = document.querySelectorAll('.eb-vetrina-scheda');
            const pinDi = (slug) => {
              const m = perSlug[slug];
              const el = m && m.getElement();
              return el && el.querySelector('.eb-pin-vetrina');
            };
            schede.forEach(function (a) {
              const slug = a.getAttribute('data-slug');
              const accendiPin = () => { const s = pinDi(slug); if (s) s.classList.add('eb-in-evidenza'); };
              const spegniPin = () => { const s = pinDi(slug); if (s) s.classList.remove('eb-in-evidenza'); };
              a.addEventListener('mouseenter', accendiPin);
              a.addEventListener('focus', accendiPin);
              a.addEventListener('mouseleave', spegniPin);
              a.addEventListener('blur', spegniPin);
              const m = perSlug[slug];
              if (!m) return;
              m.on('mouseover', function () { a.classList.add('eb-in-evidenza'); });
              m.on('mouseout', function () { a.classList.remove('eb-in-evidenza'); });
              m.on('click', function () { window.location.href = a.getAttribute('href'); });
            });
          }

          setTimeout(function () {
            inquadra();
            if (segnaposto) segnaposto.style.display = 'none';
          }, 120);
        } catch (e) { /* restano schede e segnaposto */ }
      };
      document.head.appendChild(s);
    }

    const oss = new IntersectionObserver(function (voci) {
      for (const v of voci) {
        if (v.isIntersecting) { accendi(); oss.disconnect(); return; }
      }
    }, { rootMargin: '200px' });
    oss.observe(cornice);
  })();

  // AGGIUNTA 1/8/2026 — carosello eventi: in coda ai nostri appuntamenti si
  // accodano le voci del Radar gia' PUBBLICATE, dalla vista
  // eventi_esterni_pubblici (che espone solo stato='pubblicato', il filtro sta
  // a database). Si caricano a runtime e non in build perche' il cartellone
  // cambia quando il curatore pubblica, non quando si fa il deploy. Se la
  // fetch fallisce la sezione resta com'e': i nostri eventi sono gia' nel
  // markup servito, non dipendono da questo script.
  (function () {
    const lista = document.getElementById('eb-eventi-carosello');
    if (!lista || !SB_URL || !SB_ANON) return;

    const VALLE = { non: 'Val di Non', sole: 'Val di Sole', rabbi: 'Val di Rabbi', pejo: 'Val di Pejo' };
    const MESI = ['GEN', 'FEB', 'MAR', 'APR', 'MAG', 'GIU', 'LUG', 'AGO', 'SET', 'OTT', 'NOV', 'DIC'];
    const oggi = new Date().toISOString().slice(0, 10);
    const esc = (s) => String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;')
      .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    const taglia = (s, n) => (s && s.length > n ? s.slice(0, n - 1).trimEnd() + '…' : (s || ''));

    // [3/8/2026] Lo stato vuoto guarda le CARD IN PAGINA, non un conteggio
    // fatto al build sui soli eventi nostri. Prima erano due contatori diversi:
    // il messaggio "Nessun evento in programma" nasceva dal numero dei nostri
    // appuntamenti futuri, le card potevano arrivare anche dal Radar, e bastava
    // marcare annullato l'unico evento nostro perche' la pagina mostrasse
    // insieme un cartellone pieno e la riga che dice che non c'e' niente.
    // Una sola fonte: se sullo schermo c'e' almeno una card, il messaggio non
    // esiste. Non e' una condizione da ricordarsi, e' una condizione che vale.
    function allineaStatoVuoto() {
      const vuoto = document.getElementById('eb-eventi-vuoto');
      if (!vuoto) return;
      const quante = lista.querySelectorAll(':scope > li').length;
      vuoto.classList.toggle('hidden', quante > 0);
    }
    allineaStatoVuoto();

    const campi = 'id,slug,titolo,descrizione,data_inizio,data_fine,ricorrenza,ora_inizio,luogo,comune,valle,url_fonte';
    fetch(SB_URL + '/rest/v1/eventi_esterni_pubblici?select=' + campi + '&order=data_inizio.asc', {
      headers: { apikey: SB_ANON, Authorization: 'Bearer ' + SB_ANON },
    })
      .then((r) => (r.ok ? r.json() : []))
      .then((righe) => {
        const futuri = (Array.isArray(righe) ? righe : [])
          .filter((e) => (e.data_fine || e.data_inizio) >= oggi)
          .slice(0, 8);
        if (!futuri.length) { allineaStatoVuoto(); return; }

        for (const e of futuri) {
          const d = new Date(e.data_inizio + 'T00:00:00');
          const quando = e.ricorrenza
            ? esc(e.ricorrenza)
            : d.getDate() + ' ' + MESI[d.getMonth()] + ' ' + d.getFullYear();
          const ora = e.ora_inizio ? 'ore ' + String(e.ora_inizio).slice(0, 5) : '';
          const dove = [e.luogo, e.comune, VALLE[e.valle] || ''].filter(Boolean).join(' · ');
          const meta = [ora, dove].filter(Boolean).join(' · ');

          const li = document.createElement('li');
          li.className = 'snap-start flex-shrink-0 w-[250px] sm:w-[280px] flex flex-col bg-[#FAF6EC] border border-[#E5DFCF] rounded-lg overflow-hidden';
          // La copertina e' l'OG disegnata per quell'evento
          // (public/og/eventi/<slug>.png). Se manca — evento pubblicato dopo
          // l'ultimo deploy, quindi immagine non ancora generata — l'onerror
          // toglie il riquadro invece di lasciare l'icona rotta.
          const cover = e.slug
            ? '<img src="/og/eventi/' + encodeURIComponent(e.slug) + '-card.webp" alt="" width="280" height="147"' +
              ' class="w-full h-36 object-cover border-b border-[#E5DFCF]" loading="lazy" decoding="async"' +
              ' onerror="this.remove()">'
            : '';
          li.innerHTML = cover +
            '<div class="flex flex-col flex-1 p-5">' +
            '<div class="flex flex-wrap items-center gap-x-3 gap-y-2 mb-3" style="font-family:\'Inter\',sans-serif;">' +
              '<span class="border border-[#1E2E26]/25 text-[#1E2E26]/60 text-[10px] tracking-[0.16em] uppercase px-2 py-0.5 rounded">dalle valli</span>' +
              '<span class="text-[12px] tracking-[0.14em] uppercase text-[#1E2E26]/50">' + quando + '</span>' +
            '</div>' +
            '<h3 class="text-[17px] text-[#1E2E26]/85 font-medium leading-snug m-0" style="font-family:\'Playfair Display\',serif;">' +
              esc(e.titolo) +
            '</h3>' +
            (meta
              ? '<p class="text-[11px] tracking-[0.12em] uppercase text-[#1E2E26]/45 m-0 mt-2" style="font-family:\'Inter\',sans-serif;">' + esc(meta) + '</p>'
              : '') +
            (e.descrizione
              ? '<p class="text-[13px] text-[#0F0F0F]/60 leading-relaxed m-0 mt-3" style="font-family:\'Source Serif 4\',Georgia,serif;">' + esc(taglia(e.descrizione, 96)) + '</p>'
              : '') +
            '<a href="' + (e.slug ? '/eventi/' + encodeURIComponent(e.slug) : '/eventi') + '" class="text-[13px] text-[#8a6215] no-underline hover:underline mt-auto pt-4" style="font-family:\'Inter\',sans-serif;">Scopri &rarr;</a>' +
            '</div>';
          lista.appendChild(li);
        }
        allineaStatoVuoto();
      })
      .catch(() => { allineaStatoVuoto(); });
  })();
</script>

<style>
