---
/**
 * /guardiani-de-la-lenga/<slug> — la voce di dizionario di una parola sola.
 *
 * Perche' esiste: cinquantasette parole non sono piu' un elenco, sono un
 * dizionario piccolo, e un dizionario si cita. Senza un indirizzo per voce si
 * puo' solo dire «guarda nel glossario e cerca», che non e' una citazione.
 *
 * PRERENDERIZZATA, non SSR: stiamo tagliando le invocazioni, e cinquantasette
 * pagine generate a ogni richiesta sarebbero il modo piu' rapido per rimettere
 * il sito nella condizione del 6 agosto. Il prezzo e' che una parola nuova
 * compare alla ricostruzione successiva, ed e' un prezzo giusto per un
 * contenuto che cambia qualche volta al giorno.
 *
 * LE VARIANTI sono il cuore. La stessa cosa detta in modo diverso a Male' e a
 * Fondo non e' un doppione: e' il dato. Quando due lemmi condividono il
 * significato in parlate diverse, la scheda li mostra affiancati, cosi' si vede
 * la differenza fra le valli. Oggi non ce n'e' ancora nessuna coppia, e la
 * sezione non compare: comparira' da sola il giorno che arriva.
 */
import Layout from '../../layouts/Layout.astro';
import { createClient } from '@supabase/supabase-js';

type Voce = {
  id: string; slug: string; termine: string; tipo: string | null;
  categoria_gramm: string | null; variante: string | null; comune: string | null;
  significato_it: string | null; esempio_uso: string | null;
  etimologia: string | null; proverbi: string | null;
  audio_url: string | null; contributore_firma: string | null;
};

export async function getStaticPaths() {
  const url = import.meta.env.PUBLIC_SUPABASE_URL || 'https://wacknihvdjxltiqvxtqr.supabase.co';
  const anon = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
  if (!anon) return [];
  const sb = createClient(url, anon, { auth: { persistSession: false } });
  const { data } = await sb.from('glossario_pubblico').select('*');
  const voci = (data as Voce[]) ?? [];
  return voci.filter((v) => v.slug).map((v) => ({
    params: { slug: v.slug },
    // Le sorelle viaggiano con la voce: stesso significato, parlata diversa.
    // Il confronto e' sul significato normalizzato, perche' e' quello che rende
    // due parole varianti l'una dell'altra e non due parole qualsiasi.
    props: {
      voce: v,
      sorelle: voci.filter((a) =>
        a.id !== v.id &&
        (a.significato_it ?? '').trim().toLowerCase() === (v.significato_it ?? '').trim().toLowerCase() &&
        (a.significato_it ?? '').trim() !== ''),
    },
  }));
}

const { voce, sorelle } = Astro.props as { voce: Voce; sorelle: Voce[] };

const PARLATA: Record<string, string> = {
  noneso: 'Noneso · Val di Non', solander: 'Solander · Val di Sole',
  rabies: 'Rabies · Val di Rabbi', pegaes: 'Pegaes · Val di Pejo',
};
const parlataL = voce.variante ? (PARLATA[voce.variante] ?? voce.variante) : null;
const eDetto = voce.tipo && voce.tipo !== 'parola';

const descrizione = [voce.significato_it, parlataL].filter(Boolean).join(' · ').slice(0, 180);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  name: voce.termine,
  description: voce.significato_it ?? '',
  inLanguage: 'lld',
  url: `https://elbrenz.eu/guardiani-de-la-lenga/${voce.slug}`,
  inDefinedTermSet: {
    '@type': 'DefinedTermSet',
    name: 'Guardiani de la lenga · glossario del ladino anaunico',
    url: 'https://elbrenz.eu/guardiani-de-la-lenga',
  },
};
---

<Layout
  title={`${voce.termine} · Guardiani de la lenga · El Brenz`}
  description={descrizione}
  ogImage="/og/og-default.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main class="bg-[#F8F1E4] min-h-screen">
    <div class="max-w-3xl mx-auto px-6 py-10 md:py-14">

      <a href="/guardiani-de-la-lenga"
        class="inline-block text-[11px] tracking-[0.22em] uppercase text-[#8a6215] font-semibold no-underline mb-5 hover:underline"
        style="font-family: 'Inter', sans-serif;">← Guardiani de la lenga</a>

      {/* Il lemma in evidenza, come in un dizionario vero. */}
      <h1 class="text-3xl md:text-4xl leading-tight text-[#1E2E26] m-0"
          style="font-family: 'Playfair Display', serif; font-weight: 500;" lang="lld-anau">{voce.termine}</h1>

      <p class="text-[13px] text-[#1E2E26]/60 mt-2 mb-7" style="font-family: 'Inter', sans-serif;">
        {[eDetto ? 'modo di dire' : voce.categoria_gramm, parlataL, voce.comune].filter(Boolean).join(' · ')}
      </p>

      {voce.significato_it && (
        <p class="text-xl text-[#1E2E26] leading-relaxed m-0 mb-6"
           style="font-family: 'Source Serif 4', Georgia, serif;">{voce.significato_it}</p>
      )}

      {voce.esempio_uso && (
        <p class="text-lg text-[#1E2E26]/80 italic leading-relaxed border-l-2 border-[#C8923E]/50 pl-4 m-0 mb-6"
           style="font-family: 'Source Serif 4', Georgia, serif;" lang="lld-anau">{voce.esempio_uso}</p>
      )}

      {voce.audio_url && (
        <div class="mb-6">
          <p class="text-[11px] tracking-[0.2em] uppercase text-[#8a6215] m-0 mb-2" style="font-family: 'Inter', sans-serif;">La voce</p>
          <audio controls preload="none" src={voce.audio_url} class="w-full"></audio>
        </div>
      )}

      {/* Etimologia e proverbi compaiono SOLO se ci sono: oggi sono a zero su
          cinquantasette, e uno spazio vuoto sembrerebbe un difetto invece di
          un'assenza. */}
      {voce.etimologia && (
        <div class="mb-6">
          <h2 class="text-[11px] tracking-[0.2em] uppercase text-[#8a6215] m-0 mb-2" style="font-family: 'Inter', sans-serif;">Etimologia</h2>
          <p class="text-[#1E2E26]/85 leading-relaxed m-0" style="font-family: 'Source Serif 4', Georgia, serif;">{voce.etimologia}</p>
        </div>
      )}

      {voce.proverbi && (
        <div class="mb-6">
          <h2 class="text-[11px] tracking-[0.2em] uppercase text-[#8a6215] m-0 mb-2" style="font-family: 'Inter', sans-serif;">Proverbi e modi di dire</h2>
          <p class="text-[#1E2E26]/85 leading-relaxed whitespace-pre-line m-0" style="font-family: 'Source Serif 4', Georgia, serif;">{voce.proverbi}</p>
        </div>
      )}

      {/* LE VARIANTI: la stessa cosa detta in un'altra valle. */}
      {sorelle.length > 0 && (
        <div class="mt-10 bg-[#F5EEDD] border border-[#C8923E]/40 rounded-md p-5">
          <h2 class="text-[11px] tracking-[0.2em] uppercase text-[#8a6215] m-0 mb-3" style="font-family: 'Inter', sans-serif;">
            Come si dice altrove
          </h2>
          <div class="grid gap-3">
            {sorelle.map((s) => (
              <a href={`/guardiani-de-la-lenga/${s.slug}`} class="no-underline block">
                <span class="text-lg text-[#1E2E26]" style="font-family: 'Playfair Display', serif;" lang="lld-anau">{s.termine}</span>
                <span class="text-[12px] text-[#1E2E26]/60 ml-2" style="font-family: 'Inter', sans-serif;">
                  {[s.variante ? (PARLATA[s.variante] ?? s.variante) : null, s.comune].filter(Boolean).join(' · ')}
                </span>
              </a>
            ))}
          </div>
        </div>
      )}

      {voce.contributore_firma && (
        <p class="mt-10 text-sm text-[#1E2E26]/60" style="font-family: 'Inter', sans-serif;">
          Parola portata da <strong>{voce.contributore_firma}</strong>.
        </p>
      )}

      {/*
        «LA CONOSCO ANCH'IO».
        Non e' un mi piace: e' la domanda che trasforma un applauso in un dato.
        Chi preme dice che quella parola si usa anche da lui, e dice DA DOVE:
        da li' nasce la mappa di diffusione di un termine, che nessun
        questionario scoprirebbe e che cinquanta bottoni premuti si'.
        Il conteggio si carica dopo, perche' la pagina e' prerenderizzata e un
        numero cotto dentro l'HTML invecchierebbe entro un'ora.
      */}
      <div id="rz" class="mt-10 border-t border-[#C8923E]/30 pt-6" data-lemma={voce.id}>
        <button id="rz-btn" type="button"
          class="inline-flex items-center gap-2 bg-[#F5EEDD] border border-[#C8923E]/50 rounded-full px-5 py-2.5 cursor-pointer hover:bg-[#F0E6D0] transition-colors"
          style="font-family: 'Inter', sans-serif; font-size: 15px; color: #1E2E26;">
          <span id="rz-cuore" style="font-size: 17px;">♡</span>
          <span id="rz-testo">La conosco anch’io</span>
        </button>

        {/* Il comune si chiede UNA VOLTA SOLA, e solo al primo tocco: chiederlo
            prima sarebbe un modulo, e un modulo davanti a un gesto lo uccide. */}
        <div id="rz-comune" class="hidden mt-4 bg-[#F5EEDD] border border-[#C8923E]/40 rounded-md p-4">
          <label for="rz-comune-input" class="block text-[13px] text-[#1E2E26]/80 mb-2"
                 style="font-family: 'Inter', sans-serif;">
            In che paese la senti dire? Serve a capire fin dove arriva questa parola.
          </label>
          <div class="flex gap-2 flex-wrap">
            <input id="rz-comune-input" type="text" placeholder="Malé, Fondo, Rabbi…" maxlength="60"
              class="flex-1 min-w-0 px-3 py-2 rounded bg-white text-[#1E2E26] border border-[#C8923E]/40 focus:outline-none focus:border-[#C8923E]"
              style="font-family: 'Inter', sans-serif;" />
            <button id="rz-comune-ok" type="button"
              class="bg-[#C8923E] text-[#1E2E26] font-semibold px-5 py-2 rounded cursor-pointer border-0 hover:bg-[#D9A94E]"
              style="font-family: 'Inter', sans-serif;">Conferma</button>
          </div>
          <button id="rz-comune-salta" type="button"
            class="mt-2 bg-transparent border-0 p-0 text-[13px] text-[#1E2E26]/55 underline cursor-pointer"
            style="font-family: 'Inter', sans-serif;">Preferisco non dirlo</button>
        </div>

        <p id="rz-esito" class="text-[13px] text-[#1E2E26]/65 mt-3 m-0" style="font-family: 'Inter', sans-serif;"></p>
      </div>

      {/*
        PROPONI UNA CORREZIONE.
        Una parlata non si stabilisce a tavolino: si discute. Chi legge sa magari
        che a Rabbi si dice diversamente, o che l'accento va altrove, e finora
        non aveva modo di dirlo se non con una mail che nessuno ritrova. Ogni
        segnalazione persa e' una persona che smette di segnalare.
        Il modulo sta CHIUSO: aperto sempre farebbe sembrare la scheda un
        cantiere invece che una voce di dizionario.
      */}
      <div id="cx" class="mt-6" data-lemma={voce.id}>
        <button id="cx-apri" type="button"
          class="bg-transparent border-0 p-0 text-sm text-[#8a6215] font-semibold underline cursor-pointer"
          style="font-family: 'Inter', sans-serif;">
          Qui c’è qualcosa che non torna? Proponi una correzione
        </button>

        <form id="cx-form" class="hidden mt-4 bg-[#F5EEDD] border border-[#C8923E]/40 rounded-md p-5 grid gap-3"
              novalidate style="font-family: 'Inter', sans-serif;">
          <input type="text" name="_honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />

          <p class="text-[13px] text-[#1E2E26]/75 m-0 leading-relaxed">
            Nessuna correzione entra da sola: la legge un curatore. Anche se non
            viene accolta, quello che scrivi resta agli atti come testimonianza.
          </p>

          <label class="text-[13px] text-[#1E2E26]/80">
            Che cosa non torna
            <select name="campo" class="mt-1 w-full px-3 py-2 rounded bg-white text-[#1E2E26] border border-[#C8923E]/40 focus:outline-none focus:border-[#C8923E]">
              <option value="definizione">Il significato</option>
              <option value="grafia_accento">La grafia o l’accento</option>
              <option value="esempio">L’esempio d’uso</option>
              <option value="comune">Il paese</option>
              <option value="parlata">La parlata</option>
              <option value="etimologia">L’etimologia</option>
              <option value="altro">Altro</option>
            </select>
          </label>

          <label class="text-[13px] text-[#1E2E26]/80">
            Come andrebbe secondo te
            <textarea name="proposta" rows="3" maxlength="1200" required
              placeholder="Da noi si dice…"
              class="mt-1 w-full px-3 py-2 rounded bg-white text-[#1E2E26] border border-[#C8923E]/40 focus:outline-none focus:border-[#C8923E]"></textarea>
          </label>

          <label class="text-[13px] text-[#1E2E26]/80">
            Come lo sai (facoltativo)
            <textarea name="motivazione" rows="2" maxlength="1200"
              placeholder="Me lo diceva mia nonna, a Rabbi si usa così…"
              class="mt-1 w-full px-3 py-2 rounded bg-white text-[#1E2E26] border border-[#C8923E]/40 focus:outline-none focus:border-[#C8923E]"></textarea>
          </label>

          <div class="grid md:grid-cols-2 gap-3">
            <input type="text" name="nome" maxlength="80" placeholder="Il tuo nome (facoltativo)"
              class="px-3 py-2 rounded bg-white text-[#1E2E26] border border-[#C8923E]/40 focus:outline-none focus:border-[#C8923E]" />
            <input type="email" name="email" maxlength="160" placeholder="La tua email (facoltativa)"
              class="px-3 py-2 rounded bg-white text-[#1E2E26] border border-[#C8923E]/40 focus:outline-none focus:border-[#C8923E]" />
          </div>
          <p class="text-[12px] text-[#1E2E26]/55 m-0 -mt-1">
            L’email serve solo per dirti com’è andata. Puoi anche non lasciarla.
          </p>

          <div class="flex gap-3 items-center flex-wrap">
            <button type="submit" id="cx-invia"
              class="bg-[#C8923E] text-[#1E2E26] font-semibold px-5 py-2.5 rounded cursor-pointer border-0 hover:bg-[#D9A94E]">
              Manda la segnalazione
            </button>
            <button type="button" id="cx-annulla"
              class="bg-transparent border-0 p-0 text-sm text-[#1E2E26]/55 underline cursor-pointer">Lascia stare</button>
          </div>

          <p id="cx-esito" class="text-[13px] m-0 leading-relaxed"></p>
        </form>
      </div>

      <p class="mt-8 text-sm" style="font-family: 'Inter', sans-serif;">
        <a href="/guardiani-de-la-lenga#proponi" class="text-[#8a6215] font-semibold hover:underline">
          Conosci una parola che non c’è? Proponila →
        </a>
      </p>

    </div>
  </main>
</Layout>

<script>
  // «La conosco anch'io». Niente define:vars: l'identificativo del lemma sta in
  // un attributo del DOM. E' la lezione del 4 agosto, quando un'annotazione di
  // tipo dentro uno script inline ha ucciso 273 righe a build verde.
  (() => {
    const box = document.getElementById('rz');
    if (!box) return;
    const lemma = box.getAttribute('data-lemma');
    if (!lemma) return;

    const btn = document.getElementById('rz-btn');
    const cuore = document.getElementById('rz-cuore');
    const testo = document.getElementById('rz-testo');
    const esito = document.getElementById('rz-esito');
    const chiedi = document.getElementById('rz-comune');
    const campo = document.getElementById('rz-comune-input');

    const URL_FN = 'https://wacknihvdjxltiqvxtqr.supabase.co/functions/v1/reazione-pubblica';
    const CHIAVE = document.documentElement.outerHTML.match(/sb_publishable_[A-Za-z0-9_-]+/);

    // Il gettone identifica il browser, non la persona: serve a non contare due
    // volte lo stesso pollice, non a sapere chi sia.
    function gettone() {
      let g = localStorage.getItem('eb_rz_gettone');
      if (!g) {
        g = 'g' + Math.random().toString(36).slice(2) + Date.now().toString(36);
        localStorage.setItem('eb_rz_gettone', g);
      }
      return g;
    }
    const comuneNoto = () => localStorage.getItem('eb_rz_comune') || '';
    let mia = false;

    function dipingi(quante, comuni, sonoIo) {
      mia = !!sonoIo;
      if (cuore) cuore.textContent = mia ? '♥' : '♡';
      if (testo) testo.textContent = mia ? 'La conosci anche tu' : 'La conosco anch’io';
      if (btn) btn.style.background = mia ? '#F0E6D0' : '#F5EEDD';
      if (!esito) return;
      const n = Number(quante) || 0;
      if (n === 0) {
        // Mai «0»: un conteggio a zero e' un invito mancato, non un dato.
        esito.textContent = 'Nessuno l’ha ancora riconosciuta. Puoi essere il primo.';
      } else {
        const luoghi = (comuni || []).filter(Boolean);
        const dove = luoghi.length ? ' · si dice a ' + luoghi.join(', ') : '';
        esito.textContent = (n === 1 ? 'Una persona la conosce' : n + ' persone la conoscono') + dove;
      }
    }

    async function chiama(comune) {
      if (!CHIAVE) return;
      try {
        const r = await fetch(URL_FN, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', apikey: CHIAVE[0] },
          body: JSON.stringify({
            oggetto_tipo: 'lemma', oggetto_id: lemma, tipo: 'conosco',
            gettone: gettone(), comune: comune || null,
          }),
        });
        const d = await r.json();
        if (d && d.ok) dipingi(d.quante, d.comuni, d.mia);
        else if (esito) esito.textContent = 'Non sono riuscito a registrarlo: riprova fra poco.';
      } catch {
        // Si dice. Un tocco che non arriva e non lo dice e' peggio di un tocco
        // che non parte: la persona crede di aver contribuito e non e' vero.
        if (esito) esito.textContent = 'Non sono riuscito a registrarlo: riprova fra poco.';
      }
    }

    btn?.addEventListener('click', () => {
      if (mia || comuneNoto()) return chiama(mia ? null : comuneNoto());
      chiedi?.classList.remove('hidden');
      campo?.focus();
    });
    document.getElementById('rz-comune-ok')?.addEventListener('click', () => {
      const v = (campo && campo.value ? campo.value : '').trim();
      if (v) localStorage.setItem('eb_rz_comune', v);
      chiedi?.classList.add('hidden');
      chiama(v);
    });
    document.getElementById('rz-comune-salta')?.addEventListener('click', () => {
      chiedi?.classList.add('hidden');
      chiama(null);
    });
    campo?.addEventListener('keydown', (ev) => {
      if (ev.key === 'Enter') document.getElementById('rz-comune-ok')?.click();
    });

    // ── PROPONI UNA CORREZIONE ──────────────────────────────────────────────
    const cx = document.getElementById('cx');
    const cxForm = document.getElementById('cx-form');
    const cxEsito = document.getElementById('cx-esito');
    const cxInvia = document.getElementById('cx-invia');
    const apertoIl = Date.now();

    document.getElementById('cx-apri')?.addEventListener('click', () => {
      cxForm?.classList.toggle('hidden');
      if (!cxForm?.classList.contains('hidden')) {
        cxForm?.querySelector('[name=proposta]')?.focus();
      }
    });
    document.getElementById('cx-annulla')?.addEventListener('click', () => {
      cxForm?.classList.add('hidden');
      if (cxEsito) cxEsito.textContent = '';
    });

    cxForm?.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      if (!CHIAVE || !cx) return;
      const val = (n) => {
        const el = cxForm.querySelector('[name=' + n + ']');
        return el && el.value ? el.value.trim() : '';
      };
      if (!val('proposta')) {
        if (cxEsito) { cxEsito.style.color = '#a33'; cxEsito.textContent = 'Scrivi come andrebbe secondo te.'; }
        return;
      }
      if (cxInvia) { cxInvia.disabled = true; cxInvia.textContent = 'Mando…'; }
      try {
        const r = await fetch('https://wacknihvdjxltiqvxtqr.supabase.co/functions/v1/lemma-correzione', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', apikey: CHIAVE[0] },
          body: JSON.stringify({
            lemma_id: cx.getAttribute('data-lemma'),
            campo: val('campo') || 'altro',
            proposta: val('proposta'),
            motivazione: val('motivazione'),
            nome: val('nome'),
            email: val('email'),
            _honeypot: val('_honeypot'),
            _ts: apertoIl,
          }),
        });
        const d = await r.json();
        if (cxEsito) {
          if (d && d.ok) {
            // Si dichiara riuscito solo cio' che il server ha confermato.
            cxEsito.style.color = '#2d8659';
            cxEsito.textContent = d.messaggio || 'Grazie: la tua segnalazione è arrivata a un curatore.';
            cxForm.querySelectorAll('input, textarea').forEach((el) => { el.value = ''; });
          } else {
            cxEsito.style.color = '#a33';
            cxEsito.textContent = d && d.errore === 'troppe_proposte'
              ? 'Hai già mandato diverse segnalazioni: riprova fra un’ora.'
              : 'Non sono riuscito a mandarla: riprova o scrivi a info@elbrenz.eu.';
          }
        }
      } catch {
        if (cxEsito) {
          cxEsito.style.color = '#a33';
          cxEsito.textContent = 'Non sono riuscito a mandarla: riprova o scrivi a info@elbrenz.eu.';
        }
      } finally {
        if (cxInvia) { cxInvia.disabled = false; cxInvia.textContent = 'Manda la segnalazione'; }
      }
    });

    // Il conteggio all'apertura, dalla vista pubblica: la pagina e'
    // prerenderizzata e un numero cotto dentro l'HTML invecchierebbe subito.
    (async () => {
      if (!CHIAVE) return;
      try {
        const u = 'https://wacknihvdjxltiqvxtqr.supabase.co/rest/v1/v_reazioni_conteggio'
          + '?select=quante,comuni&oggetto_tipo=eq.lemma&tipo=eq.conosco&oggetto_id=eq.' + lemma;
        const r = await fetch(u, { headers: { apikey: CHIAVE[0] } });
        const j = await r.json();
        const riga = Array.isArray(j) && j[0] ? j[0] : { quante: 0, comuni: [] };
        dipingi(riga.quante, riga.comuni, false);
      } catch { /* il bottone resta usabile anche senza conteggio */ }
    })();
  })();
</script>
