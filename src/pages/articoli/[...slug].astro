---
/**
 * /articoli/[slug] — pagina di dettaglio di un singolo articolo.
 *
 * SORGENTE: v_articoli_pubblici (decisione del 2/8/2026). Fino a quel giorno
 * leggeva i file markdown della collection.
 *
 * PERCHE' E' CAMBIATA. Gli articoli vivevano in due posti che non si
 * parlavano: il sito rendeva i markdown, la Redazione scriveva a database. Un
 * pezzo scritto in redazione non compariva da nessuna parte finche' qualcuno
 * non lanciava a mano uno script di esportazione. Con il database come fonte
 * unica quel passaggio sparisce.
 *
 * IL RISCHIO CHE NON C'ERA. Gli URL nascevano dal nome del file e ora nascono
 * dallo slug: prima del passaggio sono stati confrontati uno per uno. I 108
 * URL vivi in markdown e i 108 record della vista coincidono esattamente, zero
 * differenze, quindi nessun redirect 301 e nessun indirizzo perso.
 *
 * SSR e non generazione statica: un articolo pubblicato dalla Redazione deve
 * vedersi subito, non al prossimo build. La vista espone solo
 * pubblicato = true AND stato = 'pubblicato' AND tipo_contenuto = 'post',
 * quindi una bozza qui da' 404 e il filtro sta a database, non nel markup.
 *
 * I dati SEO non passano piu' dal ponte legacy_wp_id -> v_articoli_seo: stanno
 * sulla stessa riga (meta_title, meta_description, immagine_alt, noindex).
 *
 * I file markdown NON si cancellano: restano dove sono, semplicemente non li
 * legge piu' nessuno.
 */
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { createClient } from '@supabase/supabase-js';
import { nomePilastro, formatDataIT } from '../../lib/articoli';
import { titoloSeo, OG_DEFAULT } from '../../lib/seoArticoli';
import { schemaArticle, schemaBreadcrumb } from '../../lib/schema';

export const prerender = false;

const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL || 'https://wacknihvdjxltiqvxtqr.supabase.co';
const SUPABASE_ANON = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';

// La rotta e' [...slug] (rest): lo slug puo' arrivare con la barra finale.
const slug = String(Astro.params.slug ?? '').replace(/\/+$/, '');

type Articolo = {
  id: string; titolo: string; slug: string; sottotitolo: string | null;
  estratto: string | null; corpo_html: string | null;
  immagine_copertina_url: string | null; pilastro: string | null;
  pubblicato_at: string | null; tempo_lettura_min: number | null;
  meta_title: string | null; meta_description: string | null;
  immagine_alt: string | null; noindex: boolean | null;
  wp_autore_originale: string | null;
};

let articolo: Articolo | null = null;
if (slug) {
  try {
    const sb = createClient(SUPABASE_URL, SUPABASE_ANON, { auth: { persistSession: false } });
    const { data } = await sb
      .from('v_articoli_pubblici')
      .select('id, titolo, slug, sottotitolo, estratto, corpo_html, immagine_copertina_url, pilastro, pubblicato_at, tempo_lettura_min, meta_title, meta_description, immagine_alt, noindex, wp_autore_originale')
      .eq('slug', slug)
      .maybeSingle();
    articolo = (data as Articolo) ?? null;
  } catch (e) {
    console.error('[articoli/slug] lettura fallita:', e);
  }
}

if (!articolo) {
  return new Response(null, { status: 404, statusText: 'Articolo non trovato' });
}

const pillar = nomePilastro(articolo.pilastro ?? '');
const dataPubblicazione = articolo.pubblicato_at ? new Date(articolo.pubblicato_at) : null;
const dataEstesa = dataPubblicazione ? formatDataIT(dataPubblicazione) : '';

const titoloPagina = titoloSeo(articolo.meta_title, articolo.titolo);
const descrizionePagina = articolo.meta_description || articolo.estratto || '';
const autore = articolo.wp_autore_originale || 'El Brenz';

// La copertina fa anche da og:image. Dove manca si usa l'immagine di riserva
// brandizzata: meglio un'anteprima sobria che nessuna anteprima.
const ogImmagine = articolo.immagine_copertina_url || OG_DEFAULT;
const pubblicatoIso = dataPubblicazione ? dataPubblicazione.toISOString() : undefined;

const urlArticolo = new URL(`/articoli/${articolo.slug}`, Astro.site).href;
const ldArticle = schemaArticle({
  titolo: articolo.titolo,
  descrizione: descrizionePagina,
  url: urlArticolo,
  immagine: ogImmagine?.startsWith('http') ? ogImmagine : new URL(ogImmagine, Astro.site).href,
  pubblicatoIso: pubblicatoIso ?? null,
  autore,
  sezione: pillar || null,
});
const ldBreadcrumb = schemaBreadcrumb([
  { nome: 'El Brenz', url: '/' },
  { nome: 'Archivio', url: '/archivio-storico' },
  { nome: articolo.titolo, url: `/articoli/${articolo.slug}` },
]);
---
<script type="application/ld+json" set:html={JSON.stringify(ldArticle)} />
<script type="application/ld+json" set:html={JSON.stringify(ldBreadcrumb)} />
<ArticleLayout
  title={articolo.titolo}
  titoloSeo={titoloPagina}
  pillar={pillar || undefined}
  author={autore}
  date={dataEstesa}
  description={descrizionePagina}
  heroAlt={articolo.immagine_alt ?? undefined}
  noindex={articolo.noindex === true}
  ogImage={ogImmagine}
  publishedTime={pubblicatoIso}
>
  {/* Il corpo arriva gia' in HTML dalla Redazione (corpo_html): e' testo
      nostro, scritto dai collaboratori e approvato prima della pubblicazione,
      non contenuto di terzi. */}
  <div set:html={articolo.corpo_html ?? ''} />
</ArticleLayout>
