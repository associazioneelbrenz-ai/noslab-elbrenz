---
/**
 * /radar-eventi — coda di curatela del Radar eventi delle Valli del Noce.
 * Gemella di /museo-gg-curatela: isola client-side, auth OTP (otp-request /
 * otp-verify + sessione Supabase), gating ruolo, poi lettura via RLS e azioni
 * che chiamano l'edge `radar-eventi-azione` in JSON.
 *
 * MAI un link di posta che punta direttamente a una edge function: le edge non
 * servono HTML renderizzabile (Supabase strippa il Content-Type e il browser
 * si scarica un .txt). Il bottone sta qui, l'edge risponde JSON.
 *
 * Chi cura: livello >= 20 (curatore, collaboratore, admin) approva, scarta e
 * modifica. La PUBBLICAZIONE, l'unico atto che fa uscire un evento in pubblico,
 * resta al direttivo (>= 50) e la impone anche il trigger di guardia a DB.
 */
import Layout from '../layouts/Layout.astro';

const VALLE: Record<string, string> = {
  non: 'Val di Non', sole: 'Val di Sole', rabbi: 'Val di Rabbi', pejo: 'Val di Pejo',
};
const inputCls = 'w-full border-2 border-[#E5DFCF] bg-white px-4 py-2.5 text-[#1E2E26] rounded focus:outline-none focus:border-[#C8923E]';
---

<Layout
  title="Radar eventi · Curatela · El Brenz"
  description="Coda riservata di curatela degli eventi delle Valli del Noce."
  ogImage="/og/og-default.jpg"
  noindex={true}
>
  <main class="bg-[#F8F1E4] min-h-screen">
    <div class="max-w-5xl mx-auto px-6 py-12 md:py-16" style="font-family: 'Inter', sans-serif;">
      <p class="text-[11px] tracking-[0.22em] uppercase text-[#8a6215] font-semibold m-0 mb-2">Area riservata · Curatela</p>
      <h1 class="text-3xl md:text-4xl text-[#1E2E26] m-0 mb-8" style="font-family: 'Playfair Display', serif; font-weight: 500;">Radar eventi delle Valli del Noce</h1>

      <p id="rd-loading" class="text-[#1E2E26]/60">Carico…</p>

      {/* LOGIN */}
      <section id="rd-login" class="hidden bg-white border border-[#E5DFCF] rounded p-6 md:p-8 max-w-md">
        <div id="rd-login-1">
          <p class="text-sm text-[#1E2E26]/70 m-0 mb-4">Accedi con la tua email: ti invieremo un codice di verifica.</p>
          <label class="block text-sm text-[#1E2E26]/75 mb-1" for="rd-email">Email</label>
          <input class={inputCls} type="email" id="rd-email" autocomplete="email" placeholder="nome@esempio.it" />
          <button type="button" id="rd-send" class="mt-4 w-full bg-[#1E2E26] text-[#F5EEDD] py-3 rounded font-medium hover:bg-[#2a3f34] transition-colors">Invia codice</button>
        </div>
        <div id="rd-login-2" class="hidden">
          <p class="text-sm text-[#1E2E26]/70 m-0 mb-4">Inserisci il codice a 6 cifre inviato a <strong id="rd-email-echo"></strong>.</p>
          <input class={`${inputCls} tracking-[0.4em] text-center text-xl`} type="text" id="rd-code" inputmode="numeric" maxlength="6" placeholder="000000" />
          <button type="button" id="rd-verify" class="mt-4 w-full bg-[#C8923E] text-[#1E2E26] py-3 rounded font-semibold hover:bg-[#D9A94E] transition-colors">Verifica e accedi</button>
          <button type="button" id="rd-back" class="mt-2 w-full text-sm text-[#8a6215] underline bg-transparent border-0 cursor-pointer">Cambia email</button>
        </div>
        <div id="rd-login-err" class="hidden mt-3 text-sm rounded px-3 py-2" style="background:#fbecec;color:#1E2E26;"></div>
      </section>

      {/* NO ACCESS */}
      <section id="rd-noaccess" class="hidden bg-white border border-[#E5DFCF] rounded p-6 max-w-md">
        <p class="m-0 text-[#1E2E26]/80">Questa area è riservata a chi cura il Radar. Se pensi di dover avere accesso, chiedi al segretario di abilitarti.</p>
        <button type="button" id="rd-logout-2" class="mt-4 text-sm text-[#8a6215] underline bg-transparent border-0 cursor-pointer">Esci</button>
      </section>

      {/* APP */}
      <section id="rd-app" class="hidden">
        <div class="flex items-center justify-between mb-6">
          <p class="text-sm text-[#1E2E26]/70 m-0">Ciao <strong id="rd-utente"></strong> · <span id="rd-ruolo" class="text-[#8a6215]"></span></p>
          <button type="button" id="rd-logout" class="text-sm text-[#8a6215] underline bg-transparent border-0 cursor-pointer">Esci</button>
        </div>

        <p class="text-[13px] text-[#1E2E26]/55 m-0 mb-5">
          Gli eventi arrivano dai portali aperti dei comuni e delle Comunità di valle, con un punteggio di rilevanza.
          Nessuno diventa pubblico da solo: prima <strong>approvato</strong>, poi <strong>pubblicato</strong>, per mano di due persone.
          Gli scartati restano in archivio: servono a tarare il classificatore.
        </p>

        {/* FILTRI */}
        <div class="bg-white border border-[#E5DFCF] rounded p-4 mb-6 grid gap-3 sm:grid-cols-4">
          <div>
            <label class="block text-[13px] text-[#1E2E26]/70 mb-1" for="rd-f-stato">Stato</label>
            <select class={inputCls} id="rd-f-stato">
              <option value="proposto">Proposto</option>
              <option value="approvato">Approvato</option>
              <option value="pubblicato">Pubblicato</option>
              <option value="grezzo">Grezzo</option>
              <option value="scartato">Scartato</option>
              <option value="non_promuovibile">Non promuovibile</option>
              <option value="">Tutti</option>
            </select>
          </div>
          <div>
            <label class="block text-[13px] text-[#1E2E26]/70 mb-1" for="rd-f-valle">Valle</label>
            <select class={inputCls} id="rd-f-valle">
              <option value="">Tutte</option>
              {Object.entries(VALLE).map(([v, l]) => (<option value={v}>{l}</option>))}
            </select>
          </div>
          <div>
            <label class="block text-[13px] text-[#1E2E26]/70 mb-1" for="rd-f-da">Dal</label>
            <input class={inputCls} type="date" id="rd-f-da" />
          </div>
          <div>
            <label class="block text-[13px] text-[#1E2E26]/70 mb-1" for="rd-f-al">Al</label>
            <input class={inputCls} type="date" id="rd-f-al" />
          </div>
        </div>

        <p id="rd-riepilogo" class="text-[13px] text-[#1E2E26]/70 m-0 mb-2"></p>
        <p id="rd-conteggio" class="text-[13px] text-[#1E2E26]/55 m-0 mb-3"></p>
        <div id="rd-lista" class="space-y-3"></div>
      </section>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabase';
  import { proteggiCuratela2fa } from '../lib/curatela2fa';

  const VALLE: Record<string, string> = {
    non: 'Val di Non', sole: 'Val di Sole', rabbi: 'Val di Rabbi', pejo: 'Val di Pejo',
  };
  const PILASTRO: Record<number, string> = {
    1: 'Storia delle Valli', 2: 'Lingua e ladinità', 3: 'Cultura materiale',
    4: 'Rievocazioni ed eventi', 5: 'Identità e appartenenza', 6: 'Vita associativa',
  };
  const FLAG: Record<string, string> = {
    bassa_priorita: 'bassa priorità',
    nota_lingua: 'la fonte scrive «dialetto»',
    accuratezza_da_verificare: 'accuratezza da verificare',
  };

  const esc = (s: unknown) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  const $ = (id: string) => document.getElementById(id);
  const show = (id: string) => $(id)?.classList.remove('hidden');
  const hide = (id: string) => $(id)?.classList.add('hidden');
  const val = (id: string) => ($(id) as HTMLInputElement | HTMLSelectElement)?.value ?? '';

  let livello = 0;

  async function init() {
    const { data: { session } } = await supabase.auth.getSession();
    hide('rd-loading');
    if (!session) { show('rd-login'); return; }
    const { data: ruoli } = await supabase
      .from('utente_ruolo').select('ruolo:ruolo_id ( nome, livello )').eq('utente_id', session.user.id);
    livello = (ruoli ?? []).reduce((m: number, r: any) => Math.max(m, r?.ruolo?.livello ?? 0), 0);
    const nomeRuolo = (ruoli ?? []).map((r: any) => r?.ruolo?.nome).sort().pop() ?? 'ospite';
    if (livello < 20) { show('rd-noaccess'); return; }
    if (!(await proteggiCuratela2fa())) { window.location.reload(); return; }
    ($('rd-utente') as HTMLElement).textContent = session.user.user_metadata?.nome || session.user.email || '';
    ($('rd-ruolo') as HTMLElement).textContent = nomeRuolo;
    show('rd-app');
    await caricaLista();
  }

  // ---- LOGIN (stesso flusso OTP delle altre curatele) ----
  const loginErr = (t: string) => { const e = $('rd-login-err')!; e.classList.remove('hidden'); e.textContent = t; };
  $('rd-send')?.addEventListener('click', async () => {
    const email = val('rd-email').trim().toLowerCase();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { loginErr('Email non valida.'); return; }
    $('rd-login-err')?.classList.add('hidden');
    const btn = $('rd-send') as HTMLButtonElement; btn.disabled = true; btn.textContent = 'Invio…';
    const { data, error } = await supabase.functions.invoke('otp-request', { body: { email, scope: 'login' } });
    btn.disabled = false; btn.textContent = 'Invia codice';
    if (error || !data?.ok) { loginErr('Impossibile inviare il codice. Riprova.'); return; }
    (window as any)._rdEmail = email;
    ($('rd-email-echo') as HTMLElement).textContent = email;
    hide('rd-login-1'); show('rd-login-2');
    setTimeout(() => ($('rd-code') as HTMLInputElement)?.focus(), 100);
  });
  $('rd-back')?.addEventListener('click', () => { hide('rd-login-2'); show('rd-login-1'); });
  $('rd-verify')?.addEventListener('click', async () => {
    const codice = val('rd-code').replace(/\D/g, '');
    if (!/^\d{6}$/.test(codice)) { loginErr('Il codice deve essere di 6 cifre.'); return; }
    $('rd-login-err')?.classList.add('hidden');
    const btn = $('rd-verify') as HTMLButtonElement; btn.disabled = true; btn.textContent = 'Verifica…';
    const { data, error } = await supabase.functions.invoke('otp-verify', { body: { email: (window as any)._rdEmail, codice, scope: 'login' } });
    if (error || !data?.ok || !data?.session) { btn.disabled = false; btn.textContent = 'Verifica e accedi'; loginErr('Codice errato o scaduto.'); return; }
    await supabase.auth.setSession({ access_token: data.session.access_token, refresh_token: data.session.refresh_token });
    window.location.reload();
  });
  const logout = async () => { await supabase.auth.signOut(); window.location.reload(); };
  $('rd-logout')?.addEventListener('click', logout);
  $('rd-logout-2')?.addEventListener('click', logout);

  // ---- RIEPILOGO PER STATO ----
  // Una riga sola che dice quanti eventi ci sono in ogni stato. Serve a non
  // perdere di vista le cose approvate ma non ancora pubblicate: e' il punto
  // in cui il flusso si era inceppato la prima volta.
  async function aggiornaRiepilogo() {
    const el = $('rd-riepilogo');
    if (!el) return;
    const { data } = await supabase.from('eventi_esterni').select('stato');
    const righe = (data as { stato: string }[]) ?? [];
    if (!righe.length) { el.textContent = ''; return; }
    const conta: Record<string, number> = {};
    for (const r of righe) conta[r.stato] = (conta[r.stato] ?? 0) + 1;
    const ordine = ['grezzo', 'proposto', 'approvato', 'pubblicato', 'scartato', 'non_promuovibile'];
    const etichette: Record<string, string> = {
      grezzo: 'grezzi', proposto: 'da approvare', approvato: 'approvati, da pubblicare',
      pubblicato: 'pubblicati', scartato: 'scartati', non_promuovibile: 'non promuovibili',
    };
    el.textContent = ordine.filter((s) => conta[s])
      .map((s) => `${conta[s]} ${etichette[s]}`).join(' · ');
  }

  // ---- LISTA ----
  async function caricaLista() {
    const box = $('rd-lista')!;
    box.innerHTML = '<p class="text-[#1E2E26]/55 text-sm">Carico…</p>';

    let q = supabase.from('eventi_esterni')
      .select('*')
      .order('punteggio', { ascending: false, nullsFirst: false })
      .order('data_inizio', { ascending: true })
      .limit(200);

    const stato = val('rd-f-stato');
    const valle = val('rd-f-valle');
    const da = val('rd-f-da');
    const al = val('rd-f-al');
    if (stato) q = q.eq('stato', stato);
    if (valle) q = q.eq('valle', valle);
    if (da) q = q.gte('data_inizio', da);
    if (al) q = q.lte('data_inizio', al);

    const { data, error } = await q;
    if (error) { box.innerHTML = `<p class="text-[#a33] text-sm">Errore di lettura: ${esc(error.message)}</p>`; return; }

    const righe = (data as any[]) ?? [];
    // Riepilogo per stato, sempre visibile: e' cio' che dice a colpo d'occhio
    // dove sono finite le cose, senza dover cambiare filtro per scoprirlo.
    void aggiornaRiepilogo();

    ($('rd-conteggio') as HTMLElement).textContent =
      righe.length ? `${righe.length} eventi` : '';
    if (!righe.length) { box.innerHTML = '<p class="text-[#1E2E26]/55 text-sm">Nessun evento con questi filtri.</p>'; return; }

    box.innerHTML = righe.map((r) => scheda(r)).join('');
    agganciaAzioni();
  }

  function badgeStato(s: string): string {
    const stile: Record<string, string> = {
      pubblicato: 'background:#2d86591a;color:#2d8659;',
      approvato: 'background:#C8923E22;color:#8a6215;',
      proposto: 'background:#1E2E2611;color:#1E2E26;',
      scartato: 'background:#0000000d;color:#1E2E2680;',
      non_promuovibile: 'background:#a3331a;color:#a33;',
      grezzo: 'background:#0000000d;color:#1E2E2680;',
    };
    const etichette: Record<string, string> = {
      grezzo: 'Grezzo', proposto: 'Proposto', approvato: 'Approvato',
      pubblicato: 'Pubblicato', scartato: 'Scartato', non_promuovibile: 'Non promuovibile',
    };
    return `<span style="${stile[s] ?? ''}padding:2px 10px;border-radius:999px;font-size:12px;white-space:nowrap;">${etichette[s] ?? esc(s)}</span>`;
  }

  function scheda(r: any): string {
    const motivo = r.motivo_punteggio ?? {};
    const forti: string[] = Array.isArray(motivo.forti) ? motivo.forti : [];
    const flags: string[] = Array.isArray(r.flag) ? r.flag : [];

    const flagHtml = flags.length
      ? `<div class="flex flex-wrap gap-1 mt-2">${flags.map((f) =>
          `<span style="background:#C8923E18;color:#8a6215;padding:1px 8px;border-radius:999px;font-size:11px;">${esc(FLAG[f] ?? f)}</span>`).join('')}</div>`
      : '';

    const keyword = forti.length
      ? `<p class="m-0 mt-1 text-[12px] text-[#1E2E26]/45">parole chiave: ${esc(forti.slice(0, 6).join(', '))}</p>`
      : '';

    const motivazione = motivo.motivazione
      ? `<p class="m-0 mt-1 text-[13px] text-[#1E2E26]/65 italic">${esc(motivo.motivazione)}</p>`
      : '';

    // I bottoni disponibili dipendono dallo stato e dal livello di chi guarda.
    const azioni: string[] = [];
    if (r.stato === 'proposto') azioni.push(btn('approva', r.id, 'Approva', '#1E2E26'));
    if (r.stato === 'approvato' && livello >= 50) azioni.push(btn('pubblica', r.id, 'Pubblica', '#2d8659'));
    if (r.stato !== 'scartato' && r.stato !== 'pubblicato') azioni.push(btn('scarta', r.id, 'Scarta', '#a33'));
    if (r.url_fonte) {
      azioni.push(`<a href="${esc(r.url_fonte)}" target="_blank" rel="noopener noreferrer" class="text-sm text-[#8a6215] underline">Fonte</a>`);
    }

    const quando = [r.data_inizio, r.data_fine && r.data_fine !== r.data_inizio ? `→ ${r.data_fine}` : null]
      .filter(Boolean).join(' ');
    const dove = [r.luogo, r.comune ? `${r.comune}${r.valle ? ` (${VALLE[r.valle] ?? r.valle})` : ''}` : null]
      .filter(Boolean).join(' · ');

    return `<div class="bg-white border ${r.stato === 'proposto' ? 'border-[#C8923E]/60' : 'border-[#E5DFCF]'} rounded p-4">
      <div class="flex items-start gap-4">
        <div class="shrink-0 text-center" style="min-width:52px;">
          <div style="font-family:'Playfair Display',serif;font-size:26px;line-height:1;color:#1E2E26;">${r.punteggio ?? '–'}</div>
          <div class="text-[11px] text-[#1E2E26]/45">punti</div>
        </div>
        <div class="min-w-0 flex-1">
          <p class="m-0 text-[#1E2E26]"><strong>${esc(r.titolo)}</strong></p>
          <p class="m-0 text-[13px] text-[#1E2E26]/60">${esc(quando)}${dove ? ' · ' + esc(dove) : ''}</p>
          ${r.organizzatore ? `<p class="m-0 text-[13px] text-[#1E2E26]/60">a cura di ${esc(r.organizzatore)}</p>` : ''}
          ${r.pilastro ? `<p class="m-0 mt-1 text-[12px] text-[#8a6215]">pilastro proposto: ${esc(PILASTRO[r.pilastro] ?? r.pilastro)}</p>` : ''}
          ${motivazione}
          ${keyword}
          ${flagHtml}
        </div>
        <div class="shrink-0 text-right">
          ${badgeStato(r.stato)}
          <div class="flex flex-col items-end gap-2 mt-3">${azioni.join('')}</div>
        </div>
      </div>
      <p class="hidden text-[13px] mt-2 rounded px-3 py-2" data-esito="${r.id}"></p>
    </div>`;
  }

  function btn(azione: string, id: string, testo: string, colore: string): string {
    return `<button type="button" data-azione="${azione}" data-id="${id}"
      class="text-sm underline bg-transparent border-0 cursor-pointer p-0" style="color:${colore};">${testo}</button>`;
  }

  function agganciaAzioni() {
    document.querySelectorAll('[data-azione]').forEach((b) => {
      b.addEventListener('click', async () => {
        const el = b as HTMLButtonElement;
        const azione = el.dataset.azione!;
        const id = el.dataset.id!;

        if (azione === 'pubblica' && !window.confirm('Pubblicare questo evento? Diventa visibile a tutti sul sito.')) return;
        if (azione === 'scarta' && !window.confirm('Scartare questo evento? Resta in archivio per tarare il classificatore.')) return;

        const esito = document.querySelector(`[data-esito="${id}"]`) as HTMLElement | null;
        el.disabled = true; const testo = el.textContent; el.textContent = '…';

        const { data: { session } } = await supabase.auth.getSession();
        let ok = false, messaggio = '';
        try {
          const { data, error } = await supabase.functions.invoke('radar-eventi-azione', {
            body: { azione, id },
            headers: { Authorization: `Bearer ${session?.access_token ?? ''}` },
          });
          if (error) {
            // L'edge risponde JSON anche sugli errori: leggiamo il messaggio vero.
            const dettaglio = await (error as any).context?.json?.().catch(() => null);
            messaggio = dettaglio?.error ?? 'Azione non riuscita.';
          } else if (data?.ok) {
            ok = true; messaggio = 'Fatto.';
          } else {
            messaggio = data?.error ?? 'Azione non riuscita.';
          }
        } catch (e) {
          messaggio = 'Azione non riuscita: ' + String(e);
        }

        el.disabled = false; el.textContent = testo;

        // Un evento cambia stato e quindi ESCE dal filtro corrente: se restassimo
        // fermi, la riga sparirebbe senza spiegazione e il curatore penserebbe di
        // aver finito. Invece la si segue: il filtro si sposta sullo stato nuovo,
        // dove la riga e' ancora li' col bottone del passo dopo.
        // (1/8/2026: e' esattamente cosi' che la prima pubblicazione non e'
        //  andata a buon fine. Approvare non e' pubblicare, sono due gesti.)
        const dopo: Record<string, string> = {
          approva: 'approvato', pubblica: 'pubblicato', scarta: 'scartato',
        };
        const nuovoStato = dopo[azione];
        const seguo = ok && nuovoStato && val('rd-f-stato') !== nuovoStato;

        if (esito) {
          esito.classList.remove('hidden');
          const dove = azione === 'approva'
            ? ": da lì si pubblica."
            : ".";
          esito.textContent = ok && seguo
            ? `${messaggio} Ora è in «${nuovoStato}»${dove}`
            : messaggio;
          esito.style.background = ok ? '#eaf6ef' : '#fbecec';
          esito.style.color = '#1E2E26';
        }

        if (ok) {
          if (seguo) ($('rd-f-stato') as HTMLSelectElement).value = nuovoStato;
          await caricaLista();
        }
      });
    });
  }

  ['rd-f-stato', 'rd-f-valle', 'rd-f-da', 'rd-f-al'].forEach((id) => {
    $(id)?.addEventListener('change', () => { caricaLista(); });
  });

  init();
</script>
