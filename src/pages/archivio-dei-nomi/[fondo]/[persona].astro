---
// Archivio dei nomi — scheda di una persona (brief 25/8/2026).
// noindex: il fondo è ancora in bozza, in attesa del consenso del ricercatore
// e delle condizioni dell'Archivio di Stato austriaco. Una pagina per uomo:
// chi cerca un cognome deve trovare un nome nel titolo, non una tabella.
import Layout from '../../../layouts/Layout.astro';
import { leggiFondo, leggiPersone, conNome, dataLeggibile, titoloPersona, type Fondo, type Persona } from '../../../lib/memoria';

export async function getStaticPaths() {
  const fondo = await leggiFondo('cimitero-militare-male');
  if (!fondo) return [];
  const persone = await leggiPersone(fondo.slug);
  return persone
    .filter((p) => p.slug && conNome(p))
    .map((p) => ({ params: { fondo: fondo.slug, persona: p.slug }, props: { fondo, persona: p } }));
}

interface Props { fondo: Fondo; persona: Persona }
const { fondo, persona } = Astro.props as Props;

const morte = dataLeggibile(persona.data_morte_testo);
const titolo = titoloPersona(persona);
const nascita = [persona.anno_nascita, persona.luogo_nascita].filter(Boolean).join(', ');
const descrizione = `${persona.nome_completo}` + (nascita ? `, nato nel ${persona.anno_nascita ?? ''}${persona.luogo_nascita ? ' a ' + persona.luogo_nascita : ''}` : '') + `. Sepolto nel cimitero militare di Malè.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: persona.nome_completo,
  deathDate: persona.data_morte ?? undefined,
  birthYear: persona.anno_nascita ?? undefined,
  birthPlace: persona.luogo_nascita ?? undefined,
};

export const prerender = true;
---

<Layout title={titolo} description={descrizione} noindex={true}>
  <section class="bg-[#1E2E26] text-[#F5EEDD] py-16">
    <div class="max-w-2xl mx-auto px-6">
      <a href={`/archivio-dei-nomi/${fondo.slug}`} class="text-[13px] text-[#F5EEDD]/60 no-underline hover:text-[#C8923E]" style="font-family: 'Inter', sans-serif;">← {fondo.titolo}</a>
      <p class="text-[11px] tracking-[0.22em] uppercase text-[#C8923E] font-medium m-0 mt-5 mb-3" style="font-family: 'Inter', sans-serif;">
        {persona.settore === 'militare' ? 'Cimitero militare' : 'Cimitero civile'} · {persona.ignoto ? 'tomba senza nome' : `tomba ${persona.numero ?? '—'}`}
      </p>
      <h1 class="text-3xl md:text-4xl leading-[1.1] tracking-tight m-0" style="font-family: 'Playfair Display', serif; font-weight: 500;">
        {persona.nome_completo}
      </h1>
      {(persona.grado || persona.reparto) && (
        <p class="text-lg text-[#F5EEDD]/80 mt-3 mb-0" style="font-family: 'Source Serif 4', Georgia, serif;">
          {[persona.grado, persona.reparto].filter(Boolean).join(' · ')}
        </p>
      )}
    </div>
  </section>

  <section class="bg-[#FDF9F0] py-14">
    <div class="max-w-2xl mx-auto px-6" style="font-family: 'Source Serif 4', Georgia, serif;">
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-5 mb-10">
        {morte && (
          <div>
            <dt class="text-[11px] tracking-[0.14em] uppercase text-[#8a6215]" style="font-family: 'Inter', sans-serif;">Morto</dt>
            <dd class="m-0 text-[#1E2E26] text-base">il {morte}, a Malè</dd>
          </div>
        )}
        {nascita && (
          <div>
            <dt class="text-[11px] tracking-[0.14em] uppercase text-[#8a6215]" style="font-family: 'Inter', sans-serif;">Nato</dt>
            <dd class="m-0 text-[#1E2E26] text-base">{persona.anno_nascita ?? ''} {persona.luogo_nascita ? `a ${persona.luogo_nascita}` : ''}</dd>
          </div>
        )}
        {persona.regione_nascita && (
          <div>
            <dt class="text-[11px] tracking-[0.14em] uppercase text-[#8a6215]" style="font-family: 'Inter', sans-serif;">Provenienza</dt>
            <dd class="m-0 text-[#1E2E26] text-base">{persona.regione_nascita}</dd>
          </div>
        )}
        {persona.prigioniero_guerra && (
          <div>
            <dt class="text-[11px] tracking-[0.14em] uppercase text-[#8a6215]" style="font-family: 'Inter', sans-serif;">Condizione</dt>
            <dd class="m-0 text-[#1E2E26] text-base">Prigioniero di guerra</dd>
          </div>
        )}
        <div>
          <dt class="text-[11px] tracking-[0.14em] uppercase text-[#8a6215]" style="font-family: 'Inter', sans-serif;">Sepoltura</dt>
          <dd class="m-0 text-[#1E2E26] text-base">
            {persona.ignoto ? 'Tomba senza nome' : `Tomba ${persona.numero ?? '—'}`}, {persona.settore === 'militare' ? 'cimitero militare' : 'cimitero civile'}
          </dd>
        </div>
      </dl>

      <p class="text-[13px] text-[#1E2E26]/55 mb-8" style="font-family: 'Inter', sans-serif;">
        Fonte: {fondo.archivio}{fondo.segnatura ? `, ${fondo.segnatura}` : ''}. Ricerca di {fondo.ricercatore}.
      </p>

      <div class="flex flex-wrap gap-3">
        <a href={`/archivio-dei-nomi/${fondo.slug}`} class="inline-block bg-[#1E2E26] text-[#F5EEDD] px-5 py-3 rounded-lg font-semibold text-sm no-underline hover:opacity-90" style="font-family: 'Inter', sans-serif;">Tutte le persone del fondo</a>
        <a href={`/archivio-dei-nomi/${fondo.slug}/mappa`} class="inline-block bg-white text-[#1E2E26] border-2 border-[#1E2E26] px-5 py-3 rounded-lg font-semibold text-sm no-underline hover:bg-[#F8F1E4]" style="font-family: 'Inter', sans-serif;">Vedi sulla planimetria</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</Layout>
