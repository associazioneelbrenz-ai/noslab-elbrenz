---
// Archivio dei nomi — planimetria navigabile (brief 25/8/2026, §3.3).
// Adattata da i-nomi-di-male.html: stessa griglia a serpentina (nove file da
// ventiquattro nel militare) e stesse posizioni nel civile, lette da
// memoria_fondo.planimetria_geo — non incollate nel file. Il blu resta solo
// dentro il foglio, è la cianografia e non l'Associazione. Ogni riquadro con
// un nome è un link vero alla scheda della persona (non solo una scheda
// interna come nello strumento originale): niente Leaflet, nessuna libreria
// esterna. noindex: fondo ancora in bozza.
import Layout from '../../../layouts/Layout.astro';
import { leggiFondo, leggiPersone, type Persona } from '../../../lib/memoria';

export async function getStaticPaths() {
  const fondo = await leggiFondo('cimitero-militare-male');
  if (!fondo) return [];
  return [{ params: { fondo: fondo.slug } }];
}

const fondo = await leggiFondo(Astro.params.fondo as string);
if (!fondo) return Astro.redirect('/archivio-dei-nomi');
const persone = await leggiPersone(fondo.slug);

type Geo = { righe: number[][]; civpos: Record<string, [number, number]>; nota?: string };
const geo = (fondo.planimetria_geo as Geo | null) ?? { righe: [], civpos: {} };

const perNumero = new Map<string, Persona>();
for (const p of persone) {
  if (p.settore && p.numero != null) perNumero.set(`${p.settore}:${p.numero}`, p);
}
function trova(settore: string, numero: number): Persona | undefined {
  return perNumero.get(`${settore}:${numero}`);
}
function haNome(p: Persona | undefined): boolean {
  return !!p?.nome_completo && p.nome_completo !== 'sconosciuto';
}

export const prerender = true;
---

<Layout title={`Planimetria · ${fondo.titolo}`} description="Planimetria navigabile del cimitero militare di Malè." noindex={true}>
  <style>
    /* Il blu resta solo dentro il foglio: e' la cianografia, non l'Associazione. */
    .foglio {
      background: #123A5E; border: 1px solid rgba(34,48,31,.25);
      padding: 1.75rem 1.25rem 2rem; margin: 1.5rem 0; position: relative; overflow-x: auto;
    }
    .foglio::before { content: ""; position: absolute; inset: .5rem; border: 1px solid rgba(191,216,236,.32); pointer-events: none; }
    .titolo-foglio { font-family: 'Playfair Display', serif; font-style: italic; font-size: 1.4rem; text-align: center; color: #BFD8EC; margin: .25rem 0 1.5rem; }
    .pianta { min-width: 660px; display: flex; flex-direction: column; gap: 6px; align-items: center; }
    .fila { display: flex; gap: 5px; align-items: center; }
    .corridoio { width: 26px; }
    .tomba {
      width: 22px; height: 30px; border: 1px solid #BFD8EC; background: transparent; padding: 0;
      font-family: monospace; font-size: .5rem; color: rgba(191,216,236,.6);
      display: flex; align-items: center; justify-content: center; text-decoration: none;
      transition: transform .12s;
    }
    .tomba.nota { background: #C9962F; border-color: #E3B75C; color: #0B2138; font-weight: 700; }
    .tomba.pow { background: #E3B75C; border-color: #fff; }
    a.tomba:hover, a.tomba:focus { transform: scale(1.35); z-index: 5; outline: none; box-shadow: 0 0 0 2px #F5EFE0; }
    .tomba.spenta { opacity: .18; }
    .civile-box { min-width: 340px; height: 340px; position: relative; margin: 0 auto; }
    .civile-box .tomba { position: absolute; }
    .legenda { display: flex; flex-wrap: wrap; gap: 1.25rem; font-family: monospace; font-size: .68rem; color: rgba(30,46,38,.62); margin-top: 1.25rem; }
    .campione { display: inline-block; width: 13px; height: 17px; border: 1px solid rgba(30,46,38,.45); vertical-align: -3px; margin-right: .45rem; }
    .campione.nota { background: #C9962F; border-color: #E3B75C; }
    .campione.pow { background: #E3B75C; border-color: #fff; }
  </style>

  <header class="bg-[#1E2E26] text-[#F5EEDD] py-14">
    <div class="max-w-4xl mx-auto px-6">
      <a href={`/archivio-dei-nomi/${fondo.slug}`} class="text-[13px] text-[#F5EEDD]/60 no-underline hover:text-[#C8923E]" style="font-family: 'Inter', sans-serif;">← {fondo.titolo}</a>
      <h1 class="text-3xl md:text-4xl leading-[1.1] tracking-tight m-0 mt-4" style="font-family: 'Playfair Display', serif; font-weight: 500;">Planimetria</h1>
      <p class="text-base text-[#F5EEDD]/80 mt-3 max-w-xl" style="font-family: 'Source Serif 4', Georgia, serif;">
        Tocca un riquadro dorato per aprire la scheda della persona sepolta in quella tomba.
      </p>
    </div>
  </header>

  <div class="bg-[#F8F1E4] py-10">
    <div class="max-w-4xl mx-auto px-6">
      <input id="an-cerca-mappa" type="search" placeholder="Cerca un cognome, un reparto, un luogo di nascita"
        aria-label="Cerca fra i caduti" class="w-full border border-[#E5DFCF] rounded-lg px-4 py-3 text-base mb-2"
        style="font-family: 'Source Serif 4', Georgia, serif;" />
      <p id="an-esiti-mappa" class="text-[12px] font-mono text-[#1E2E26]/55 m-0 min-h-[1.2em]" role="status"></p>

      <section class="foglio">
        <p class="titolo-foglio">Cimitero Militare di Malè</p>
        <div class="pianta">
          {geo.righe.map((fila) => (
            <div class="fila">
              {fila.map((n, i) => {
                const p = trova('militare', n);
                const nome = haNome(p);
                const cerca = p ? [p.nome_completo, p.reparto, p.luogo_nascita, p.regione_nascita].filter(Boolean).join(' ').toLowerCase() : '';
                return (
                  <>
                    {i === 12 && <span class="corridoio" />}
                    {nome && p?.slug ? (
                      <a href={`/archivio-dei-nomi/${fondo.slug}/${p.slug}`} class={`tomba nota${p.prigioniero_guerra ? ' pow' : ''}`}
                        data-cerca={cerca} title={p.nome_completo ?? ''} aria-label={`Tomba ${n}: ${p.nome_completo}`}>{n}</a>
                    ) : (
                      <span class="tomba" aria-label={`Tomba ${n}: senza nome`}>{n}</span>
                    )}
                  </>
                );
              })}
            </div>
          ))}
        </div>
        <p class="text-center italic mt-5" style="color: rgba(191,216,236,.6); font-family: 'Playfair Display', serif;">Scala 1:100</p>
      </section>

      <section class="foglio">
        <p class="titolo-foglio">Cimitero Civile di Malè · Tombe militari</p>
        <div class="civile-box">
          {Object.entries(geo.civpos).map(([n, xy]) => {
            const p = trova('civile', Number(n));
            const nome = haNome(p);
            const cerca = p ? [p.nome_completo, p.reparto, p.luogo_nascita, p.regione_nascita].filter(Boolean).join(' ').toLowerCase() : '';
            return nome && p?.slug ? (
              <a href={`/archivio-dei-nomi/${fondo.slug}/${p.slug}`} class={`tomba nota${p.prigioniero_guerra ? ' pow' : ''}`}
                style={`left:${xy[0]}%;top:${xy[1]}%`} data-cerca={cerca} title={p.nome_completo ?? ''} aria-label={`Tomba ${n}: ${p.nome_completo}`}>{n}</a>
            ) : (
              <span class="tomba" style={`left:${xy[0]}%;top:${xy[1]}%`} aria-label={`Tomba ${n}: senza nome`}>{n}</span>
            );
          })}
        </div>
      </section>

      <div class="legenda">
        <span><i class="campione nota"></i>tomba con un nome</span>
        <span><i class="campione pow"></i>prigioniero di guerra</span>
        <span><i class="campione"></i>tomba senza nome nel registro</span>
      </div>

      {geo.nota && (
        <div class="border-l-2 border-[#C8923E] pl-4 mt-8 max-w-2xl">
          <p class="text-sm text-[#1E2E26]/70" style="font-family: 'Source Serif 4', Georgia, serif;"><strong>La disposizione delle tombe è una ricostruzione.</strong> {geo.nota}</p>
        </div>
      )}
    </div>
  </div>

  <script is:inline>
    const input = document.getElementById('an-cerca-mappa');
    const esiti = document.getElementById('an-esiti-mappa');
    const tombe = Array.from(document.querySelectorAll('.tomba'));
    input?.addEventListener('input', () => {
      const t = input.value.trim().toLowerCase();
      if (!t) { tombe.forEach((b) => b.classList.remove('spenta')); if (esiti) esiti.textContent = ''; return; }
      let trovati = 0;
      tombe.forEach((b) => {
        const cerca = b.getAttribute('data-cerca');
        const ok = !!cerca && cerca.includes(t);
        b.classList.toggle('spenta', !ok);
        if (ok) trovati++;
      });
      if (esiti) esiti.textContent = trovati === 0 ? 'Nessun nome corrisponde.' : trovati + (trovati === 1 ? ' tomba trovata.' : ' tombe trovate.');
    });
  </script>
</Layout>
