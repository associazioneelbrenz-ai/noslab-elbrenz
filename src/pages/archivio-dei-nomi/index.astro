---
// Archivio dei nomi — indice della sezione (brief 25/8/2026). Un fondo solo
// per ora, costruito come elenco perché il giorno che arriva il registro del
// Tonale si aggiunge una riga a memoria_fondo e questa pagina si aggiorna da
// sola. noindex: in bozza, in attesa del consenso del ricercatore.
import Layout from '../../layouts/Layout.astro';
import { leggiFondo } from '../../lib/memoria';

const fondo = await leggiFondo('cimitero-militare-male');
export const prerender = true;
---

<Layout title="L'archivio dei nomi" description="Registri, elenchi e sepolture dell'impero nelle nostre valli, un documento alla volta." noindex={true}>
  <header class="bg-[#1E2E26] text-[#F5EEDD] py-16">
    <div class="max-w-3xl mx-auto px-6">
      <p class="text-[11px] tracking-[0.22em] uppercase text-[#C8923E] font-medium m-0 mb-5" style="font-family: 'Inter', sans-serif;">Associazione El Brenz · Valli del Noce</p>
      <h1 class="text-4xl md:text-5xl leading-[1.08] tracking-tight m-0 mb-6" style="font-family: 'Playfair Display', serif; font-weight: 500;">
        L'archivio <em class="text-[#C8923E]" style="font-style: italic;">dei nomi</em>
      </h1>
      <p class="text-lg text-[#F5EEDD]/85 max-w-xl" style="font-family: 'Source Serif 4', Georgia, serif;">
        Chi è passato di qui e non è più tornato a casa. Registri, elenchi e sepolture dell'impero nelle nostre valli, un documento alla volta.
      </p>
    </div>
  </header>

  <section class="bg-[#FDF9F0] py-14">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-2xl text-[#1E2E26] mb-6" style="font-family: 'Playfair Display', serif; font-weight: 500;">I fondi</h2>
      {fondo ? (
        <a href={`/archivio-dei-nomi/${fondo.slug}`} class="block bg-white border border-[#E5DFCF] rounded-lg p-6 no-underline hover:border-[#C8923E] transition-colors">
          <span class="block text-[11px] tracking-[0.14em] uppercase text-[#8a6215] mb-2" style="font-family: 'Inter', sans-serif;">{fondo.comune}{fondo.anno_da ? ` · ${fondo.anno_da}–${fondo.anno_a}` : ''}</span>
          <span class="block text-2xl text-[#1E2E26] mb-2" style="font-family: 'Playfair Display', serif;">{fondo.titolo}</span>
          {fondo.sottotitolo && <span class="block text-[#1E2E26]/70 text-base" style="font-family: 'Source Serif 4', Georgia, serif;">{fondo.sottotitolo}</span>}
        </a>
      ) : (
        <p class="text-[#1E2E26]/60">Nessun fondo disponibile.</p>
      )}
    </div>
  </section>
</Layout>
