---
/**
 * /eventi — il calendario. Due blocchi, in quest'ordine:
 *   A. I nostri appuntamenti, da `evento` (pubblicato = true).
 *   B. Gli appuntamenti delle valli, dalla vista `eventi_esterni_pubblici`,
 *      che espone SOLO lo stato 'pubblicato' e nessun dato personale.
 *
 * Niente harvester: le voci del blocco B sono curate a mano e diventano
 * pubbliche solo passando da `approvato` e poi `pubblicato` nel pannello
 * /radar-eventi. Le voci `non_promuovibile` (organizzatori esclusi per
 * delibera del direttivo) NON entrano nella vista, quindi non possono
 * comparire qui nemmeno per errore: il filtro sta a database, non nel markup.
 *
 * SSR perche' i dati cambiano quando il curatore pubblica, non quando si fa il
 * build. `/rievocazioni` resta il pilastro editoriale; questa e' l'agenda.
 */
import Layout from '../layouts/Layout.astro';
import { createClient } from '@supabase/supabase-js';
import { getStatoGita } from '../lib/postiGita';

export const prerender = false;

const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL as string;
const SUPABASE_ANON = import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string;

// [3/8/2026] Stato della gita da config_app (fonte unica, come l'edge).
const { annullata: gitaAnnullata } = await getStatoGita();

type Nostro = {
  id: string; titolo: string; descrizione: string | null; tipo: string | null;
  luogo: string | null; inizio: string; fine: string | null;
  immagine_url: string | null; capienza_max: number | null;
};
type Esterno = {
  id: string; slug: string | null; titolo: string; descrizione: string | null;
  data_inizio: string; data_fine: string | null; ricorrenza: string | null;
  ora_inizio: string | null; ora_fine: string | null;
  luogo: string | null; comune: string | null; valle: string | null;
  organizzatore: string | null; url_fonte: string | null;
  prezzo: string | null; pilastro: number | null;
};

let nostri: Nostro[] = [];
let esterni: Esterno[] = [];
let posti: { posti_totali: number; posti_occupati: number } | null = null;

const oggiIso = new Date().toISOString().slice(0, 10);
try {
  const sb = createClient(SUPABASE_URL, SUPABASE_ANON, { auth: { persistSession: false } });
  const [a, b, p] = await Promise.all([
    sb.from('evento')
      .select('id, titolo, descrizione, tipo, luogo, inizio, fine, immagine_url, capienza_max')
      .eq('pubblicato', true).order('inizio', { ascending: true }),
    sb.from('eventi_esterni_pubblici')
      .select('id, slug, titolo, descrizione, data_inizio, data_fine, ricorrenza, ora_inizio, ora_fine, luogo, comune, valle, organizzatore, url_fonte, prezzo, pilastro')
      .order('data_inizio', { ascending: true }),
    sb.from('v_posti_gita').select('posti_totali, posti_occupati').maybeSingle(),
  ]);
  nostri = ((a.data as Nostro[]) ?? []).filter((e) => (e.fine ?? e.inizio).slice(0, 10) >= oggiIso);
  // Un ricorrente resta in cartellone fino alla data_fine; gli altri fino al giorno stesso.
  esterni = ((b.data as Esterno[]) ?? []).filter((e) => (e.data_fine ?? e.data_inizio) >= oggiIso);
  posti = (p.data as typeof posti) ?? null;
} catch (e) {
  console.error('[eventi] lettura fallita:', e);
}

const VALLE: Record<string, string> = {
  non: 'Val di Non', sole: 'Val di Sole', rabbi: 'Val di Rabbi', pejo: 'Val di Pejo',
};
const PILASTRO: Record<number, string> = {
  1: 'Storia delle Valli', 2: 'Lingua e ladinità', 3: 'Cultura materiale',
  4: 'Rievocazioni ed eventi', 5: 'Identità e appartenenza', 6: 'Vita associativa',
};
const PREZZO: Record<string, string> = {
  gratuito: 'Ingresso libero', pagamento: 'A pagamento', offerta: 'A offerta', nd: '',
};
const MESI = ['gennaio', 'febbraio', 'marzo', 'aprile', 'maggio', 'giugno',
  'luglio', 'agosto', 'settembre', 'ottobre', 'novembre', 'dicembre'];

/** Data estesa, come vuole il tono di casa: «22 agosto 2026». */
function dataEstesa(iso: string): string {
  const d = new Date(`${iso.slice(0, 10)}T12:00:00`);
  return `${d.getDate()} ${MESI[d.getMonth()]} ${d.getFullYear()}`;
}
/** Una data sola, oppure «dal … al …». */
function periodo(da: string, a: string | null): string {
  if (!a || a.slice(0, 10) === da.slice(0, 10)) return dataEstesa(da);
  return `dal ${dataEstesa(da)} al ${dataEstesa(a)}`;
}
const oraBreve = (t: string | null) => (t ? t.slice(0, 5) : '');

// Filtri: solo le opzioni davvero presenti, per non offrire caselle vuote.
const valliPresenti = [...new Set(esterni.map((e) => e.valle).filter((v): v is string => !!v))];
const pilastriPresenti = [...new Set(esterni.map((e) => e.pilastro).filter((p): p is number => !!p))].sort();
const postiLiberi = posti ? Math.max(0, posti.posti_totali - posti.posti_occupati) : null;
---

<Layout
  title="Eventi e appuntamenti delle Valli del Noce · El Brenz"
  description="Il calendario dell'Associazione El Brenz e gli appuntamenti di storia, lingua e cultura materiale delle Valli del Noce: Val di Non, Val di Sole, Val di Rabbi e Val di Pejo."
  ogImage="/og/og-eventi.jpg"
>
  <main class="bg-[#F8F1E4] min-h-screen">
    <div class="max-w-4xl mx-auto px-6 py-12 md:py-16" style="font-family: 'Inter', sans-serif;">

      <p class="text-[11px] tracking-[0.22em] uppercase text-[#8a6215] font-semibold m-0 mb-3">Calendario</p>
      <h1 class="text-3xl md:text-4xl leading-tight text-[#1E2E26] m-0 mb-5" style="font-family: 'Playfair Display', serif; font-weight: 500;">
        Eventi e appuntamenti delle valli
      </h1>
      <p class="text-[#1E2E26]/80 leading-relaxed max-w-2xl m-0 mb-12" style="font-family: 'Source Serif 4', Georgia, serif; font-size: 1.05rem;">
        Le nostre occasioni per ritrovarsi, e gli appuntamenti delle Valli del Noce che riguardano
        la storia, la lingua e la cultura materiale. Quelli di altri li scegliamo uno per uno: qui
        non c'è tutto quello che succede, c'è quello che vale la pena non perdersi.
      </p>

      {/* ---------------- BLOCCO A: i nostri appuntamenti ---------------- */}
      <section class="mb-16">
        <h2 class="text-[13px] tracking-[0.2em] uppercase text-[#8a6215] font-medium mb-5 pb-2 border-b border-[#C8923E]/30">
          I nostri appuntamenti
        </h2>

        {nostri.length === 0 ? (
          <p class="text-[#1E2E26]/70 py-2" style="font-family: 'Source Serif 4', Georgia, serif;">
            Al momento non ci sono appuntamenti in programma. Torneranno presto.
          </p>
        ) : (
          <div class="space-y-6">
            {nostri.map((e) => (
              <article class="bg-white border border-[#E5DFCF] rounded-md overflow-hidden">
                {e.immagine_url && (
                  <img src={e.immagine_url} alt="" width="1200" height="630" loading="lazy" decoding="async"
                       class="w-full h-48 md:h-60 object-cover" />
                )}
                <div class="p-6 md:p-8">
                  <p class="text-[13px] text-[#8a6215] m-0 mb-2">
                    {periodo(e.inizio, e.fine)}{e.luogo ? ` · ${e.luogo}` : ''}
                  </p>
                  <h3 class="text-xl md:text-2xl text-[#1E2E26] m-0 mb-3" style="font-family: 'Playfair Display', serif; font-weight: 500;">
                    {e.titolo}
                  </h3>
                  {e.descrizione && (
                    <p class="text-[#1E2E26]/80 leading-relaxed m-0 mb-5" style="font-family: 'Source Serif 4', Georgia, serif;">
                      {e.descrizione}
                    </p>
                  )}

                  {e.tipo === 'gita' && (
                    <div class="flex flex-wrap items-center gap-4">
                      {gitaAnnullata ? (
                        <span class="inline-block bg-[#8a3a3a] text-[#F5EEDD] px-5 py-3 rounded font-semibold text-sm">
                          Annullata
                        </span>
                      ) : (
                        <a href="/gita-giochi-medievali-2026/iscrizione"
                           class="inline-block bg-[#C8923E] text-[#1E2E26] px-5 py-3 rounded font-semibold text-sm no-underline hover:bg-[#D9A94E] transition-colors">
                          Iscriviti alla gita
                        </a>
                      )}
                      <a href="/gita-giochi-medievali-2026" class="text-sm text-[#8a6215] underline">Tutti i dettagli</a>
                      {postiLiberi !== null && (
                        <span class="text-[13px] text-[#1E2E26]/60">
                          {postiLiberi > 0
                            ? `${postiLiberi} posti ancora liberi su ${posti!.posti_totali}`
                            : 'Posti esauriti'}
                        </span>
                      )}
                    </div>
                  )}
                </div>
              </article>
            ))}
          </div>
        )}
      </section>

      {/* ---------------- BLOCCO B: gli appuntamenti delle valli ---------------- */}
      <section>
        <h2 class="text-[13px] tracking-[0.2em] uppercase text-[#8a6215] font-medium mb-2 pb-2 border-b border-[#C8923E]/30">
          Gli appuntamenti delle valli
        </h2>
        <p class="text-[13px] text-[#1E2E26]/55 m-0 mb-6">
          Scelti a mano fra i programmi delle valli. Le informazioni sono di chi organizza:
          conviene sempre verificare sulla fonte prima di mettersi in viaggio.
        </p>

        {esterni.length === 0 ? (
          <p class="text-[#1E2E26]/70 py-2" style="font-family: 'Source Serif 4', Georgia, serif;">
            Stiamo scegliendo i prossimi appuntamenti da segnalare. Passate fra qualche giorno.
          </p>
        ) : (
          <>
            {(valliPresenti.length > 1 || pilastriPresenti.length > 1) && (
              <div class="flex flex-wrap gap-2 mb-6">
                <button type="button" data-filtro="tutti" data-valore=""
                        class="ev-chip ev-attivo text-[13px] px-3 py-1.5 rounded-full border border-[#C8923E]/50 bg-[#C8923E]/15 text-[#1E2E26] cursor-pointer">
                  Tutti
                </button>
                {valliPresenti.map((v) => (
                  <button type="button" data-filtro="valle" data-valore={v}
                          class="ev-chip text-[13px] px-3 py-1.5 rounded-full border border-[#E5DFCF] bg-white text-[#1E2E26] cursor-pointer">
                    {VALLE[v] ?? v}
                  </button>
                ))}
                {pilastriPresenti.map((p) => (
                  <button type="button" data-filtro="pilastro" data-valore={String(p)}
                          class="ev-chip text-[13px] px-3 py-1.5 rounded-full border border-[#E5DFCF] bg-white text-[#1E2E26] cursor-pointer">
                    {PILASTRO[p] ?? `Pilastro ${p}`}
                  </button>
                ))}
              </div>
            )}

            <p id="ev-vuoto" class="hidden text-[#1E2E26]/70 py-2" style="font-family: 'Source Serif 4', Georgia, serif;">
              Nessun appuntamento con questo filtro.
            </p>

            <div class="space-y-3">
              {esterni.map((e) => (
                <article class="ev-voce bg-white border border-[#E5DFCF] rounded p-4 md:p-5"
                         data-valle={e.valle ?? ''} data-pilastro={e.pilastro ?? ''}>
                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-1">
                    <p class="text-[13px] text-[#8a6215] m-0">
                      {/* Un ricorrente si mostra UNA volta con la sua cadenza,
                          non esploso in una riga per settimana. */}
                      {e.ricorrenza
                        ? `${e.ricorrenza}${e.data_fine ? `, fino al ${dataEstesa(e.data_fine)}` : ''}`
                        : periodo(e.data_inizio, e.data_fine)}
                      {oraBreve(e.ora_inizio) ? ` · ore ${oraBreve(e.ora_inizio)}` : ''}
                    </p>
                    {e.prezzo && PREZZO[e.prezzo] && (
                      <span class="text-[12px] text-[#1E2E26]/55">· {PREZZO[e.prezzo]}</span>
                    )}
                  </div>

                  {/* AGGIUNTA 1/8/2026 — il titolo porta alla scheda dell'evento
                      (/eventi/<slug>), che ha la sua OG e il suo JSON-LD. Se lo
                      slug mancasse resta testo semplice: nessuna voce sparisce. */}
                  <h3 class="text-lg text-[#1E2E26] m-0 mb-1" style="font-family: 'Playfair Display', serif; font-weight: 500;">
                    {e.slug
                      ? <a href={`/eventi/${e.slug}`} class="text-[#1E2E26] no-underline hover:underline">{e.titolo}</a>
                      : e.titolo}
                  </h3>

                  <p class="text-[13px] text-[#1E2E26]/65 m-0 mb-2">
                    {[e.luogo, e.comune ? `${e.comune}${e.valle ? ` (${VALLE[e.valle] ?? e.valle})` : ''}` : null]
                      .filter(Boolean).join(' · ')}
                    {e.organizzatore ? ` · a cura di ${e.organizzatore}` : ''}
                  </p>

                  {e.descrizione && (
                    <p class="text-[#1E2E26]/80 leading-relaxed m-0" style="font-family: 'Source Serif 4', Georgia, serif;">
                      {e.descrizione}
                    </p>
                  )}

                  {e.url_fonte && (
                    <p class="m-0 mt-2">
                      <a href={e.url_fonte} target="_blank" rel="noopener noreferrer"
                         class="text-sm text-[#8a6215] underline">Informazioni dell'organizzatore</a>
                    </p>
                  )}
                </article>
              ))}
            </div>
          </>
        )}
      </section>

      <p class="mt-12 text-[13px] text-[#1E2E26]/55 leading-relaxed">
        Organizzi qualcosa che riguarda la storia, la lingua o la cultura materiale delle valli?
        Scrivici a <a href="mailto:info@elbrenz.eu" class="text-[#8a6215] underline">info@elbrenz.eu</a>
        e lo valutiamo per il calendario.
      </p>

      <p class="mt-10 text-center text-[#1E2E26]/50" style="font-family: 'Source Serif 4', Georgia, serif;">
        <em>Raìs fonde no le 'nglacia.</em>
      </p>
    </div>
  </main>
</Layout>

<script>
  // Venti voci: il filtro e' mostrare e nascondere, senza librerie.
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.ev-chip'));
  const voci = Array.from(document.querySelectorAll<HTMLElement>('.ev-voce'));
  const vuoto = document.getElementById('ev-vuoto');

  function applica(filtro: string, valore: string) {
    let visibili = 0;
    for (const v of voci) {
      const ok = filtro === 'tutti'
        || (filtro === 'valle' && v.dataset.valle === valore)
        || (filtro === 'pilastro' && v.dataset.pilastro === valore);
      v.classList.toggle('hidden', !ok);
      if (ok) visibili++;
    }
    vuoto?.classList.toggle('hidden', visibili > 0);
  }

  for (const c of chips) {
    c.addEventListener('click', () => {
      for (const altro of chips) {
        altro.classList.remove('ev-attivo', 'bg-[#C8923E]/15', 'border-[#C8923E]/50');
        altro.classList.add('bg-white', 'border-[#E5DFCF]');
      }
      c.classList.add('ev-attivo', 'bg-[#C8923E]/15', 'border-[#C8923E]/50');
      c.classList.remove('bg-white', 'border-[#E5DFCF]');
      applica(c.dataset.filtro ?? 'tutti', c.dataset.valore ?? '');
    });
  }
</script>
