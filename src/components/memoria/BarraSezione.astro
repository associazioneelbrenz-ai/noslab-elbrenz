---
// Cimiteri di guerra — barra di navigazione di sezione (brief "Navigazione
// della sezione", 26/8/2026 §5; rifatta dal brief "fondo 1941", 26/8/2026
// §3). La prima versione sovrapponeva "Cimitero militare di Malè" e
// "Planimetria": la causa vera non era la larghezza delle celle, era un
// nome di classe. Le voci usavano `.voce`, la STESSA classe che
// cimiteri-di-guerra.css usa per le righe della ricerca (`.sezione-cimiteri
// .voce{display:grid;grid-template-columns:4.5rem 1fr auto}`). Le due
// regole hanno la stessa specificità (due classi ciascuna); la mia non
// dichiarava `display`, quindi quella del foglio globale vinceva di
// default e trasformava ogni bottone in una griglia a tre colonne — da qui
// il testo che finiva sopra il bottone accanto. Qui le voci si chiamano
// `.scheda-nav`, un nome che non esiste da nessun'altra parte nel sito.
//
// Zona identità (il nome del fondo, etichetta non cliccabile) + zona
// schede (sei bottoni, sempre in quest'ordine): Planimetria, Tutti i nomi,
// Reparti, Provenienze, Tombe senza nome, l'evento. "Planimetria" punta
// alla pagina del fondo, dove ora vive il blocco vero — non più a /mappa,
// che resta raggiungibile (i link dalle schede persona e da senza-nome la
// usano ancora) ma non è più nella barra.
import { leggiFondi, leggiEventi, type Fondo } from '../../lib/memoria';

interface Props { fondo?: Fondo }
const { fondo: fondoProp } = Astro.props as Props;

const fondi = await leggiFondi();
const fondo = fondoProp ?? fondi[0];
const eventi = await leggiEventi();
const evento = eventi[0];

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

type Voce = { label: string; href: string; attiva: (p: string) => boolean };

const voci: Voce[] = fondo ? [
  {
    label: 'Planimetria',
    href: `/cimiteri-di-guerra/${fondo.slug_breve}`,
    attiva: (p) => p === `/cimiteri-di-guerra/${fondo.slug_breve}` || p.endsWith('/mappa'),
  },
  {
    // Non esiste una pagina propria "Tutti i nomi": l'elenco e la ricerca
    // vivono sulla pagina del fondo, sezione #cerca-un-nome.
    label: 'Tutti i nomi',
    href: `/cimiteri-di-guerra/${fondo.slug_breve}#cerca-un-nome`,
    attiva: () => false,
  },
  {
    label: 'Reparti',
    href: '/cimiteri-di-guerra/reparto',
    attiva: (p) => p.startsWith('/cimiteri-di-guerra/reparto'),
  },
  {
    label: 'Provenienze',
    href: '/cimiteri-di-guerra/provenienza',
    attiva: (p) => p.startsWith('/cimiteri-di-guerra/provenienza'),
  },
  {
    label: 'Tombe senza nome',
    href: `/cimiteri-di-guerra/${fondo.slug_breve}/senza-nome`,
    attiva: (p) => p.endsWith('/senza-nome'),
  },
  ...(evento ? [{
    label: evento.nome,
    href: `/cimiteri-di-guerra/${evento.slug}`,
    attiva: (p: string) => p === `/cimiteri-di-guerra/${evento.slug}`,
  }] : []),
] : [];
---

{fondo && (
  <nav class="barra-sezione" aria-label="Sezione Cimiteri di guerra">
    <div class="corsia">
      <span class="identita">{fondo.titolo}</span>
      <span class="filetto" aria-hidden="true"></span>
      <div class="schede" id="schede-sezione">
        {voci.map((v) => v.attiva(path) ? (
          <a class="scheda-nav attiva" href={v.href} aria-current="page">{v.label}</a>
        ) : (
          <a class="scheda-nav" href={v.href}>{v.label}</a>
        ))}
      </div>
    </div>
  </nav>
)}

<style>
  .barra-sezione {
    background: var(--verde-fondo);
    border-bottom: 1px solid rgba(201, 150, 47, .35);
  }
  .corsia {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    max-width: 1060px;
    margin: 0 auto;
    padding: .6rem 1.25rem;
    gap: .75rem;
  }
  .identita {
    flex: 0 0 auto;
    font-family: var(--serif);
    font-style: italic;
    font-size: .92rem;
    color: var(--crema);
    white-space: nowrap;
  }
  .filetto {
    flex: 0 0 auto;
    width: 1px;
    align-self: stretch;
    min-height: 1.4rem;
    background: rgba(245, 239, 224, .22);
  }
  .schede {
    display: flex;
    flex: 1 1 auto;
    flex-wrap: wrap;
    gap: .5rem;
    min-width: 0;
  }
  .scheda-nav {
    flex: 0 0 auto;
    display: inline-block;
    white-space: nowrap;
    font-family: 'Inter', var(--sans);
    font-size: .78rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    line-height: 1.2;
    color: rgba(245, 239, 224, .85);
    text-decoration: none;
    border: 1px solid rgba(245, 239, 224, .18);
    border-radius: 999px;
    padding: .6rem 1.05rem;
    min-height: 40px;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    transition: background-color 120ms, border-color 120ms;
  }
  .scheda-nav:hover {
    background: rgba(245, 239, 224, .08);
    border-color: rgba(245, 239, 224, .35);
  }
  .scheda-nav:focus-visible {
    outline: 2px solid var(--oro);
    outline-offset: 2px;
  }
  .scheda-nav.attiva {
    background: var(--oro);
    border-color: var(--oro);
    color: #14200f;
  }

  /* Sotto 1024px lo spazio non basta per andare a capo con eleganza: la
     riga delle schede scorre in orizzontale invece di impilarsi. */
  @media (max-width: 1023px) {
    .corsia { flex-wrap: nowrap; }
    .schede {
      flex-wrap: nowrap;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      scroll-snap-type: x proximity;
      -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 28px), transparent 100%);
      mask-image: linear-gradient(to right, #000 calc(100% - 28px), transparent 100%);
    }
    .schede::-webkit-scrollbar { display: none; }
    .scheda-nav { scroll-snap-align: start; }
  }

  @media (max-width: 639px) {
    .corsia { flex-wrap: wrap; }
    .identita { flex-basis: 100%; }
    .filetto { display: none; }
    .schede { flex-basis: 100%; }
  }
</style>

<script>
  // La scheda attiva entra in vista da sola quando la riga scorre: chi apre
  // la pagina su un telefono non deve cercarla scorrendo a mano.
  const schede = document.getElementById('schede-sezione');
  const attiva = schede?.querySelector('.attiva');
  if (attiva) {
    const ridotto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    attiva.scrollIntoView({ inline: 'center', block: 'nearest', behavior: ridotto ? 'auto' : 'smooth' });
  }
</script>
