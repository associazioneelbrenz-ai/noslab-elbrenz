---
/**
 * IndicatoreScorri — l'invito a scorrere in fondo alla prima schermata.
 *
 * Perche' esiste: Michele Corradini ha guardato delle persone usare il sito e
 * ha visto cosa fanno. Arrivano in home, vedono una schermata che sembra
 * conclusa, e cliccano sui menu senza sapere che sotto ci sono la mappa, gli
 * eventi, gli articoli, il glossario. Non e' un'opinione di gusto: e'
 * osservazione di persone vere, e vale piu' di qualunque analisi.
 *
 * E' un RINFORZO, non la correzione: la correzione vera e' che si intraveda la
 * sezione successiva, ed e' stata fatta riducendo l'altezza della hero su
 * telefono. Il cervello capisce da solo che c'e' altro quando vede una striscia
 * di colore chiaro sotto il verde; questo lo dice a parole per chi non la coglie.
 *
 * Le accortezze, tutte deliberate:
 *   - non intercetta i tocchi (pointer-events-none): chi lo ignora usa la
 *     pagina come se non ci fosse;
 *   - sparisce al primo scorrimento e non torna, perche' ha finito il suo lavoro;
 *   - rispetta prefers-reduced-motion: chi ha spento le animazioni lo vede
 *     fermo, non lo vede sparire;
 *   - aria-hidden: per chi naviga con la tastiera o con un lettore di schermo
 *     la pagina e' gia' scorribile, e annunciarlo sarebbe rumore.
 */
interface Props {
  /** «Scorri» in italiano, «Scrollen» in tedesco, «Scroll» in inglese. */
  testo?: string;
}
const { testo = 'Scorri' } = Astro.props;
---

<div
  id="eb-scorri"
  aria-hidden="true"
  class="pointer-events-none fixed bottom-5 left-0 right-0 z-20 flex flex-col items-center gap-1 transition-opacity duration-500"
>
  <span
    class="text-[12px] font-semibold tracking-[0.24em] uppercase text-[#F5EEDD] px-4 py-2 rounded-full"
    style="font-family: 'Inter', sans-serif; background: #1E2E26; box-shadow: 0 6px 18px rgba(0,0,0,.35); border: 1px solid rgba(200,146,62,.55);"
  >{testo}</span>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C8923E"
       stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="eb-scorri-freccia">
    <path d="M12 5v14M19 12l-7 7-7-7" />
  </svg>
</div>

<style>
  /* Un alzarsi e riabbassarsi lento: e' cio' che distingue un invito da una
     decorazione. Ampiezza piccola, apposta: deve suggerire, non agitarsi. */
  @keyframes eb-scorri-su-giu {
    0%, 100% { transform: translateY(0); opacity: .85; }
    50%      { transform: translateY(5px); opacity: 1; }
  }
  .eb-scorri-freccia { animation: eb-scorri-su-giu 2.4s ease-in-out infinite; }

  /* Chi ha spento le animazioni nelle impostazioni del proprio dispositivo lo
     vede fermo. Resta visibile: il messaggio serve a lui quanto agli altri. */
  @media (prefers-reduced-motion: reduce) {
    .eb-scorri-freccia { animation: none; }
  }

  #eb-scorri.eb-scorri-via { opacity: 0; }
</style>

<script>
  (() => {
    const el = document.getElementById('eb-scorri');
    if (!el) return;
    const mostra = () => el.classList.remove('eb-scorri-via');
    const nascondi = () => el.classList.add('eb-scorri-via');

    // [9/8] NON si guarda `window.scrollY`: su questo sito resta a zero, perche'
    // l'overflow su html sposta lo scorrimento. Due sentinelle invisibili dicono
    // la stessa cosa senza chiedersi CHI stia scorrendo, e funzionano uguale
    // nella finestra, dentro un contenitore e in qualunque impaginazione futura.
    const crea = (stile) => {
      const d = document.createElement('div');
      d.setAttribute('aria-hidden', 'true');
      d.style.cssText = 'position:absolute;left:0;width:1px;pointer-events:none;opacity:0;' + stile;
      return d;
    };

    // Sentinella ALTA: alta poco piu' di una schermata. L'invito resta finche'
    // non si e' scorso davvero. Prima era mezzo schermo, e un colpo di pollice
    // lo faceva sparire prima che l'occhio lo registrasse.
    const cima = crea('top:0;height:115vh');
    // Sentinella IN FONDO: serve a sapere se la persona ha visto la fine.
    const fondo = crea('bottom:0;height:60vh');
    document.body.prepend(cima);
    document.body.append(fondo);

    // Chi e' arrivato in fondo ha capito benissimo che la pagina scorre:
    // rimettergli l'invito quando risale sarebbe dirgli una cosa che ha appena
    // dimostrato di sapere. Chi invece scorre un poco e torna su, quello si'.
    let vistaLaFine = false;
    new IntersectionObserver(([v]) => { if (v.isIntersecting) vistaLaFine = true; }, { threshold: 0 })
      .observe(fondo);

    new IntersectionObserver(([v]) => {
      if (!v.isIntersecting) nascondi();
      else if (!vistaLaFine) mostra();
    }, { threshold: 0 }).observe(cima);

    // Il tasto Fine e la barra spaziatrice sono intenzioni esplicite, non
    // sfioramenti: li' l'invito ha finito il suo lavoro.
    window.addEventListener('keydown', (e) => {
      if (['End', 'PageDown', ' '].includes(e.key)) nascondi();
    }, { passive: true });
  })();
</script>
