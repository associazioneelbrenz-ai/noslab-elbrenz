docs/pagine_wp_contenuti/

# Test results (rigenerabili)
ma1_results/
supabase/.temp/
.backups/
*.bak

# I backup pre-modifica (regola ferma: .bak prima di ogni intervento) restano
# sul disco come rete di sicurezza ma non sporcano piu' git status: erano
# arrivati a 23 file non tracciati. Niente rimozioni: solo invisibilita'.
*.bak
*.bak-*
*.bak2
*.bak3

# I backup NON stanno in public/: quella cartella viene pubblicata cosi' com'e',
# e per mesi ha servito _headers.bak e _redirects.bak a chiunque indovinasse
# l'indirizzo. Qui invece restano in locale.
backup-pubblici/
